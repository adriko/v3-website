---
import Layout from "../layouts/Layout.astro";
import SeasonalBanner from "../components/SeasonalBanner.astro";
import Navbar from "../components/Navbar.astro";
import ClubGallery from "../components/ClubGallery.astro";
import AppCta from "../components/AppCta.astro";
import Contact from "../components/Contact.astro";

const pillars = [
  {
    tag: "Park Maszyn & Wolne Ciężary",
    title: "Profesjonalna Siłownia Bodytone",
    desc: "Dwa piętra przestrzeni treningowej wyposażone w nowoczesne maszyny izolowane marki Bodytone, suwnice, stojaki rack oraz rozbudowaną strefę wolnych ciężarów do treningu siłowego i funkcjonalnego.",
    accent: "text-v3-lime border-v3-lime/30 bg-v3-lime/10",
  },
  {
    tag: "Fitness & Strefa Kobiet",
    title: "Zajęcia Grupowe & Pink Zone",
    desc: "Szeroki wybór zajęć grupowych — od Pilatesu, Jogi i Zdrowego Kręgosłupa po dynamiczny V3 Step Up!, Booty Project i czwartkowy CROSS. Dodatkowo kameralna, zamknięta Strefa Kobiet zapewniająca 100% swobody.",
    accent: "text-pink-400 border-pink-500/30 bg-pink-500/10",
  },
  {
    tag: "KSW Sokół & V3",
    title: "Rozbudowana Strefa Fight Zone",
    desc: "Sekcja sportów walki prowadzona we współpracy z KSW Sokół Jarosław. Pełnowymiarowy ring bokserski, profesjonalna mata zapaśnicza oraz treningi Boksu, Kickboxingu, MMA, Ju-Jitsu i Krav Magi dla dzieci, młodzieży i dorosłych.",
    accent: "text-v3-red border-v3-red/30 bg-v3-red/10",
  },
  {
    tag: "Komfort & Technologia",
    title: "Samoobsługa 5:00 – 24:00",
    desc: "Trenuj wtedy, kiedy Ci wygodnie — także poza godzinami pracy recepcji dzięki wejściu na kod QR w aplikacji. Do dyspozycji oddajemy przestronne szatnie z prysznicami, FitBar z odżywkami oraz własny parking pod klubem.",
    accent: "text-v3-lime border-v3-lime/30 bg-v3-lime/10",
  },
];
---

<Layout
  title="O V3 Klub Jarosław • Nowoczesne Centrum Sportowe, Siłownia i Fight Zone"
  description="Poznaj Centrum Sportowe V3 w Jarosławiu przy ul. Poniatowskiego 24. Siłownia Bodytone, zajęcia fitness, Strefa Kobiet, Fight Zone z KSW Sokół oraz samoobsługa 5:00 – 24:00."
>
  <SeasonalBanner />
  <Navbar />

  <main>
    <section class="relative overflow-hidden border-b border-white/10 bg-v3-dark bg-v3-grid py-12 sm:py-16 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative">
        <nav
          aria-label="Ścieżka nawigacji"
          class="flex items-center gap-2 text-xs font-semibold text-zinc-400 mb-4"
        >
          <a href="/" class="hover:text-v3-lime transition-colors">
            Strona główna
          </a>
          <span>/</span>
          <span class="text-zinc-200">O V3</span>
        </nav>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 rounded-full border border-v3-lime/30 bg-v3-lime/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-v3-lime">
              <span>Jarosław • ul. Poniatowskiego 24</span>
            </div>

            <h1 class="mt-3 font-display text-5xl sm:text-6xl lg:text-7xl font-black uppercase leading-none tracking-tight text-white">
              V3 – Twoje centrum{" "}
              <span class="text-v3-lime">sportu i aktywności</span>
            </h1>

            <p class="mt-4 text-sm sm:text-base leading-relaxed text-zinc-200">
              V3 to nowoczesne centrum sportowe w Jarosławiu, które łączy
              profesjonalnie wyposażoną siłownię, różnorodne zajęcia fitness
              oraz rozbudowaną strefę sportów walki prowadzoną we współpracy z{" "}
              <strong class="text-white font-semibold">
                KSW Sokół Jarosław
              </strong>
              .
            </p>

            <p class="mt-3 text-sm sm:text-base leading-relaxed text-zinc-300">
              Tworzymy przestrzeń dla osób, które chcą poprawić swoją kondycję,
              zadbać o zdrowie, rozwinąć siłę, wymodelować sylwetkę lub
              rozpocząć swoją przygodę ze sportem. Niezależnie od wieku, celu i
              poziomu zaawansowania — każdy znajdzie u nas odpowiednią formę
              aktywności.
            </p>

            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a
                href="/#cennik"
                class="group inline-flex items-center gap-3 rounded-2xl bg-v3-lime pl-6 pr-3.5 py-3 text-xs sm:text-sm font-extrabold uppercase tracking-wider text-black transition hover:bg-white"
              >
                <span>Sprawdź karnety</span>
                <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-black/15 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                  <svg
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M7 17L17 7M7 7h10v10"
                    />
                  </svg>
                </span>
              </a>
              <a
                href="/trenerzy"
                class="inline-flex items-center justify-center rounded-2xl border border-white/15 bg-v3-surface px-5 py-3.5 text-xs sm:text-sm font-bold uppercase tracking-wider text-zinc-100 transition hover:border-v3-lime/50 hover:text-v3-lime"
              >
                Poznaj kadrę trenerską
              </a>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="rounded-3xl border border-white/10 bg-v3-surface p-6 sm:p-7">
              <span class="text-xs font-bold uppercase tracking-wider text-v3-lime">
                Więcej niż siłownia
              </span>
              <h2 class="mt-1.5 font-display text-3xl font-extrabold uppercase leading-tight text-white">
                Trenuj na własnych zasadach
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-zinc-300">
                V3 to miejsce, w którym spotykają się pasja do sportu,
                profesjonalna opieka trenerska i atmosfera sprzyjająca
                rozwojowi. Stawiamy na różnorodność, jakość i indywidualne
                podejście, aby każdy mógł bezpiecznie realizować swoje cele.
              </p>

              <div class="mt-5 grid grid-cols-2 gap-3 border-t border-white/10 pt-5">
                <div class="rounded-2xl border border-white/8 bg-v3-card p-3.5">
                  <span class="block font-display text-2xl font-extrabold text-v3-lime leading-none">
                    5:00 – 24:00
                  </span>
                  <span class="mt-1 block text-xs text-zinc-300">
                    Codzienny dostęp QR
                  </span>
                </div>
                <div class="rounded-2xl border border-white/8 bg-v3-card p-3.5">
                  <span class="block font-display text-2xl font-extrabold text-white leading-none">
                    2 PIĘTRA
                  </span>
                  <span class="mt-1 block text-xs text-zinc-300">
                    Strefy treningowe
                  </span>
                </div>
              </div>

              <div class="mt-4 flex flex-wrap items-center gap-2 pt-2">
                <span class="rounded-lg border border-v3-lime/30 bg-v3-lime/10 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-v3-lime">
                  ✓ MultiSport
                </span>
                <span class="rounded-lg border border-v3-lime/30 bg-v3-lime/10 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-v3-lime">
                  ✓ Medicover Sport
                </span>
                <span class="rounded-lg border border-v3-lime/30 bg-v3-lime/10 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-v3-lime">
                  ✓ FitProfit
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-white/10 bg-v3-surface/40 py-14 sm:py-16 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-8 sm:mb-12">
          <span class="text-xs font-bold uppercase tracking-widest text-v3-lime">
            Standard Obiektu
          </span>
          <h2 class="mt-2 font-display text-4xl sm:text-5xl font-extrabold uppercase leading-none text-white">
            Co wyróżnia <span class="text-v3-lime">V3 Klub</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          {pillars.map((item) => (
            <div class="rounded-3xl border border-white/10 bg-v3-surface p-6 sm:p-7 flex flex-col justify-between">
              <div>
                <span
                  class={`inline-block rounded-lg border px-2.5 py-1 text-xs font-bold uppercase tracking-wider ${item.accent}`}
                >
                  {item.tag}
                </span>
                <h3 class="mt-3 font-display text-3xl font-extrabold uppercase leading-tight text-white">
                  {item.title}
                </h3>
                <p class="mt-2.5 text-sm leading-relaxed text-zinc-300">
                  {item.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <ClubGallery />
    <AppCta />
    <Contact />
  </main>
</Layout>
