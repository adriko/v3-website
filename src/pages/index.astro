---
import Layout from "../layouts/Layout.astro";
import SeasonalBanner from "../components/SeasonalBanner.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import ZonesOverview from "../components/ZonesOverview.astro";
import Pricing from "../components/Pricing.astro";
import AppCta from "../components/AppCta.astro";
import Contact from "../components/Contact.astro";
---

<Layout title="V3 Klub Jarosław • Siłownia, Fitness, Fight Zone i Samoobsługa 5:00 – 24:00">
  <!-- Dynamiczny baner akcji okolicznościowych sterowany kalendarzem -->
  <SeasonalBanner />

  <!-- Główny pasek nawigacyjny -->
  <Navbar />

  <main>
    <!-- 1. Ekran Powitalny / Hero -->
    <Hero />

    <!-- 2. Przegląd 3 Stref Klubu (kierujący na dedykowane podstrony) -->
    <ZonesOverview />

    <!-- 3. Cennik Członkostwa & Pakiety partnerskie -->
    <Pricing />

    <!-- 4. Aplikacja GymManager & Kod QR (Samoobsługa 5:00 - 24:00) -->
    <AppCta />

    <!-- 5. Kontakt & Dojazd Google Maps -->
    <Contact />
  </main>
</Layout>
