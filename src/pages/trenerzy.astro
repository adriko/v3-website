---
import Layout from "../layouts/Layout.astro";
import SeasonalBanner from "../components/SeasonalBanner.astro";
import Navbar from "../components/Navbar.astro";
import Contact from "../components/Contact.astro";
import { TRAINERS, type Trainer } from "../data/trainers";

const getLastName = (fullName: string) => {
  const parts = fullName.trim().split(/\s+/);
  return parts[parts.length - 1] || "";
};

const sortedTrainers: Trainer[] = [...TRAINERS].sort((a, b) =>
  getLastName(a.name).localeCompare(getLastName(b.name), "pl"),
);

const fightCount = sortedTrainers.filter((t) => t.zone === "fight").length;
const gymCount = sortedTrainers.filter((t) => t.zone === "gym").length;
---

<Layout
  title="Kadra Trenerska V3 Klub Jarosław • Trenerzy Personalni, Fitness i Fight Zone"
  description="Poznaj kadrę trenerską V3 Klub Jarosław. Wykwalifikowani trenerzy personalni, instruktorzy fitness oraz mistrzowie i szkoleniowcy KSW Sokół Jarosław."
>
  <SeasonalBanner />
  <Navbar />

  <main>
    <section class="relative overflow-hidden border-b border-white/10 bg-v3-dark bg-v3-grid py-12 sm:py-16 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative">
        <nav
          aria-label="Ścieżka nawigacji"
          class="flex items-center gap-2 text-xs font-semibold text-zinc-400 mb-4"
        >
          <a href="/" class="hover:text-v3-lime transition-colors">
            Strona główna
          </a>
          <span>/</span>
          <span class="text-zinc-200">Trenerzy</span>
        </nav>

        <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 rounded-full border border-v3-lime/30 bg-v3-lime/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-v3-lime">
              <span>Minimum 5 lat praktyki zawodowej</span>
            </div>

            <h1 class="mt-3 font-display text-5xl sm:text-6xl lg:text-7xl font-black uppercase leading-none tracking-tight text-white">
              Nasi <span class="text-v3-lime">Trenerzy</span>
            </h1>

            <p class="mt-4 text-sm sm:text-base leading-relaxed text-zinc-300">
              W V3 Klub stawiamy na profesjonalizm, wiedzę i wieloletnie
              doświadczenie. Nasz zespół tworzą wykwalifikowani trenerzy i
              instruktorzy, którzy zapewniają wsparcie zarówno osobom
              początkującym, jak i zawodnikom.
            </p>
          </div>

          <!-- Pasek filtrowania: wszystkie 3 przyciski w jednej linii bez łamania -->
          <div class="inline-flex items-center gap-1 rounded-2xl border border-white/10 bg-v3-surface p-1.5 self-start lg:self-auto shrink-0 overflow-x-auto max-w-full no-scrollbar">
            <button
              type="button"
              data-zone-filter="all"
              class="trainer-filter-btn cursor-pointer rounded-xl bg-v3-lime px-3.5 sm:px-4 py-2 text-xs font-extrabold uppercase tracking-wider text-black whitespace-nowrap transition"
            >
              Wszyscy ({sortedTrainers.length})
            </button>
            <button
              type="button"
              data-zone-filter="fight"
              class="trainer-filter-btn cursor-pointer rounded-xl px-3.5 sm:px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-300 hover:text-white whitespace-nowrap transition"
            >
              Fight Zone ({fightCount})
            </button>
            <button
              type="button"
              data-zone-filter="gym"
              class="trainer-filter-btn cursor-pointer rounded-xl px-3.5 sm:px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-300 hover:text-white whitespace-nowrap transition"
            >
              Siłownia &amp; Fitness ({gymCount})
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-white/10 bg-v3-dark py-14 sm:py-16 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {sortedTrainers.map((t: Trainer) => {
            const isFight = t.zone === "fight";
            const initials = t.name
              .split(" ")
              .map((n: string) => n[0])
              .join("");

            return (
              <article
                data-trainer-card
                data-trainer-zone={t.zone}
                class={`rounded-3xl border border-white/10 bg-v3-surface p-6 flex flex-col justify-between transition-all duration-300 group ${
                  isFight ? "hover:border-v3-red/50" : "hover:border-v3-lime/50"
                }`}
              >
                <div>
                  <div class="relative w-full h-52 sm:h-56 rounded-2xl overflow-hidden border border-white/5 bg-v3-card mb-5 flex items-center justify-center">
                    {t.image ? (
                      <img
                        src={t.image}
                        alt={t.name}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover object-top transition duration-500 group-hover:scale-105"
                      />
                    ) : (
                      <div class="w-full h-full flex flex-col items-center justify-center bg-v3-card text-center p-4 relative">
                        <div
                          class={`w-16 h-16 rounded-full border-2 flex items-center justify-center font-display text-2xl font-extrabold tracking-wider mb-2 z-10 ${
                            isFight
                              ? "border-v3-red/40 bg-v3-red/10 text-v3-red"
                              : "border-v3-lime/40 bg-v3-lime/10 text-v3-lime"
                          }`}
                        >
                          {initials}
                        </div>
                        <span class="text-xs font-bold uppercase tracking-wider text-zinc-400 z-10">
                          {isFight ? "KSW Sokół & V3" : "V3 Siłownia & Fitness"}
                        </span>
                      </div>
                    )}

                    <div class="absolute inset-0 bg-linear-to-t from-v3-dark via-transparent to-transparent pointer-events-none" />

                    {t.leadsClasses && (
                      <div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-lg bg-v3-dark/95 backdrop-blur-md text-white border border-white/10 leading-tight">
                        <svg
                          class={`h-3.5 w-3.5 shrink-0 ${
                            isFight ? "text-v3-red" : "text-v3-lime"
                          }`}
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2.2"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M13 10V3L4 14h7v7l9-11h-7z"
                          />
                        </svg>
                        <span>{t.leadsClasses}</span>
                      </div>
                    )}
                  </div>

                  <div>
                    <h2 class="font-display text-3xl font-extrabold uppercase tracking-tight text-white leading-none">
                      {t.name}
                    </h2>
                    <p
                      class={`text-xs sm:text-sm font-semibold mt-1.5 leading-snug ${
                        isFight ? "text-v3-red" : "text-v3-lime"
                      }`}
                    >
                      {t.role}
                    </p>
                  </div>

                  <div class="flex flex-wrap gap-1.5 mt-3.5">
                    {t.tags.map((tag: string) => (
                      <span class="text-xs font-semibold px-2.5 py-0.5 rounded-md bg-v3-card text-zinc-300 border border-white/5">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <p class="mt-4 text-sm leading-relaxed text-zinc-300">
                    {t.description}
                  </p>
                </div>

                <div class="mt-6 pt-4 border-t border-white/10 flex flex-col gap-2.5">
                  {t.specialLink && (
                    <a
                      href={t.specialLink.href}
                      class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 rounded-xl border border-pink-500/30 bg-pink-500/10 hover:bg-pink-500/20 text-pink-400 font-bold uppercase tracking-wider text-xs transition"
                    >
                      {t.specialLink.label}
                    </a>
                  )}
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-zinc-400 font-medium">
                      {t.experience}
                    </span>
                    <a
                      href="tel:+48788463717"
                      class={`font-bold uppercase tracking-wider hover:underline flex items-center gap-1 shrink-0 ${
                        isFight ? "text-v3-red" : "text-v3-lime"
                      }`}
                    >
                      Umów w klubie →
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <Contact />
  </main>
</Layout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(
    ".trainer-filter-btn",
  );
  const trainerCards = document.querySelectorAll<HTMLElement>(
    "[data-trainer-card]",
  );

  function applyTrainerFilter(zone: "all" | "fight" | "gym") {
    filterBtns.forEach((btn) => {
      const btnZone = btn.dataset.zoneFilter;
      const active = btnZone === zone;

      if (!active) {
        btn.className =
          "trainer-filter-btn cursor-pointer rounded-xl px-3.5 sm:px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-300 hover:text-white whitespace-nowrap transition";
      } else if (zone === "fight") {
        btn.className =
          "trainer-filter-btn cursor-pointer rounded-xl bg-v3-red px-3.5 sm:px-4 py-2 text-xs font-extrabold uppercase tracking-wider text-white whitespace-nowrap transition";
      } else {
        btn.className =
          "trainer-filter-btn cursor-pointer rounded-xl bg-v3-lime px-3.5 sm:px-4 py-2 text-xs font-extrabold uppercase tracking-wider text-black whitespace-nowrap transition";
      }
    });

    trainerCards.forEach((card) => {
      const match = zone === "all" || card.dataset.trainerZone === zone;
      card.classList.toggle("hidden", !match);
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const z = (btn.dataset.zoneFilter as "all" | "fight" | "gym") || "all";
      applyTrainerFilter(z);
    });
  });

  const params = new URLSearchParams(window.location.search);
  const urlZone = params.get("strefa");
  if (urlZone === "fight" || urlZone === "gym") {
    applyTrainerFilter(urlZone);
  }
</script>
