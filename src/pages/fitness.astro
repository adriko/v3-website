---
import Layout from "../layouts/Layout.astro";
import SeasonalBanner from "../components/SeasonalBanner.astro";
import Navbar from "../components/Navbar.astro";
import ScheduleBoard from "../components/ScheduleBoard.astro";
import Contact from "../components/Contact.astro";
import { FITNESS_CLASSES } from "../data/classes";

const gymFeatures = [
  {
    num: "01",
    tag: "Park Maszyn Izolowanych",
    title: "Nowoczesny sprzęt Bodytone",
    desc: "Ergonomiczne maszyny stosowe i półwolne zaprojektowane pod precyzyjną izolację każdej partii mięśniowej — bezpieczne zarówno dla początkujących, jak i zaawansowanych.",
  },
  {
    num: "02",
    tag: "Siła & Wolne Ciężary",
    title: "Hantle, Sztangi & Racki",
    desc: "Rozbudowana strefa wolnych ciężarów, stanowiska do przysiadów i martwego ciągu, ławki regulowane oraz pełen zestaw hantli do ciężkiego treningu siłowego.",
  },
  {
    num: "03",
    tag: "Dostęp 5:00 – 24:00",
    title: "Trening bez kolejek i pośpiechu",
    desc: "Dwa piętra przestrzeni treningowej oraz całodzienna samoobsługa przez aplikację GymManager pozwalają trenować dokładnie wtedy, kiedy masz czas.",
  },
];
---

<Layout
  title="Siłownia Bodytone, Zajęcia Fitness & Strefa Kobiet | V3 Klub Jarosław"
  description="Nowoczesna siłownia Bodytone, wolne ciężary, 9 rodzajów zajęć grupowych (Pilates, Joga, Booty Project, Full Body Project, V3 Step Up!, Zumba, Zdrowy Kręgosłup) oraz dedykowana Strefa Kobiet w Jarosławiu."
>
  <SeasonalBanner />
  <Navbar />

  <main>
    <!-- Nagłówek podstrony Siłownia & Fitness -->
    <section class="relative overflow-hidden border-b border-white/10 bg-v3-dark py-12 sm:py-16 lg:py-20">
      <!-- Subtelne zdjęcie strefy wolnych ciężarów w tle (wyłącznie Desktop) -->
      <div class="hidden lg:block absolute inset-y-0 right-0 w-3/5 pointer-events-none select-none">
        <img
          src="/images/silownia3.jpg"
          alt="Strefa wolnych ciężarów i hantli w V3 Klub Jarosław"
          width="1200"
          height="900"
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover object-center opacity-35"
        />
        <div class="absolute inset-0 bg-linear-to-r from-v3-dark via-v3-dark/75 to-transparent"></div>
        <div class="absolute inset-0 bg-linear-to-t from-v3-dark via-transparent to-v3-dark/60"></div>
      </div>

      <!-- Architektoniczna siatka -->
      <div class="absolute inset-0 bg-v3-grid pointer-events-none"></div>

      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative">
        <nav
          aria-label="Ścieżka nawigacji"
          class="flex items-center gap-2 text-xs font-semibold text-zinc-400 mb-4"
        >
          <a href="/" class="hover:text-v3-lime transition-colors">
            Strona główna
          </a>
          <span>/</span>
          <span class="text-zinc-200">Siłownia &amp; Fitness</span>
        </nav>

        <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
          <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 rounded-full border border-v3-lime/30 bg-v3-lime/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-v3-lime backdrop-blur-md">
              <span>Dwa Piętra Treningu • Bodytone</span>
            </div>

            <h1 class="mt-3 font-display text-5xl sm:text-6xl lg:text-7xl font-black uppercase leading-none tracking-tight text-white">
              Siłownia &amp; <span class="text-v3-lime">Zajęcia Grupowe</span>
            </h1>

            <p class="mt-4 text-sm sm:text-base leading-relaxed text-zinc-300">
              Profesjonalnie wyposażona strefa siłowa, zróżnicowane zajęcia
              fitness i mentalne prowadzone przez doświadczonych instruktorów
              oraz odrębna, kameralna Strefa Kobiet.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <a
              href="#grafik-strefy"
              class="inline-flex items-center justify-center rounded-2xl bg-v3-lime px-5 py-3.5 text-xs sm:text-sm font-extrabold uppercase tracking-wider text-black transition hover:bg-white"
            >
              Grafik Fitness ↓
            </a>
            <a
              href="#strefa-kobiet"
              class="inline-flex items-center justify-center rounded-2xl border border-pink-500/40 bg-pink-500/15 px-5 py-3.5 text-xs sm:text-sm font-bold uppercase tracking-wider text-pink-400 backdrop-blur-md transition hover:bg-pink-500 hover:text-white"
            >
              Strefa Kobiet ↓
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Strefa Siłowni Bodytone -->
    <section class="border-b border-white/10 bg-v3-surface/40 py-14 sm:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
          {gymFeatures.map((feat) => (
            <div class="relative rounded-3xl border border-white/10 bg-v3-surface p-6 sm:p-7">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-bold uppercase tracking-wider text-v3-lime">
                  {feat.tag}
                </span>
                <span class="font-display text-2xl font-black text-white/15 select-none">
                  {feat.num}
                </span>
              </div>
              <h2 class="font-display text-2xl sm:text-3xl font-extrabold uppercase leading-tight tracking-tight text-white">
                {feat.title}
              </h2>
              <p class="mt-2.5 text-sm leading-relaxed text-zinc-300">
                {feat.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Czyste panele 9 Zajęć Fitness (bez szumu pod zdjęciem) -->
    <section class="border-b border-white/10 bg-v3-dark py-14 sm:py-16 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end mb-10 sm:mb-12">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-v3-lime">
              Oferta Zajęć Grupowych
            </span>
            <h2 class="mt-2 font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold uppercase leading-none tracking-tight text-white">
              Treningi <span class="text-v3-lime">Fitness &amp; Wellness</span>
            </h2>
            <p class="mt-2.5 text-sm sm:text-base text-zinc-300 max-w-2xl leading-relaxed">
              Od dynamicznego cardio i kształtowania sylwetki po jogę, pilates i
              zajęcia prozdrowotne na kręgosłup.
            </p>
          </div>

          <a
            href="/trenerzy?strefa=gym"
            class="group inline-flex items-center gap-2 self-start md:self-end rounded-2xl border border-v3-lime/40 bg-v3-lime/10 px-5 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider text-v3-lime transition hover:bg-v3-lime hover:text-black shrink-0"
          >
            <span>Poznaj trenerów Siłowni</span>
            <svg
              class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M7 17L17 7M7 7h10v10"
              />
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {FITNESS_CLASSES.map((item, index) => {
            const num = String(index + 1).padStart(2, "0");
            return (
              <article
                class={`group relative flex flex-col justify-between overflow-hidden rounded-3xl border bg-v3-surface transition-all duration-300 ${
                  item.featured
                    ? "border-v3-lime/60 hover:border-v3-lime"
                    : "border-white/10 hover:border-v3-lime/40"
                }`}
              >
                <div>
                  {item.image && (
                    <div class="relative h-52 w-full overflow-hidden bg-v3-card">
                      <img
                        src={item.image}
                        alt={item.title}
                        width="600"
                        height="400"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                      />
                      <div class="absolute inset-0 bg-linear-to-t from-v3-surface via-v3-surface/20 to-transparent" />
                      <span
                        class={`absolute top-3.5 left-3.5 rounded-lg border px-3 py-1 text-xs font-extrabold uppercase tracking-wider backdrop-blur-md bg-black/75 ${item.accentColor}`}
                      >
                        {item.subtitle}
                      </span>
                      <span class="absolute bottom-2 right-5 font-display text-4xl font-black text-white/15 select-none">
                        {num}
                      </span>
                    </div>
                  )}

                  <div class="p-6">
                    <h3 class="font-display text-3xl font-extrabold uppercase leading-tight tracking-tight text-white group-hover:text-v3-lime transition-colors">
                      {item.title}
                    </h3>

                    <p class="mt-3 text-sm leading-relaxed text-zinc-300">
                      {item.description}
                    </p>
                  </div>
                </div>

                <div class="px-6 pb-6 pt-2">
                  <button
                    type="button"
                    data-jump-category={item.filterCategory}
                    class="jump-to-fitness-schedule group/btn cursor-pointer flex w-full items-center justify-between rounded-2xl border border-white/10 bg-v3-card pl-4 pr-3 py-2.5 text-xs font-extrabold uppercase tracking-wider text-zinc-100 transition hover:border-v3-lime hover:bg-v3-lime hover:text-black"
                  >
                    <span>Sprawdź w grafiku</span>
                    <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-white/10 group-hover/btn:bg-black/15 transition-transform group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5">
                      <svg
                        class="h-3.5 w-3.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M7 17L17 7M7 7h10v10"
                        />
                      </svg>
                    </span>
                  </button>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Dedykowana Strefa Kobiet -->
    <section
      id="strefa-kobiet"
      class="scroll-mt-20 relative overflow-hidden border-b border-white/10 bg-v3-dark py-14 sm:py-16 lg:py-20"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16 relative">
        <div class="grid grid-cols-1 items-center gap-8 sm:gap-10 lg:grid-cols-12">
          <div class="lg:col-span-6">
            <div class="inline-flex items-center gap-2 rounded-full border border-pink-500/30 bg-pink-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-pink-400">
              <span>100% Prywatności i Komfortu</span>
            </div>
            <h2 class="mt-3 sm:mt-4 font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold uppercase leading-none tracking-tight text-white">
              Dedykowana <br />
              <span class="text-pink-400">Strefa Kobiet</span>
            </h2>
            <p class="mt-4 text-sm sm:text-base leading-relaxed text-zinc-300">
              W klubie V3 stworzyliśmy wyjątkową, odrębną przestrzeń
              zaprojektowaną specjalnie dla kobiet. Różowa sala wyposażona w
              suwnicę Smitha, profesjonalne stojaki rack, wolne ciężary, hantle,
              sztangi tiguar oraz podświetlane lustro selfie – wszystko w
              atmosferze pełnego skupienia i swobody.
            </p>
            <ul class="mt-6 space-y-3 text-sm sm:text-base text-zinc-200">
              <li class="flex items-center gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-pink-500/20 text-xs font-bold text-pink-400">
                  ✓
                </span>
                <span>Własna, zamknięta sala wyłącznie dla pań</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-pink-500/20 text-xs font-bold text-pink-400">
                  ✓
                </span>
                <span>
                  Pełne wyposażenie do modelowania pośladków, nóg i sylwetki
                </span>
              </li>
              <li class="flex items-center gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-pink-500/20 text-xs font-bold text-pink-400">
                  ✓
                </span>
                <span>
                  Idealny klimat: neonowe oświetlenie, styl i komfort treningu
                </span>
              </li>
            </ul>
          </div>

          <div class="lg:col-span-6">
            <div class="relative overflow-hidden rounded-3xl border border-pink-500/30 bg-v3-surface shadow-2xl">
              <img
                src="/images/women-zone.jpg"
                alt="Strefa Kobiet w V3 Klub Jarosław"
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
                class="h-64 w-full object-cover sm:h-96"
              />
              <div class="absolute inset-0 bg-linear-to-t from-v3-dark via-transparent to-transparent"></div>
              <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 rounded-xl border border-pink-500/20 bg-v3-dark/90 p-3.5 sm:p-4 backdrop-blur-md">
                <span class="text-xs font-bold uppercase tracking-wider text-pink-400">
                  Pink Zone • Tylko dla Kobiet
                </span>
                <p class="mt-0.5 font-display text-xl sm:text-2xl font-bold uppercase leading-none text-white">
                  Twoje miejsce na bezpieczny i pewny trening
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Opieka Trenerska z Zuzą -->
        <div class="rounded-3xl border border-pink-500/25 bg-v3-surface p-5 sm:p-8">
          <div class="grid grid-cols-1 items-center gap-6 sm:gap-8 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <div class="relative overflow-hidden rounded-2xl border border-pink-500/30 bg-v3-card">
                <img
                  src="/images/zuza.jpg"
                  alt="Trenerka Zuza - V3 Klub Jarosław"
                  width="600"
                  height="750"
                  loading="lazy"
                  decoding="async"
                  class="h-72 w-full object-cover object-top sm:h-96"
                />
                <div class="absolute inset-0 bg-linear-to-t from-v3-dark via-transparent to-transparent"></div>
                <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4">
                  <span class="block font-display text-2xl sm:text-3xl font-extrabold uppercase leading-none text-white">
                    Zuza
                  </span>
                  <span class="text-xs font-semibold uppercase tracking-wider text-pink-400">
                    Trenerka &amp; Opieka Wellness
                  </span>
                </div>
              </div>
            </div>

            <div class="lg:col-span-8">
              <div class="text-xs font-bold uppercase tracking-wider text-pink-400">
                Opieka Trenerska &amp; Odnowa
              </div>
              <h3 class="mt-1.5 font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold uppercase leading-none tracking-tight text-white">
                Zadbaj o sylwetkę i zdrowie z Zuzą
              </h3>
              <p class="mt-3 text-sm sm:text-base leading-relaxed text-zinc-300">
                Skorzystaj z kompleksowych pakietów metamorfozy dostępnych w
                klubie V3. Połączenie drenażu limfatycznego, precyzyjnej analizy
                składu ciała i indywidualnych wytycznych żywieniowo-treningowych
                to najszybszy krok do lekkich nóg, wymarzonej sylwetki i
                doskonałego samopoczucia.
              </p>

              <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                <div class="rounded-2xl border border-white/8 bg-v3-card p-4">
                  <span class="block text-sm font-bold uppercase tracking-wider text-pink-400 leading-tight">
                    Drenaż limfatyczny
                  </span>
                  <p class="mt-1.5 text-xs sm:text-sm leading-relaxed text-zinc-300">
                    Redukcja opuchlizny, uczucie lekkich nóg i regeneracja.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/8 bg-v3-card p-4">
                  <span class="block text-sm font-bold uppercase tracking-wider text-pink-400 leading-tight">
                    Analiza składu ciała
                  </span>
                  <p class="mt-1.5 text-xs sm:text-sm leading-relaxed text-zinc-300">
                    Pomiar tkanki tłuszczowej, mięśniowej i wody.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/8 bg-v3-card p-4">
                  <span class="block text-sm font-bold uppercase tracking-wider text-pink-400 leading-tight">
                    Wytyczne dietetyczne
                  </span>
                  <p class="mt-1.5 text-xs sm:text-sm leading-relaxed text-zinc-300">
                    Plan żywieniowy dopasowany do Twojego trybu życia.
                  </p>
                </div>
                <div class="rounded-2xl border border-white/8 bg-v3-card p-4">
                  <span class="block text-sm font-bold uppercase tracking-wider text-pink-400 leading-tight">
                    Kontrola postępów
                  </span>
                  <p class="mt-1.5 text-xs sm:text-sm leading-relaxed text-zinc-300">
                    Monitorowanie efektów, motywacja i opieka.
                  </p>
                </div>
              </div>

              <div class="mt-6 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 sm:gap-4">
                <a
                  href="tel:+48733484404"
                  aria-label="Zadzwoń i umów się z trenerką Zuzą: 733 484 404"
                  class="inline-flex w-full sm:w-auto justify-center items-center gap-2 rounded-2xl bg-pink-500 px-6 py-3.5 text-xs sm:text-sm font-extrabold uppercase tracking-wider text-white transition hover:bg-pink-400"
                >
                  <svg
                    class="h-4 w-4 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    />
                  </svg>
                  <span>Umów się z Zuzą: 733 484 404</span>
                </a>
                <span class="text-xs sm:text-sm text-zinc-400 text-center sm:text-left">
                  Pierwsza konsultacja i pomiar na miejscu w klubie
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ScheduleBoard
      initialZone="fitness"
      lockedZone={true}
      title="Grafik Fitness"
      subtitle="Wybierz rodzaj zajęć poniżej, aby wyświetlić tylko ich dni i godziny."
    />

    <Contact />
  </main>
</Layout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>(".jump-to-fitness-schedule")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.jumpCategory;
        const scheduleSection = document.getElementById("grafik-strefy");
        const filterBtn = document.querySelector<HTMLButtonElement>(
          `[data-filter-zone="fitness"][data-filter-cat="${cat}"]`,
        );

        if (filterBtn) {
          filterBtn.click();
        }
        scheduleSection?.scrollIntoView({ behavior: "smooth" });
      });
    });
</script>
