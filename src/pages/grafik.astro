---
import Layout from "../layouts/Layout.astro";
import SeasonalBanner from "../components/SeasonalBanner.astro";
import Navbar from "../components/Navbar.astro";
import ScheduleBoard from "../components/ScheduleBoard.astro";
import Contact from "../components/Contact.astro";
---

<Layout
  title="Grafik Zajęć V3 Klub Jarosław • Fight Zone & Fitness | Rezerwacje GymManager"
  description="Aktualny grafik zajęć grupowych w V3 Klub Jarosław. Sprawdź godziny treningów Boksu, Kickboxingu, MMA, Krav Magi, Pilatesu, Jogi, Booty Project i CROSS."
>
  <SeasonalBanner />
  <Navbar />

  <main>
    <section class="relative overflow-hidden border-b border-white/10 bg-v3-dark bg-v3-grid py-10 sm:py-12">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <nav
          aria-label="Ścieżka nawigacji"
          class="flex items-center gap-2 text-xs font-semibold text-zinc-400 mb-3"
        >
          <a href="/" class="hover:text-v3-lime transition-colors">
            Strona główna
          </a>
          <span>/</span>
          <span class="text-zinc-200">Grafik Zajęć</span>
        </nav>

        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
          <div>
            <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-black uppercase leading-none text-white">
              Harmonogram <span class="text-v3-lime">V3 Klub</span>
            </h1>
            <p class="mt-1.5 text-xs sm:text-sm text-zinc-300">
              Wybierz strefę oraz kliknij nazwę zajęć, aby szybko wyświetlić
              pasujące dni i godziny.
            </p>
          </div>

          <a
            href="https://v3klub.gymmanager.io"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 rounded-2xl bg-v3-lime pl-5 pr-3 py-2.5 text-xs sm:text-sm font-extrabold uppercase tracking-wider text-black transition hover:bg-white shrink-0 self-start sm:self-auto"
          >
            <span>Zapisz się w GymManager</span>
            <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-black/15 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
              <svg
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M7 17L17 7M7 7h10v10"
                />
              </svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <ScheduleBoard
      initialZone="fight"
      lockedZone={false}
      title="Grafik"
      subtitle="Rezerwacje miejsc na zajęcia odbywają się bezpośrednio w aplikacji mobilnej lub panelu GymManager."
    />

    <section class="border-b border-white/10 bg-v3-surface/40 py-10 sm:py-12">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <a
            href="/fight-zone"
            class="group flex items-center justify-between rounded-2xl border border-white/10 bg-v3-surface p-5 transition hover:border-v3-red/50"
          >
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-v3-red block">
                Sporty Walki
              </span>
              <span class="mt-1 font-display text-2xl font-extrabold uppercase text-white group-hover:text-v3-red transition-colors block">
                Dyscypliny Fight Zone
              </span>
            </div>
            <svg
              class="h-5 w-5 text-zinc-500 group-hover:text-v3-red transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M7 17L17 7M7 7h10v10"
              />
            </svg>
          </a>

          <a
            href="/fitness"
            class="group flex items-center justify-between rounded-2xl border border-white/10 bg-v3-surface p-5 transition hover:border-v3-lime/50"
          >
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-v3-lime block">
                Siłownia &amp; Grupy
              </span>
              <span class="mt-1 font-display text-2xl font-extrabold uppercase text-white group-hover:text-v3-lime transition-colors block">
                Zajęcia Fitness &amp; Wellness
              </span>
            </div>
            <svg
              class="h-5 w-5 text-zinc-500 group-hover:text-v3-lime transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M7 17L17 7M7 7h10v10"
              />
            </svg>
          </a>

          <a
            href="/#cennik"
            class="group flex items-center justify-between rounded-2xl border border-white/10 bg-v3-surface p-5 transition hover:border-v3-lime/50"
          >
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-zinc-400 block">
                Członkostwo
              </span>
              <span class="mt-1 font-display text-2xl font-extrabold uppercase text-white group-hover:text-v3-lime transition-colors block">
                Cennik Karnetów V3
              </span>
            </div>
            <svg
              class="h-5 w-5 text-zinc-500 group-hover:text-v3-lime transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M7 17L17 7M7 7h10v10"
              />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <Contact />
  </main>
</Layout>
