---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "V3 Centrum Sportowe Jarosław | Siłownia, Fitness, Fight Zone",
  description = "Nowoczesne centrum sportowe w Jarosławiu przy ul. Poniatowskiego 24. Samoobsługa 5:00–24:00, siłownia Bodytone, dedykowana Strefa Kobiet i sporty walki.",
} = Astro.props;
---

<!doctype html>
<html lang="pl" class="scroll-smooth scroll-pt-24">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Dane strukturalne Schema.org (Lokalne SEO 2026) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ExerciseGym",
        "name": "V3 Klub - Centrum Sportowe Jarosław",
        "description": "Nowoczesne centrum sportowe w Jarosławiu: siłownia Bodytone, wolne ciężary, Fight Zone (Boks, Kickboxing, MMA, Ju-Jitsu, Krav Maga), dedykowana Strefa Kobiet oraz zajęcia fitness i cross. Samoobsługowe wejście 5:00 – 24:00 na kod QR.",
        "url": "https://v3-website-ten.vercel.app/",
        "telephone": "+48788463717",
        "priceRange": "109 PLN - 309 PLN",
        "image": "https://v3-website-ten.vercel.app/images/v3-gym-brick.jpeg",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "ul. Poniatowskiego 24",
          "addressLocality": "Jarosław",
          "postalCode": "37-500",
          "addressRegion": "Podkarpackie",
          "addressCountry": "PL"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 50.0163,
          "longitude": 22.6778
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday",
              "Sunday"
            ],
            "opens": "05:00",
            "closes": "23:59"
          }
        ],
        "sameAs": [
          "https://v3klub.gymmanager.io"
        ]
      }
    </script>
  </head>
  <body class="bg-v3-dark text-zinc-100 font-sans antialiased selection:bg-v3-lime selection:text-black min-h-screen flex flex-col">
    <slot />
  </body>
</html>

<style is:global>
  [class*="font-['Teko']"],
  [class*="font-['Rajdhani']"],
  .font-teko,
  .font-display {
    font-family: 'Rajdhani', sans-serif !important;
    letter-spacing: 0.02em;
  }
</style>