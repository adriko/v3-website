---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "V3 Klub Jarosław • Siłownia, Fitness, Fight Zone",
  description = "Nowoczesne centrum sportowe w Jarosławiu przy ul. Poniatowskiego 24. Samoobsługa 5:00–24:00, siłownia Bodytone, dedykowana Strefa Kobiet i sporty walki.",
} = Astro.props;

const v3Favicon = `data:image/svg+xml,${encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 100"><rect width="120" height="100" rx="20" fill="#090A0D"/><path fill="#C8FF00" d="M42 12 H106 L63.3 86 H46 L39.7 75 H56.5 L86.5 23 H48.3 L42 12 Z"/><path fill="#C8FF00" d="M14 25 H26.7 L32.5 35 H74.5 L68.2 46 H38.8 L44.6 56 H62.5 L56.2 67 H38.2 L14 25 Z"/></svg>',
)}`;
---

<!doctype html>
<html lang="pl" class="scroll-smooth scroll-pt-24">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={v3Favicon} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;0,900;1,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ExerciseGym",
        "name": "V3 Klub - Centrum Sportowe Jarosław",
        "description": "Nowoczesne centrum sportowe w Jarosławiu: siłownia Bodytone, wolne ciężary, Fight Zone, dedykowana Strefa Kobiet oraz zajęcia fitness i cross. Samoobsługowe wejście 5:00 – 24:00 na kod QR.",
        "url": "https://v3-website-ten.vercel.app/",
        "telephone": "+48788463717",
        "priceRange": "109 PLN - 309 PLN",
        "image": "https://v3-website-ten.vercel.app/images/v3-gym-brick.jpeg",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "ul. Poniatowskiego 24",
          "addressLocality": "Jarosław",
          "postalCode": "37-500",
          "addressRegion": "Podkarpackie",
          "addressCountry": "PL"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 50.0163,
          "longitude": 22.6778
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday",
              "Sunday"
            ],
            "opens": "05:00",
            "closes": "23:59"
          }
        ],
        "sameAs": ["https://v3klub.gymmanager.io"]
      }
    </script>
  </head>
  <body class="bg-v3-dark text-zinc-100 font-sans antialiased selection:bg-v3-lime selection:text-black min-h-screen flex flex-col">
    <slot />
  </body>
</html>

<style is:global>
  [class*="font-['Teko']"],
  [class*="font-['Rajdhani']"],
  .font-display {
    font-family: "Barlow Condensed", sans-serif !important;
  }
</style>
