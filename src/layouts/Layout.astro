---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "V3 Klub Jarosław | Siłownia 5:00-24:00 • Fitness • Strefa Kobiet • KSW Sokół Fight Zone",
  description = "Centrum Sportowe V3 w Jarosławiu (ul. Poniatowskiego 24). Samoobsługowa siłownia 5:00-24:00, dedykowana Strefa Kobiet, zajęcia grupowe Fitness, Cross w cenie karnetu oraz sekcja sportów walki KSW Sokół (Boks, Kickboxing, MMA, Ju-Jitsu, Krav Maga).",
} = Astro.props;

const schemaData = {
  "@context": "https://schema.org",
  "@type": ["ExerciseGym", "SportsActivityLocation"],
  name: "Centrum Sportowe V3 Klub Jarosław",
  alternateName: "V3 Klub & KSW Sokół Jarosław",
  description: description,
  url: "https://v3-website-ten.vercel.app/",
  telephone: "+48788463717",
  priceRange: "30 PLN - 660 PLN",
  image: "https://v3-website-ten.vercel.app/images/v3-gym-brick.jpeg",
  address: {
    "@type": "PostalAddress",
    streetAddress: "ul. Poniatowskiego 24",
    addressLocality: "Jarosław",
    postalCode: "37-500",
    addressRegion: "Podkarpackie",
    addressCountry: "PL",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 50.0145,
    longitude: 22.6778,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "05:00",
      closes: "24:00",
    },
  ],
  sameAs: [
    "https://www.facebook.com/V3CentrumSportowe/",
    "https://www.instagram.com/v3_klub_jaroslaw/",
    "https://www.tiktok.com/@v3_klub_jaroslaw",
  ],
};
---

<!doctype html>
<html lang="pl" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/v3-gym-brick.jpeg" />

    <!-- Preload critical hero image -->
    <link rel="preload" as="image" href="/images/v3-gym-brick.jpeg" />

    <!-- Google Fonts: Inter, Montserrat & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Montserrat:wght@700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body
    class="bg-zinc-950 text-zinc-100 antialiased selection:bg-red-600 selection:text-white overflow-x-hidden pb-14 lg:pb-0"
  >
    <slot />
  </body>
</html>
