---
import { TRAINERS, type Trainer } from '../data/trainers';

const getLastName = (fullName: string) => {
  const parts = fullName.trim().split(/\s+/);
  return parts[parts.length - 1] || '';
};

// Sortowanie alfabetyczne po nazwisku z polskimi znakami
const fightTrainers: Trainer[] = TRAINERS
  .filter((t: Trainer) => t.zone === 'fight')
  .sort((a: Trainer, b: Trainer) => getLastName(a.name).localeCompare(getLastName(b.name), 'pl'));

const gymTrainers: Trainer[] = TRAINERS
  .filter((t: Trainer) => t.zone === 'gym')
  .sort((a: Trainer, b: Trainer) => getLastName(a.name).localeCompare(getLastName(b.name), 'pl'));
---

<section id="kadra" class="relative overflow-hidden border-b border-v3-border bg-v3-dark py-16 sm:py-24">
  <!-- Dyskretna poświata centralna -->
  <div class="pointer-events-none absolute -top-20 left-1/2 -translate-x-1/2 h-125 w-200 max-w-full rounded-full bg-v3-red/10 blur-[140px]" id="trainers-glow"></div>

  <div class="mx-auto max-w-7xl px-4 lg:px-8 relative">

    <!-- Górny nagłówek i przełącznik stref kadry -->
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <div class="inline-flex items-center gap-2 text-[10px] sm:text-xs font-bold uppercase tracking-widest px-2.5 py-0.5 rounded border border-v3-red/40 bg-v3-red/10 text-v3-red mb-2" id="trainers-badge">
          <span>&gt;&gt;&gt;</span>
          <span>Profesjonalna Kadra Szkoleniowa V3</span>
        </div>
        <h2 class="font-['Teko'] text-4xl sm:text-6xl font-bold uppercase leading-[0.95] text-white">
          Nasi <span id="trainers-title-accent" class="text-v3-red">Trenerzy</span>
        </h2>
        <p class="mt-2 text-xs sm:text-base text-zinc-300 max-w-2xl leading-relaxed">
          Doświadczeni szkoleniowcy KSW Sokół Jarosław z licencjami PZKB oraz certyfikowani trenerzy personalni i instruktorzy wellness.
        </p>
      </div>

      <!-- Przełącznik stref trenerskich -->
      <div class="inline-flex items-center rounded-2xl border border-v3-border bg-v3-surface p-1.5 self-start md:self-auto shadow-md">
        <button
          type="button"
          id="btn-tab-fight"
          class="cursor-pointer rounded-xl bg-v3-red px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-lg transition"
        >
          Fight Zone ({fightTrainers.length})
        </button>
        <button
          type="button"
          id="btn-tab-gym"
          class="cursor-pointer rounded-xl px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-zinc-300 transition hover:text-white"
        >
          Siłownia & Fitness ({gymTrainers.length})
        </button>
      </div>
    </div>

    <!-- Kontener 1: Trenerzy FIGHT ZONE -->
    <div id="wrapper-fight-trainers" class="mt-10 sm:mt-12">
      <!-- Strzałki nawigacyjne Desktop -->
      <div class="hidden sm:flex justify-end gap-2 mb-4">
        <button
          type="button"
          id="fight-prev"
          aria-label="Poprzedni trener"
          class="w-10 h-10 rounded-xl border border-v3-border bg-v3-surface hover:bg-v3-card flex items-center justify-center text-zinc-300 hover:text-white transition active:scale-95 cursor-pointer shadow-md"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          id="fight-next"
          aria-label="Następny trener"
          class="w-10 h-10 rounded-xl border border-v3-border bg-v3-surface hover:bg-v3-card flex items-center justify-center text-zinc-300 hover:text-white transition active:scale-95 cursor-pointer shadow-md"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <!-- Horyzontalna lista z dotykowym snapem i pełnymi opisami -->
      <div
        id="slider-fight"
        class="flex items-stretch gap-4 sm:gap-6 overflow-x-auto pb-6 pt-1 snap-x snap-mandatory scroll-smooth touch-pan-x [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden -mx-4 px-4 sm:mx-0 sm:px-0"
      >
        {fightTrainers.map((t: Trainer) => {
          const initials = t.name.split(' ').map((n: string) => n[0]).join('');
          return (
            <div class="shrink-0 w-[82vw] max-w-85 sm:w-90 snap-center rounded-2xl sm:rounded-3xl border border-v3-border bg-v3-surface/85 backdrop-blur-md p-5 sm:p-6 flex flex-col justify-between transition-all duration-300 hover:border-v3-red/50 hover:shadow-xl shadow-md group">
              <div>
                <!-- Awatar zastępczy / Zdjęcie -->
                <div class="relative w-full h-56 sm:h-64 rounded-xl sm:rounded-2xl overflow-hidden border border-white/5 bg-v3-card mb-4 flex items-center justify-center">
                  {t.image ? (
                    <img src={t.image} alt={t.name} loading="lazy" decoding="async" class="w-full h-full object-cover object-top transition duration-500 group-hover:scale-105" />
                  ) : (
                    <div class="w-full h-full flex flex-col items-center justify-center bg-linear-to-b from-v3-card via-v3-surface to-v3-dark text-center p-4 relative">
                      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-size-[16px_16px]"></div>
                      <div class="w-20 h-20 rounded-full border-2 border-v3-red/40 bg-v3-red/10 text-v3-red flex items-center justify-center font-['Teko'] text-3xl font-bold tracking-wider mb-2 shadow-inner z-10">
                        {initials}
                      </div>
                      <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-300 z-10">Zdjęcie w przygotowaniu</span>
                      <span class="text-[10px] text-zinc-400 mt-0.5 z-10 font-mono">KSW Sokół & V3</span>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-linear-to-t from-v3-dark via-transparent to-transparent pointer-events-none"></div>
                  {t.leadsClasses && (
                    <div class="absolute bottom-2.5 left-2.5 right-2.5 text-[10px] sm:text-[11px] font-bold uppercase tracking-wider px-2.5 py-1.5 rounded-lg bg-v3-dark/95 backdrop-blur-md text-white border border-white/10 leading-tight">
                      <span class="mr-1">🎯</span>{t.leadsClasses}
                    </div>
                  )}
                </div>

                <div>
                  <h3 class="font-['Teko'] text-2xl sm:text-3xl font-bold uppercase tracking-wide text-white leading-none">
                    {t.name}
                  </h3>
                  <p class="text-xs sm:text-sm font-semibold text-v3-red mt-1 leading-snug">
                    {t.role}
                  </p>
                </div>

                <div class="flex flex-wrap gap-1.5 mt-3">
                  {t.tags.map((tag: string) => (
                    <span class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-v3-card text-zinc-300 border border-white/5">
                      {tag}
                    </span>
                  ))}
                </div>

                <p class="text-xs sm:text-sm text-zinc-300 mt-3.5 leading-relaxed">
                  {t.description}
                </p>
              </div>

              <div class="mt-6 pt-3.5 border-t border-v3-border flex items-center justify-between text-xs">
                <span class="text-zinc-400 font-medium text-[11px]">Treningi Personalne</span>
                <a href="tel:+48788463717" class="font-bold uppercase tracking-wider text-v3-red hover:underline flex items-center gap-1 text-[11px]">
                  Zapytaj w klubie &rarr;
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Kontener 2: Trenerzy SIŁOWNIA & FITNESS -->
    <div id="wrapper-gym-trainers" class="mt-10 sm:mt-12 hidden">
      <!-- Strzałki nawigacyjne Desktop -->
      <div class="hidden sm:flex justify-end gap-2 mb-4">
        <button
          type="button"
          id="gym-prev"
          aria-label="Poprzedni trener"
          class="w-10 h-10 rounded-xl border border-v3-border bg-v3-surface hover:bg-v3-card flex items-center justify-center text-zinc-300 hover:text-white transition active:scale-95 cursor-pointer shadow-md"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          id="gym-next"
          aria-label="Następny trener"
          class="w-10 h-10 rounded-xl border border-v3-border bg-v3-surface hover:bg-v3-card flex items-center justify-center text-zinc-300 hover:text-white transition active:scale-95 cursor-pointer shadow-md"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <!-- Horyzontalna lista z dotykowym snapem i pełnymi opisami -->
      <div
        id="slider-gym"
        class="flex items-stretch gap-4 sm:gap-6 overflow-x-auto pb-6 pt-1 snap-x snap-mandatory scroll-smooth touch-pan-x [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden -mx-4 px-4 sm:mx-0 sm:px-0"
      >
        {gymTrainers.map((t: Trainer) => {
          const initials = t.name.split(' ').map((n: string) => n[0]).join('');
          return (
            <div class="shrink-0 w-[82vw] max-w-85 sm:w-90 snap-center rounded-2xl sm:rounded-3xl border border-v3-border bg-v3-surface/85 backdrop-blur-md p-5 sm:p-6 flex flex-col justify-between transition-all duration-300 hover:border-v3-lime/50 hover:shadow-xl shadow-md group">
              <div>
                <!-- Awatar zastępczy / Zdjęcie -->
                <div class="relative w-full h-56 sm:h-64 rounded-xl sm:rounded-2xl overflow-hidden border border-white/5 bg-v3-card mb-4 flex items-center justify-center">
                  {t.image ? (
                    <img src={t.image} alt={t.name} loading="lazy" decoding="async" class="w-full h-full object-cover object-top transition duration-500 group-hover:scale-105" />
                  ) : (
                    <div class="w-full h-full flex flex-col items-center justify-center bg-linear-to-b from-v3-card via-v3-surface to-v3-dark text-center p-4 relative">
                      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-size-[16px_16px]"></div>
                      <div class="w-20 h-20 rounded-full border-2 border-v3-lime/40 bg-v3-lime/10 text-v3-lime flex items-center justify-center font-['Teko'] text-3xl font-bold tracking-wider mb-2 shadow-inner z-10">
                        {initials}
                      </div>
                      <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-300 z-10">Zdjęcie w przygotowaniu</span>
                      <span class="text-[10px] text-zinc-400 mt-0.5 z-10 font-mono">Centrum Sportowe V3</span>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-linear-to-t from-v3-dark via-transparent to-transparent pointer-events-none"></div>
                  {t.leadsClasses && (
                    <div class="absolute bottom-2.5 left-2.5 right-2.5 text-[10px] sm:text-[11px] font-bold uppercase tracking-wider px-2.5 py-1.5 rounded-lg bg-v3-dark/95 backdrop-blur-md text-white border border-white/10 leading-tight">
                      <span class="mr-1">🎯</span>{t.leadsClasses}
                    </div>
                  )}
                </div>

                <div>
                  <h3 class="font-['Teko'] text-2xl sm:text-3xl font-bold uppercase tracking-wide text-white leading-none">
                    {t.name}
                  </h3>
                  <p class="text-xs sm:text-sm font-semibold text-v3-lime mt-1 leading-snug">
                    {t.role}
                  </p>
                </div>

                <div class="flex flex-wrap gap-1.5 mt-3">
                  {t.tags.map((tag: string) => (
                    <span class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-v3-card text-zinc-300 border border-white/5">
                      {tag}
                    </span>
                  ))}
                </div>

                <p class="text-xs sm:text-sm text-zinc-300 mt-3.5 leading-relaxed">
                  {t.description}
                </p>
              </div>

              <div class="mt-6 pt-3.5 border-t border-v3-border">
                {t.specialLink ? (
                  <a href={t.specialLink.href} class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 rounded-xl border border-pink-500/40 bg-pink-500/10 text-pink-400 hover:bg-pink-500/20 text-xs font-bold uppercase tracking-wider transition active:scale-[0.98]">
                    <span>{t.specialLink.label}</span>
                  </a>
                ) : (
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-zinc-400 font-medium text-[11px]">Treningi Personalne</span>
                    <a href="tel:+48788463717" class="font-bold uppercase tracking-wider text-v3-lime hover:underline flex items-center gap-1 text-[11px]">
                      Zapytaj w klubie &rarr;
                    </a>
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>

  </div>
</section>

<script>
  const btnFight = document.getElementById('btn-tab-fight');
  const btnGym = document.getElementById('btn-tab-gym');
  const wrapFight = document.getElementById('wrapper-fight-trainers');
  const wrapGym = document.getElementById('wrapper-gym-trainers');
  const titleAccent = document.getElementById('trainers-title-accent');
  const badgeEl = document.getElementById('trainers-badge');
  const glowEl = document.getElementById('trainers-glow');

  function switchTrainersTab(tab: 'fight' | 'gym') {
    if (!btnFight || !btnGym || !wrapFight || !wrapGym || !titleAccent || !badgeEl || !glowEl) return;

    if (tab === 'fight') {
      btnFight.className = 'cursor-pointer rounded-xl bg-v3-red px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-lg transition';
      btnGym.className = 'cursor-pointer rounded-xl px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-zinc-300 transition hover:text-white';
      wrapFight.classList.remove('hidden');
      wrapGym.classList.add('hidden');
      titleAccent.className = 'text-v3-red';
      badgeEl.className = 'inline-flex items-center gap-2 text-[10px] sm:text-xs font-bold uppercase tracking-widest px-2.5 py-0.5 rounded border border-v3-red/40 bg-v3-red/10 text-v3-red mb-2';
      glowEl.className = 'pointer-events-none absolute -top-20 left-1/2 -translate-x-1/2 h-125 w-200 max-w-full rounded-full bg-v3-red/10 blur-[140px]';
    } else {
      btnGym.className = 'cursor-pointer rounded-xl bg-v3-lime px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-black shadow-lg transition';
      btnFight.className = 'cursor-pointer rounded-xl px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-zinc-300 transition hover:text-white';
      wrapGym.classList.remove('hidden');
      wrapFight.classList.add('hidden');
      titleAccent.className = 'text-v3-lime';
      badgeEl.className = 'inline-flex items-center gap-2 text-[10px] sm:text-xs font-bold uppercase tracking-widest px-2.5 py-0.5 rounded border border-v3-lime/40 bg-v3-lime/10 text-v3-lime mb-2';
      glowEl.className = 'pointer-events-none absolute -top-20 left-1/2 -translate-x-1/2 h-125 w-200 max-w-full rounded-full bg-v3-lime/10 blur-[140px]';
    }
  }

  btnFight?.addEventListener('click', () => switchTrainersTab('fight'));
  btnGym?.addEventListener('click', () => switchTrainersTab('gym'));

  // Strzałki nawigacyjne
  const sliderFight = document.getElementById('slider-fight');
  const sliderGym = document.getElementById('slider-gym');

  document.getElementById('fight-prev')?.addEventListener('click', () => sliderFight?.scrollBy({ left: -340, behavior: 'smooth' }));
  document.getElementById('fight-next')?.addEventListener('click', () => sliderFight?.scrollBy({ left: 340, behavior: 'smooth' }));
  document.getElementById('gym-prev')?.addEventListener('click', () => sliderGym?.scrollBy({ left: -340, behavior: 'smooth' }));
  document.getElementById('gym-next')?.addEventListener('click', () => sliderGym?.scrollBy({ left: 340, behavior: 'smooth' }));
</script>
