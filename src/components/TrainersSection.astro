---
import { TRAINERS, type Trainer } from '../data/trainers';

const sortedTrainers: Trainer[] = [...TRAINERS].sort((a, b) =>
  a.name.localeCompare(b.name, 'pl')
);

function getInitials(name: string): string {
  return name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);
}
---

<section id="kadra" class="py-16 lg:py-24 bg-zinc-950 border-b border-zinc-900 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Header + Navigation Arrows -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6">
      <div>
        <div class="inline-flex items-center gap-2 text-red-500 font-mono text-xs uppercase tracking-wider mb-2.5 font-semibold">
          <span>&gt;&gt;&gt;</span>
          <span>Profesjonalna Kadra Szkoleniowa V3</span>
        </div>
        <h2 class="font-heading text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">
          Nasi <span class="text-red-600">Trenerzy</span>
        </h2>
        <p class="text-zinc-300 text-sm sm:text-base max-w-2xl mt-2 leading-relaxed">
          Doświadczeni szkoleniowcy KSW Sokół Jarosław z licencjami PZKB oraz certyfikowani trenerzy personalni i instruktorzy wellness.
        </p>
      </div>

      <!-- Slider Controls -->
      <div class="flex items-center gap-2.5 self-start md:self-end">
        <button
          id="trainers-prev"
          type="button"
          aria-label="Poprzedni trener"
          class="w-11 h-11 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-200 hover:text-white flex items-center justify-center transition-colors cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <button
          id="trainers-next"
          type="button"
          aria-label="Następny trener"
          class="w-11 h-11 rounded-xl bg-red-600 hover:bg-red-500 text-white flex items-center justify-center transition-colors shadow-md cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>

    <!-- Horizontal Carousel Container -->
    <div class="relative -mx-4 px-4 sm:mx-0 sm:px-0">
      <!-- Right Fade Gradient Hint on Desktop -->
      <div class="hidden lg:block absolute top-0 right-0 bottom-4 w-20 bg-linear-to-l from-zinc-950 to-transparent z-20 pointer-events-none"></div>

      <div
        id="trainers-track"
        class="flex gap-5 overflow-x-auto pb-4 snap-x snap-mandatory scroll-smooth scrollbar-none"
      >
        {sortedTrainers.map((t: Trainer) => {
          const isFight = t.zone === 'fight';
          const isPink = t.id === 'zuzanna-janicka';
          const initials = getInitials(t.name);

          return (
            <article class="w-[84vw] max-w-85 sm:w-87.5 shrink-0 snap-start bg-zinc-900/50 border border-zinc-800/90 hover:border-zinc-700 rounded-2xl overflow-hidden flex flex-col justify-between transition-all">
              <div>
                <!-- Card Top Visual / Photo or Initials -->
                <div class="relative h-56 bg-zinc-900 overflow-hidden border-b border-zinc-800/80">
                  {t.image ? (
                    <img
                      src={t.image}
                      alt={t.name}
                      class="w-full h-full object-cover object-top"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="w-full h-full flex flex-col items-center justify-center bg-linear-to-br from-zinc-900 via-zinc-950 to-zinc-900 relative">
                      <div class:list={[
                        "w-20 h-20 rounded-2xl flex items-center justify-center font-heading text-2xl font-black border",
                        isFight
                          ? "bg-red-950/40 border-red-500/30 text-red-500"
                          : isPink
                            ? "bg-rose-950/40 border-rose-500/30 text-rose-400"
                            : "bg-zinc-900 border-zinc-700 text-zinc-200"
                      ]}>
                        {initials}
                      </div>
                      <span class="mt-2.5 text-[11px] font-mono uppercase tracking-wide text-zinc-400">
                        {isFight ? 'KSW Sokół & V3' : 'V3 Klub • Siłownia & Fitness'}
                      </span>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-linear-to-t from-zinc-950 via-transparent to-transparent"></div>

                  <!-- Leads Classes Pill -->
                  {t.leadsClasses && (
                    <div class="absolute bottom-3 left-3 right-3 flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-950/90 backdrop-blur-md border border-zinc-800 text-xs font-mono text-zinc-200 truncate">
                      <span>🎯</span>
                      <span class="truncate">{t.leadsClasses}</span>
                    </div>
                  )}
                </div>

                <!-- Trainer Details -->
                <div class="p-5">
                  <div class="mb-3">
                    <h3 class="text-xl font-bold text-white tracking-tight">{t.name}</h3>
                    <p class:list={[
                      "text-xs font-mono font-semibold mt-0.5",
                      isFight ? "text-red-400" : isPink ? "text-rose-400" : "text-zinc-300"
                    ]}>
                      {t.role}
                    </p>
                  </div>

                  <!-- Specialization Tags -->
                  <div class="flex flex-wrap gap-1.5 mb-4">
                    {t.tags.map((tag: string) => (
                      <span class="px-2 py-0.5 rounded bg-zinc-950 border border-zinc-800 text-[11px] font-mono text-zinc-300">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed">
                    {t.description}
                  </p>
                </div>
              </div>

              <!-- Card Footer CTA -->
              <div class="px-5 py-3.5 bg-zinc-950/60 border-t border-zinc-800/80 flex items-center justify-between gap-2 text-xs font-mono">
                <span class="text-zinc-400 truncate">
                  {t.experience}
                </span>
                {t.specialLink ? (
                  <a
                    href={t.specialLink.href}
                    class="font-bold text-rose-400 hover:text-rose-300 transition-colors shrink-0"
                  >
                    Strefa Kobiet →
                  </a>
                ) : (
                  <a
                    href="tel:+48788463717"
                    class="font-bold text-red-400 hover:text-red-300 transition-colors shrink-0"
                  >
                    Zapytaj w klubie →
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>

  </div>
</section>

<script>
  const track = document.getElementById('trainers-track');
  const prevBtn = document.getElementById('trainers-prev');
  const nextBtn = document.getElementById('trainers-next');

  const scrollAmount = 370;

  prevBtn?.addEventListener('click', () => {
    track?.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
  });

  nextBtn?.addEventListener('click', () => {
    track?.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  });
</script>
