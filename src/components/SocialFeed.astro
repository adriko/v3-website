---
const socialPosts = [
  {
    type: 'reel',
    platform: 'Instagram',
    tag: 'Fight Zone',
    title: 'Sparingi bokserskie i technika na macie',
    author: '@v3_klub_jaroslaw',
    url: 'https://www.instagram.com/v3_klub_jaroslaw/',
    badgeColor: 'bg-v3-red text-white',
    imgSrc: '/images/boks2.jpg',
  },
  {
    type: 'post',
    platform: 'Instagram',
    tag: 'Strefa Kobiet',
    title: 'Prywatna różowa strefa wyłącznie dla Pań!',
    author: '@v3_klub_jaroslaw',
    url: 'https://www.instagram.com/v3_klub_jaroslaw/',
    badgeColor: 'bg-pink-500 text-white',
    imgSrc: '/images/women-zone.jpg',
  },
  {
    type: 'reel',
    platform: 'TikTok',
    tag: 'Klub & Recepcja',
    title: 'Poznaj nasz team i strefę chillout przed treningiem',
    author: '@v3_klub_jaroslaw',
    url: 'https://www.tiktok.com/@v3_klub_jaroslaw',
    badgeColor: 'bg-v3-lime text-black',
    imgSrc: '/images/recepcja1.png',
  },
  {
    type: 'post',
    platform: 'Facebook',
    tag: 'Trening & Opieka',
    title: 'Drenaż limfatyczny i analiza składu ciała z Zuzą',
    author: 'V3 Centrum Sportowe',
    url: 'https://www.facebook.com/V3CentrumSportowe/',
    badgeColor: 'bg-blue-600 text-white',
    imgSrc: '/images/zuza.jpg',
  },
];
---

<section id="social-feed" class="py-16 sm:py-24 bg-v3-dark border-b border-v3-border relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 sm:mb-12">
      <div>
        <div class="inline-flex items-center gap-2 text-v3-lime text-[11px] sm:text-xs font-black uppercase tracking-widest mb-2">
          <span class="w-2 h-2 rounded-full bg-v3-lime animate-pulse"></span>
          Klimat z naszych mediów
        </div>
        <h2 class="font-['Teko'] text-4xl sm:text-6xl font-black uppercase text-white leading-none">
          Życie Klubu <span class="text-v3-lime">V3</span>
        </h2>
        <p class="text-zinc-400 mt-2 text-xs sm:text-sm max-w-md">
          Przesuń palcem i zobacz atmosferę na naszych salach treningowych.
        </p>
      </div>

      <!-- Przyciski z wektorami SVG -->
      <div class="flex items-center gap-2">
        <a 
          href="https://www.instagram.com/v3_klub_jaroslaw/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-v3-surface hover:bg-[#E4405F]/10 border border-v3-border hover:border-[#E4405F]/60 text-xs font-bold uppercase tracking-wider text-white transition-all"
        >
          <svg class="w-4 h-4 text-[#E4405F]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>Instagram</span>
        </a>

        <a 
          href="https://www.tiktok.com/@v3_klub_jaroslaw" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-v3-surface hover:bg-white/10 border border-v3-border hover:border-zinc-500 text-xs font-bold uppercase tracking-wider text-white transition-all"
        >
          <svg class="w-4 h-4 text-[#25F4EE]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.86 4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-.04-4.52z"/>
          </svg>
          <span>TikTok</span>
        </a>
      </div>
    </div>

    <!-- Horyzontalny swipe -->
    <div class="flex sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-4 overflow-x-auto sm:overflow-x-visible pb-4 sm:pb-0 snap-x snap-mandatory scrollbar-none -mx-4 px-4 sm:mx-0 sm:px-0">
      {socialPosts.map((post) => (
        <a 
          href={post.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="group relative rounded-2xl sm:rounded-3xl overflow-hidden border border-v3-border hover:border-v3-lime/60 transition-all duration-300 block w-[260px] sm:w-auto h-[380px] sm:h-[440px] shrink-0 snap-center shadow-lg"
        >
          <img 
            src={post.imgSrc} 
            alt={post.title} 
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-black/40"></div>

          <div class="absolute top-3 left-3 right-3 flex items-center justify-between z-10">
            <span class={`text-[9px] sm:text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded shadow ${post.badgeColor}`}>
              {post.tag}
            </span>
            <span class="text-[9px] sm:text-[10px] font-semibold text-zinc-300 bg-black/60 backdrop-blur-md px-2 py-0.5 rounded border border-white/10">
              {post.platform}
            </span>
          </div>

          {post.type === 'reel' && (
            <div class="absolute inset-0 flex items-center justify-center z-10 pointer-events-none">
              <div class="w-10 h-10 rounded-full bg-black/60 border border-white/20 backdrop-blur-sm flex items-center justify-center text-white text-xs group-hover:bg-v3-lime group-hover:text-black group-hover:border-v3-lime transition-all">
                ▶
              </div>
            </div>
          )}

          <div class="absolute bottom-3.5 left-3.5 right-3.5 z-10">
            <span class="text-[10px] font-mono text-zinc-400 block mb-1">
              {post.author}
            </span>
            <h3 class="text-xs sm:text-sm font-bold text-white leading-snug line-clamp-2">
              {post.title}
            </h3>
            <span class="text-[10px] text-v3-lime font-bold uppercase tracking-wider mt-2 inline-flex items-center gap-1">
              Otwórz profil &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>