---
interface Props {
  size?: "sm" | "md" | "lg";
  showTagline?: boolean;
}

const { size = "md", showTagline = false } = Astro.props;

const sizeClasses = {
  sm: {
    box: "px-2.5 py-1 gap-1.5 border",
    v3: "text-xl",
    klub: "text-[10px]",
  },
  md: {
    box: "px-3.5 py-1.5 gap-2 border-2",
    v3: "text-2xl sm:text-3xl",
    klub: "text-xs sm:text-sm",
  },
  lg: {
    box: "px-5 py-2.5 gap-2.5 border-2",
    v3: "text-4xl sm:text-5xl",
    klub: "text-sm sm:text-base",
  },
}[size];
---

<div class="inline-flex items-center gap-3 select-none group">
  <!-- Main Red Framed Box matching original V3 Klub signage -->
  <div
    class:list={[
      "inline-flex items-baseline bg-zinc-950/90 border-red-600 rounded-sm shadow-[0_0_20px_rgba(220,38,38,0.2)] group-hover:shadow-[0_0_25px_rgba(220,38,38,0.45)] group-hover:border-red-500 transition-all duration-300",
      sizeClasses.box,
    ]}
  >
    <span
      class:list={[
        "font-heading font-black tracking-tight text-red-600 leading-none",
        sizeClasses.v3,
      ]}
    >
      V3
    </span>
    <span
      class:list={[
        "font-heading font-extrabold tracking-[0.14em] text-white uppercase leading-none",
        sizeClasses.klub,
      ]}
    >
      KLUB
    </span>
  </div>

  {
    showTagline && (
      <div class="hidden sm:flex flex-col leading-tight">
        <span class="text-[11px] font-mono uppercase tracking-wider text-zinc-300 font-semibold">
          Centrum Sportowe
        </span>
        <span class="text-[10px] font-mono text-zinc-400">
          Jarosław • Poniatowskiego 24
        </span>
      </div>
    )
  }
</div>
