---
---

<section
  id="silownia"
  class="py-14 sm:py-16 lg:py-20 bg-v3-dark border-b border-v3-border relative overflow-hidden ambient-glow-lime"
>
  <div class="pointer-events-none absolute -top-24 right-1/4 h-80 w-80 rounded-full bg-v3-lime/5 blur-[120px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end mb-8 sm:mb-10">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-v3-lime/10 border border-v3-lime/30 text-v3-lime text-[11px] font-bold uppercase tracking-wider mb-2">
          Nowa energia • Nowe cele
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold uppercase tracking-tight text-white leading-tight md:whitespace-nowrap">
          Siłownia &amp; <span class="text-v3-lime">Zajęcia Grupowe</span>
        </h2>
        <p class="text-zinc-300 mt-2 text-xs sm:text-sm max-w-2xl leading-normal">
          Strefa maszyn Bodytone, wolne ciężary oraz zróżnicowany grafik zajęć
          fitness, pilatesu i cross-treningu.
        </p>
      </div>

      <a
        href="#grafik"
        onclick="document.getElementById('tab-fitness')?.click()"
        class="inline-flex items-center gap-2 self-start md:self-end rounded-xl border border-v3-lime/40 bg-v3-lime/10 px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-v3-lime transition hover:bg-v3-lime/20 shrink-0 whitespace-nowrap"
      >
        Pełny grafik Fitness →
      </a>
    </div>

    <!-- Zwarty baner CROSS Z RAFAŁEM -->
    <div class="mb-8 sm:mb-10 bg-linear-to-r from-v3-card via-v3-surface to-v3-dark border border-v3-lime/40 rounded-2xl sm:rounded-3xl p-5 sm:p-7 relative overflow-hidden shadow-lg">
      <div class="max-w-xl">
        <div class="inline-block px-2.5 py-0.5 bg-v3-lime/15 border border-v3-lime/30 text-v3-lime text-[11px] font-bold uppercase tracking-wider rounded mb-2">
          Czwartki • 19:00 • Nowa salka
        </div>
        <h3 class="font-display text-2xl sm:text-4xl font-bold uppercase tracking-tight text-white leading-none">
          Zajęcia CROSS z Rafałem
        </h3>
        <p class="mt-2 text-zinc-300 text-xs sm:text-sm leading-normal">
          Wydolność, kettlowe obwody i siła.{" "}
          <strong class="text-white font-semibold">
            Zajęcia Cross w czwartki są w cenie każdego karnetu na siłownię!
          </strong>
        </p>
      </div>
    </div>

    <!-- Siatka Fitness -->
    <div
      id="fitness"
      class="scroll-mt-28 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5"
    >
      <!-- V3 ABS & STEP -->
      <div class="bg-v3-surface border border-v3-border hover:border-purple-500/50 rounded-xl sm:rounded-2xl p-4 sm:p-5 flex flex-col justify-between transition-colors">
        <div>
          <span class="text-[10px] font-bold text-purple-400 uppercase tracking-wider block mb-1">
            Poniedziałek / Środa
          </span>
          <h4 class="font-display text-xl sm:text-2xl font-bold uppercase tracking-tight text-white leading-tight">
            V3 ABS &amp; STEP
          </h4>
        </div>
        <p class="text-zinc-300 text-xs mt-2.5 leading-snug">
          Silny core, spalanie kalorii, rzeźba i stabilizacja.
        </p>
      </div>

      <!-- ZUMBA & BOOTY -->
      <div class="bg-v3-surface border border-v3-border hover:border-pink-500/50 rounded-xl sm:rounded-2xl p-4 sm:p-5 flex flex-col justify-between transition-colors">
        <div>
          <span class="text-[10px] font-bold text-pink-400 uppercase tracking-wider block mb-1">
            Wtorek / Czwartek / Piątek
          </span>
          <h4 class="font-display text-xl sm:text-2xl font-bold uppercase tracking-tight text-white leading-tight">
            ZUMBA &amp; BOOTY
          </h4>
        </div>
        <p class="text-zinc-300 text-xs mt-2.5 leading-snug">
          Modelowanie sylwetki i energia w rytmie muzyki.
        </p>
      </div>

      <!-- JOGA & PILATES -->
      <div class="bg-v3-surface border border-v3-border hover:border-blue-500/50 rounded-xl sm:rounded-2xl p-4 sm:p-5 flex flex-col justify-between transition-colors">
        <div>
          <span class="text-[10px] font-bold text-blue-400 uppercase tracking-wider block mb-1">
            Pon – Sb • Wybrane dni
          </span>
          <h4 class="font-display text-xl sm:text-2xl font-bold uppercase tracking-tight text-white leading-tight">
            JOGA &amp; PILATES
          </h4>
        </div>
        <p class="text-zinc-300 text-xs mt-2.5 leading-snug">
          Rozciąganie, mobilność, oddech i redukcja stresu.
        </p>
      </div>

      <!-- ZDROWY KRĘGOSŁUP -->
      <div class="bg-v3-surface border border-v3-border hover:border-amber-500/50 rounded-xl sm:rounded-2xl p-4 sm:p-5 flex flex-col justify-between transition-colors">
        <div>
          <span class="text-[10px] font-bold text-amber-400 uppercase tracking-wider block mb-1">
            Czwartek / Sobota
          </span>
          <h4 class="font-display text-xl sm:text-2xl font-bold uppercase tracking-tight text-white leading-tight">
            KRĘGOSŁUP
          </h4>
        </div>
        <p class="text-zinc-300 text-xs mt-2.5 leading-snug">
          Zajęcia korekcyjne i wzmacniające dla osób za biurkiem.
        </p>
      </div>
    </div>

    <!-- Baner kierujący do Kadry -->
    <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 rounded-2xl border border-v3-lime/30 bg-v3-surface/50 p-4 sm:p-5 backdrop-blur-sm">
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-v3-lime/10 border border-v3-lime/30 flex items-center justify-center shrink-0 text-v3-lime">
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.5 6.5h11M4 10h16M4 14h16M6.5 17.5h11"
            ></path>
            <rect
              x="2"
              y="9"
              width="2"
              height="6"
              rx="1"
              stroke="currentColor"
            ></rect>
            <rect
              x="20"
              y="9"
              width="2"
              height="6"
              rx="1"
              stroke="currentColor"
            ></rect>
          </svg>
        </div>
        <div>
          <h4 class="font-display text-xl sm:text-2xl font-bold uppercase leading-none text-white">
            Szukasz trenera personalnego lub wsparcia po urazie?
          </h4>
          <p class="text-xs text-zinc-300 mt-1">
            Poznaj Rafała, Wiktorię, Zuzę i Grzegorza w sekcji trenerskiej.
          </p>
        </div>
      </div>
      <a
        href="#kadra"
        data-trainers-tab="gym"
        class="inline-flex w-full sm:w-auto justify-center items-center gap-2 rounded-xl border border-v3-lime/40 bg-v3-lime/10 px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-v3-lime hover:bg-v3-lime/20 transition shrink-0"
      >
        Poznaj trenerów Siłowni →
      </a>
    </div>
  </div>
</section>
