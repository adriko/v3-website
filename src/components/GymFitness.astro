---

---

<section
  id="silownia"
  class="py-14 sm:py-24 bg-v3-dark border-b border-v3-border relative overflow-hidden ambient-glow-lime"
>
  <div
    class="pointer-events-none absolute -top-24 right-1/4 h-80 w-80 rounded-full bg-v3-lime/5 blur-[120px]"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div
      class="flex flex-col justify-between gap-4 md:flex-row md:items-end mb-8 sm:mb-12"
    >
      <div>
        <div
          class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-v3-lime/10 border border-v3-lime/30 text-v3-lime text-[11px] font-bold uppercase tracking-widest mb-2"
        >
          Nowa energia • Nowe cele
        </div>
        <h2
          class="font-['Rajdhani'] text-4xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-wide text-white leading-none lg:whitespace-nowrap"
        >
          Siłownia &amp; <span class="text-v3-lime">Zajęcia Grupowe</span>
        </h2>
        <p class="text-zinc-400 mt-2 text-xs sm:text-sm max-w-2xl">
          Strefa maszyn Bodytone, wolne ciężary oraz zróżnicowany grafik zajęć
          fitness, pilatesu i cross-treningu.
        </p>
      </div>

      <a
        href="#grafik"
        onclick="document.getElementById('tab-fitness')?.click()"
        class="inline-flex items-center gap-2 self-start rounded-xl border border-v3-lime/40 bg-v3-lime/10 px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-v3-lime transition hover:bg-v3-lime/20 shrink-0"
      >
        Pełny grafik Fitness →
      </a>
    </div>

    <!-- Zwarty baner CROSS Z RAFAŁEM -->
    <div
      class="mb-8 sm:mb-12 bg-linear-to-r from-v3-card via-v3-surface to-v3-dark border border-v3-red/80 rounded-2xl sm:rounded-3xl p-5 sm:p-8 relative overflow-hidden shadow-lg"
    >
      <div class="max-w-xl">
        <div
          class="inline-block px-2.5 py-0.5 bg-v3-red text-white text-[10px] font-black uppercase tracking-wider rounded mb-2"
        >
          Czwartki • 19:00 • Nowa salka
        </div>
        <h3
          class="font-['Rajdhani'] text-3xl sm:text-5xl font-bold uppercase tracking-wide text-white leading-none"
        >
          Zajęcia CROSS z Rafałem
        </h3>
        <p class="mt-2 text-zinc-300 text-xs sm:text-sm leading-relaxed">
          Wydolność, kettlowe obwody i siła. <strong
            class="text-white font-bold"
            >Zajęcia Cross w czwartki są w cenie każdego karnetu na siłownię!</strong
          >
        </p>
      </div>
    </div>

    <!-- Zwięzła siatka 2x2 na smartfonie -->
    <div
      id="fitness"
      class="scroll-mt-28 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6"
    >
      <!-- V3 ABS & STEP -->
      <div
        class="bg-linear-to-b from-[#1c1228] to-v3-dark border-t-2 border-t-purple-500 border-x border-b border-purple-500/30 rounded-xl sm:rounded-2xl p-3.5 sm:p-5 flex flex-col justify-between"
      >
        <div>
          <span
            class="text-[9px] sm:text-[10px] font-black text-v3-lime uppercase tracking-wider block mb-1"
          >
            Poniedziałek / Środa
          </span>
          <h4
            class="font-['Rajdhani'] text-2xl sm:text-3xl font-bold uppercase tracking-wide text-white leading-tight"
          >
            V3 ABS &amp; STEP
          </h4>
        </div>
        <p class="text-zinc-400 text-[11px] sm:text-xs mt-2 leading-snug">
          Silny core, spalanie kalorii, rzeźba i stabilizacja.
        </p>
      </div>

      <!-- ZUMBA & BOOTY -->
      <div
        class="bg-linear-to-b from-[#240e1e] to-v3-dark border-t-2 border-t-pink-500 border-x border-b border-pink-500/30 rounded-xl sm:rounded-2xl p-3.5 sm:p-5 flex flex-col justify-between"
      >
        <div>
          <span
            class="text-[9px] sm:text-[10px] font-black text-pink-400 uppercase tracking-wider block mb-1"
          >
            Wtorek / Czwartek / Piątek
          </span>
          <h4
            class="font-['Rajdhani'] text-2xl sm:text-3xl font-bold uppercase tracking-wide text-white leading-tight"
          >
            ZUMBA &amp; BOOTY
          </h4>
        </div>
        <p class="text-zinc-400 text-[11px] sm:text-xs mt-2 leading-snug">
          Modelowanie sylwetki i energia w rytmie muzyki.
        </p>
      </div>

      <!-- JOGA & PILATES -->
      <div
        class="bg-linear-to-b from-[#0c1829] to-v3-dark border-t-2 border-t-blue-500 border-x border-b border-blue-500/30 rounded-xl sm:rounded-2xl p-3.5 sm:p-5 flex flex-col justify-between"
      >
        <div>
          <span
            class="text-[9px] sm:text-[10px] font-black text-blue-400 uppercase tracking-wider block mb-1"
          >
            Pon – Sb • Wybrane dni
          </span>
          <h4
            class="font-['Rajdhani'] text-2xl sm:text-3xl font-bold uppercase tracking-wide text-white leading-tight"
          >
            JOGA &amp; PILATES
          </h4>
        </div>
        <p class="text-zinc-400 text-[11px] sm:text-xs mt-2 leading-snug">
          Rozciąganie, mobilność, oddech i redukcja stresu.
        </p>
      </div>

      <!-- ZDROWY KRĘGOSŁUP -->
      <div
        class="bg-linear-to-b from-[#24180c] to-v3-dark border-t-2 border-t-amber-500 border-x border-b border-amber-500/30 rounded-xl sm:rounded-2xl p-3.5 sm:p-5 flex flex-col justify-between"
      >
        <div>
          <span
            class="text-[9px] sm:text-[10px] font-black text-amber-400 uppercase tracking-wider block mb-1"
          >
            Czwartek / Sobota
          </span>
          <h4
            class="font-['Rajdhani'] text-2xl sm:text-3xl font-bold uppercase tracking-wide text-white leading-tight"
          >
            KRĘGOSŁUP
          </h4>
        </div>
        <p class="text-zinc-400 text-[11px] sm:text-xs mt-2 leading-snug">
          Zajęcia korekcyjne i wzmacniające dla osób za biurkiem.
        </p>
      </div>
    </div>

    <!-- Pasek udogodnień z dokumentu: Parking, Prysznice, FitBar -->
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div
        class="flex items-center gap-3 rounded-xl border border-v3-border bg-v3-surface/60 p-3 sm:p-4"
      >
        <span
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-v3-lime/10 text-v3-lime font-bold"
          >🅿️</span
        >
        <div>
          <span
            class="block text-xs font-bold uppercase tracking-wider text-white"
            >Parking dla Klubowiczów</span
          >
          <span class="text-[11px] text-zinc-400 leading-tight"
            >Wygodne miejsca parkingowe pod samym klubem</span
          >
        </div>
      </div>
      <div
        class="flex items-center gap-3 rounded-xl border border-v3-border bg-v3-surface/60 p-3 sm:p-4"
      >
        <span
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-v3-lime/10 text-v3-lime font-bold"
          >🚿</span
        >
        <div>
          <span
            class="block text-xs font-bold uppercase tracking-wider text-white"
            >Szatnie &amp; Prysznice</span
          >
          <span class="text-[11px] text-zinc-400 leading-tight"
            >Przestronne, czyste szatnie z pełnym węzłem sanitarnym</span
          >
        </div>
      </div>
      <div
        class="flex items-center gap-3 rounded-xl border border-v3-border bg-v3-surface/60 p-3 sm:p-4"
      >
        <span
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-v3-lime/10 text-v3-lime font-bold"
          >🥤</span
        >
        <div>
          <span
            class="block text-xs font-bold uppercase tracking-wider text-white"
            >FitBar z Odżywkami</span
          >
          <span class="text-[11px] text-zinc-400 leading-tight"
            >Napoje izotoniczne, shake'i białkowe i batony</span
          >
        </div>
      </div>
    </div>

    <!-- Baner kierujący do Kadry -->
    <div
      class="mt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 rounded-2xl border border-v3-lime/30 bg-v3-surface/50 p-4 sm:p-5 backdrop-blur-sm"
    >
      <div class="flex items-center gap-3">
        <span
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-v3-lime/10 border border-v3-lime/30 text-v3-lime font-bold"
        >
          🏋️
        </span>
        <div>
          <h4
            class="font-['Teko'] text-2xl font-bold uppercase leading-none text-white"
          >
            Szukasz trenera personalnego lub wsparcia po urazie?
          </h4>
          <p class="text-xs text-zinc-300">
            Poznaj Rafała, Wiktorię, Zuzę i Grzegorza w sekcji trenerskiej.
          </p>
        </div>
      </div>
      <a
        href="#kadra"
        data-trainers-tab="gym"
        class="inline-flex w-full sm:w-auto justify-center items-center gap-2 rounded-xl border border-v3-lime/40 bg-v3-lime/10 px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-v3-lime hover:bg-v3-lime/20 transition shrink-0"
      >
        Poznaj trenerów Siłowni →
      </a>
    </div>
  </div>
</section>
