---
const groupClasses = [
  {
    name: "V3 ABS & STEP",
    days: "Poniedziałek / Środa",
    desc: "Silny core, spalanie kalorii, rzeźba i stabilizacja.",
  },
  {
    name: "ZUMBA & BOOTY",
    days: "Wtorek / Czwartek / Piątek",
    desc: "Modelowanie sylwetki i energia w rytmie muzyki.",
  },
  {
    name: "JOGA & PILATES",
    days: "Pon – Sb • Wybrane dni",
    desc: "Rozciąganie, mobilność, oddech i redukcja stresu.",
  },
  {
    name: "KRĘGOSŁUP",
    days: "Czwartek / Sobota",
    desc: "Zajęcia korekcyjne i wzmacniające dla osób za biurkiem.",
  },
];
---

<section
  id="silownia"
  class="py-16 lg:py-24 bg-zinc-950 border-b border-zinc-900 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Nagłówek -->
    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6"
    >
      <div>
        <div
          class="inline-flex items-center gap-2 text-red-500 font-mono text-xs uppercase tracking-wider mb-2.5 font-semibold"
        >
          Nowa energia • Nowe cele
        </div>
        <h2
          class="font-heading text-3xl sm:text-5xl font-black uppercase tracking-tight text-white"
        >
          Siłownia & <span class="text-red-600">Zajęcia Grupowe</span>
        </h2>
        <p
          class="text-zinc-300 text-sm sm:text-base max-w-xl mt-2 leading-relaxed"
        >
          Strefa maszyn Bodytone, wolne ciężary oraz zróżnicowany grafik zajęć
          fitness, pilatesu i cross-treningu.
        </p>
      </div>
      <a
        href="#grafik"
        class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wide text-red-400 hover:text-red-300 font-bold shrink-0 cursor-pointer"
      >
        Pełny grafik Fitness &rarr;
      </a>
    </div>

    <!-- Wyróżniony baner: Czwartkowy CROSS w cenie karnetu -->
    <div
      class="mb-8 rounded-2xl bg-linear-to-r from-red-950/60 via-zinc-900 to-zinc-900 border border-red-500/30 p-5 sm:p-7 flex flex-col md:flex-row items-start md:items-center justify-between gap-4"
    >
      <div>
        <div
          class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-red-600 text-white font-mono text-[11px] uppercase tracking-wide font-bold mb-2.5"
        >
          Czwartki • 19:00 • Nowa salka
        </div>
        <h3
          class="text-xl sm:text-2xl font-extrabold text-white uppercase tracking-tight"
        >
          Zajęcia CROSS z Rafałem
        </h3>
        <p class="text-zinc-300 text-xs sm:text-sm mt-1.5 leading-relaxed">
          Wydolność, kettlowe obwody i siła. <strong
            class="text-red-400 font-semibold"
            >Zajęcia Cross w czwartki są w cenie każdego karnetu na siłownię!</strong
          >
        </p>
      </div>
    </div>

    <!-- Zajęcia grupowe - 4 czytelne kafelki -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
      {
        groupClasses.map((c) => (
          <div class="bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700 rounded-xl p-5 flex flex-col justify-between transition-colors">
            <div>
              <span class="inline-block text-[11px] font-mono uppercase tracking-wide text-red-400 font-semibold mb-1.5">
                {c.days}
              </span>
              <h4 class="text-white font-bold text-base uppercase tracking-tight mb-2">
                {c.name}
              </h4>
              <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed">
                {c.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Compact CTA Bar to Gym Trainers -->
    <div
      class="rounded-2xl bg-zinc-900/50 border border-zinc-800 p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
    >
      <div class="flex items-center gap-3.5">
        <div
          class="w-10 h-10 rounded-xl bg-red-600/15 border border-red-500/30 flex items-center justify-center text-red-500 shrink-0"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
          >
        </div>
        <div>
          <h4 class="text-white font-bold text-sm sm:text-base">
            Szukasz trenera personalnego lub wsparcia po urazie?
          </h4>
          <p class="text-zinc-300 text-xs sm:text-sm">
            Poznaj Rafała, Wiktorię, Zuzę i Grzegorza w sekcji trenerskiej.
          </p>
        </div>
      </div>
      <a
        href="#kadra"
        class="w-full sm:w-auto text-center px-5 py-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-bold text-xs uppercase tracking-wide border border-zinc-700 transition-all shrink-0 cursor-pointer"
      >
        Poznaj trenerów Siłowni &rarr;
      </a>
    </div>
  </div>
</section>
