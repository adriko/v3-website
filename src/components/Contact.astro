              </svg>
              <span>TikTok</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Mapa dojazdu -->
      <div class="rounded-3xl overflow-hidden border border-v3-border bg-v3-surface min-h-[350px]">
        <iframe
          title="Mapa V3 Centrum Sportowe Jarosław"
          src="https://maps.google.com/maps?q=Poniatowskiego%2024,%20Jaroslaw&t=&z=16&ie=UTF8&iwloc=&output=embed"
          width="100%"
          height="100%"
          style="border:0; min-height: 380px; filter: grayscale(1) invert(0.9) contrast(1.2);"
          allowfullscreen=""
