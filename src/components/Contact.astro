            <!-- TikTok -->
            <a 
              href="https://www.tiktok.com/@v3_klub_jaroslaw" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-v3-surface hover:bg-white/10 border border-v3-border hover:border-zinc-500 text-xs font-bold text-zinc-300 hover:text-white transition-all"
