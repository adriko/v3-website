    title: 'Adres Klubu',
    value: 'ul. Poniatowskiego 24, 37-500 Jarosław',
    href: 'https://maps.app.goo.gl/BUiRAiKCzPZr2aYN9',
  },
  {
    title: 'Telefon / Recepcja',
    value: '788 463 717',
