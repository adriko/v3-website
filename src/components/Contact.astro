---

<section id="kontakt" class="py-16 sm:py-24 bg-v3-dark border-t border-v3-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14">
      
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-v3-lime/10 border border-v3-lime/30 text-v3-lime text-[11px] font-bold uppercase tracking-widest mb-3">
          Zapraszamy na trening
        </div>
        <h2 class="font-['Rajdhani'] text-4xl sm:text-6xl font-bold uppercase tracking-wide text-white leading-none">
          Skontaktuj się <span class="text-v3-lime">z nami</span>
        </h2>

        <!-- Lista danych kontaktowych z wektorami SVG -->
        <div class="mt-8 space-y-4 sm:space-y-5">
          
          <!-- Adres -->
          <a 
            href="https://maps.app.goo.gl/BUiRAiKCzPZr2aYN9" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-start gap-4 p-4 rounded-2xl bg-v3-surface border border-v3-border hover:border-v3-lime/50 transition-all group"
          >
            <div class="w-11 h-11 rounded-xl bg-v3-dark border border-v3-border flex items-center justify-center shrink-0 text-v3-lime group-hover:border-v3-lime/60 group-hover:bg-v3-lime/10 transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <strong class="block text-white text-xs sm:text-sm font-bold uppercase tracking-wide">Adres Klubu</strong>
              <p class="text-xs sm:text-sm text-zinc-400 mt-0.5 group-hover:text-zinc-200 transition-colors">ul. Poniatowskiego 24, 37-500 Jarosław</p>
            </div>
          </a>

          <!-- Telefon -->
          <a 
            href="tel:788463717"
            class="flex items-start gap-4 p-4 rounded-2xl bg-v3-surface border border-v3-border hover:border-v3-lime/50 transition-all group"
          >
            <div class="w-11 h-11 rounded-xl bg-v3-dark border border-v3-border flex items-center justify-center shrink-0 text-v3-lime group-hover:border-v3-lime/60 group-hover:bg-v3-lime/10 transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <strong class="block text-white text-xs sm:text-sm font-bold uppercase tracking-wide">Telefon / Recepcja</strong>
              <span class="text-xs sm:text-sm text-v3-lime font-bold mt-0.5 block font-mono">788 463 717</span>
            </div>
          </a>

          <!-- Godziny otwarcia -->
          <div class="flex items-start gap-4 p-4 rounded-2xl bg-v3-surface border border-v3-border">
            <div class="w-11 h-11 rounded-xl bg-v3-dark border border-v3-border flex items-center justify-center shrink-0 text-v3-lime">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <strong class="block text-white text-xs sm:text-sm font-bold uppercase tracking-wide">Godziny Otwarcia</strong>
