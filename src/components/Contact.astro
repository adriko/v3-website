---
const googleMapsUrl = "https://maps.app.goo.gl/BUiRAiKCzPZr2aYN9";
---

<section id="kontakt" class="relative overflow-hidden py-16 sm:py-24 bg-v3-dark border-t border-v3-border ambient-glow-lime">
  <!-- Dyskretna poświata limonkowa w tle -->
  <div class="pointer-events-none absolute -top-24 right-10 h-[450px] w-[450px] rounded-full bg-v3-lime/[0.04] blur-[140px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <!-- Siatka 7:5 z wyśrodkowaniem w pionie -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Lewa kolumna: Dane kontaktowe (7/12 szerokości) -->
      <div class="lg:col-span-7 flex flex-col justify-between">
        <div>
          <!-- Pigułka wprowadzająca -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-v3-lime/10 border border-v3-lime/30 text-v3-lime text-[11px] font-bold uppercase tracking-widest mb-3">
            Zapraszamy na trening
          </div>

          <!-- Nagłówek H2 -->
          <h2 class="font-['Rajdhani'] text-4xl sm:text-6xl font-bold uppercase tracking-wide text-white leading-none">
            Skontaktuj się <span class="text-v3-lime whitespace-nowrap">z nami</span>
          </h2>

          <!-- Lista 3 zunifikowanych kart informacyjnych -->
          <div class="mt-8 space-y-4">
            
            <!-- 1. Adres Klubu -->
            <a 
              href={googleMapsUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-start gap-4 p-4 sm:p-5 rounded-2xl bg-v3-surface border border-v3-border hover:border-v3-lime/50 transition-all duration-300 group shadow-md"
            >
              <div class="w-12 h-12 rounded-xl bg-v3-card border border-v3-border flex items-center justify-center shrink-0 text-v3-lime group-hover:border-v3-lime/60 group-hover:bg-v3-lime/10 transition-colors">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="flex-1">
                <span class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Adres Klubu</span>
                <p class="text-sm sm:text-base font-semibold text-white mt-1 group-hover:text-v3-lime transition-colors">
                  ul. Poniatowskiego 24, 37-500 Jarosław
                </p>
                <span class="inline-flex items-center gap-1 text-[11px] font-medium text-zinc-400 mt-1 group-hover:text-zinc-300">
                  Nawiguj z Google Maps &rarr;
                </span>
              </div>
            </a>

            <!-- 2. Telefon / Recepcja -->
            <a 
              href="tel:788463717"
              class="flex items-start gap-4 p-4 sm:p-5 rounded-2xl bg-v3-surface border border-v3-border hover:border-v3-lime/50 transition-all duration-300 group shadow-md"
            >
              <div class="w-12 h-12 rounded-xl bg-v3-card border border-v3-border flex items-center justify-center shrink-0 text-v3-lime group-hover:border-v3-lime/60 group-hover:bg-v3-lime/10 transition-colors">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div class="flex-1">
                <span class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Telefon / Recepcja</span>
                <span class="block text-xl sm:text-2xl font-bold font-['Rajdhani'] text-white tracking-wider mt-0.5 group-hover:text-v3-lime transition-colors">
                  788 463 717
                </span>
                <span class="inline-flex items-center gap-1 text-[11px] font-medium text-zinc-400 mt-0.5 group-hover:text-zinc-300">
                  Kliknij, aby zadzwonić &rarr;
                </span>
              </div>
            </a>

            <!-- 3. Godziny Otwarcia -->
            <div class="flex items-start gap-4 p-4 sm:p-5 rounded-2xl bg-v3-surface border border-v3-border shadow-md">
              <div class="w-12 h-12 rounded-xl bg-v3-card border border-v3-border flex items-center justify-center shrink-0 text-v3-lime">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="flex-1">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Godziny Otwarcia</span>
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-v3-lime/10 border border-v3-lime/30 text-v3-lime text-[10px] font-bold uppercase tracking-wider">
                    <span class="w-1.5 h-1.5 rounded-full bg-v3-lime animate-pulse"></span>
                    Kod QR w aplikacji
                  </span>
                </div>

                <!-- Tabela godzinowa -->
                <div class="mt-3 space-y-1.5 text-xs sm:text-sm">
                  <div class="flex items-center justify-between py-1 border-b border-white/5">
                    <span class="text-zinc-300 font-medium">Poniedziałek – Piątek</span>
                    <span class="font-mono font-bold text-white tracking-tight">05:00 – 24:00</span>
                  </div>
                  <div class="flex items-center justify-between py-1 border-b border-white/5">
                    <span class="text-zinc-300 font-medium">Sobota</span>
                    <span class="font-mono font-bold text-white tracking-tight">06:00 – 23:00</span>
                  </div>
                  <div class="flex items-center justify-between py-1">
                    <span class="text-zinc-300 font-medium">Niedziela</span>
                    <span class="font-mono font-bold text-white tracking-tight">08:00 – 22:00</span>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Przyciski społecznościowe -->
        <div class="mt-8 pt-6 border-t border-v3-border">
          <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-zinc-400 block mb-3">
            Obserwuj nas w sieci:
          </span>
          <div class="flex flex-wrap gap-2.5">
            <!-- Facebook -->
            <a 
              href="https://www.facebook.com/V3CentrumSportowe/" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-v3-surface hover:bg-[#1877F2]/10 border border-v3-border hover:border-[#1877F2]/60 text-xs font-bold text-zinc-300 hover:text-white transition-all shadow-sm"
            >
              <svg class="w-4 h-4 text-[#1877F2]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span>Facebook</span>
            </a>

            <!-- Instagram -->
            <a 
              href="https://www.instagram.com/v3_klub_jaroslaw/" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-v3-surface hover:bg-[#E4405F]/10 border border-v3-border hover:border-[#E4405F]/60 text-xs font-bold text-zinc-300 hover:text-white transition-all shadow-sm"
            >
              <svg class="w-4 h-4 text-[#E4405F]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Instagram</span>
            </a>

            <!-- TikTok -->
            <a 
              href="https://www.tiktok.com/@v3_klub_jaroslaw" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-v3-surface hover:bg-white/10 border border-v3-border hover:border-zinc-500 text-xs font-bold text-zinc-300 hover:text-white transition-all shadow-sm"
            >
              <svg class="w-4 h-4 text-[#25F4EE]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.86 4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-.04-4.52z"/>
              </svg>
              <span>TikTok</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Prawa kolumna: Zgrabniejsza mapa (5/12 szerokości) -->
      <div class="lg:col-span-5 flex justify-center w-full">
        <div class="w-full h-[360px] sm:h-[420px] lg:h-[480px] rounded-3xl overflow-hidden border border-v3-border bg-v3-surface shadow-xl">
          <iframe
            title="Mapa V3 Centrum Sportowe Jarosław"
            src="https://maps.google.com/maps?q=Poniatowskiego%2024,%20Jaroslaw&t=&z=16&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="100%"
            style="border:0; width: 100%; height: 100%; filter: grayscale(1) invert(0.9) contrast(1.2);"
            allowfullscreen=""
            loading="lazy"
          ></iframe>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Stopka ze spójnym grafitowym tłem -->
<footer class="py-12 bg-v3-dark border-t border-v3-border text-center">
  <div class="max-w-7xl mx-auto px-4 flex flex-col items-center">
    
    <!-- Logo w stopce -->
    <div class="inline-flex items-center gap-2.5 mb-4 select-none">
      <svg viewBox="0 0 120 100" class="w-8 h-7 fill-current text-v3-lime">
        <path d="M42 12 H106 L63.3 86 H46 L39.7 75 H56.5 L86.5 23 H48.3 L42 12 Z" />
        <path d="M14 25 H26.7 L32.5 35 H74.5 L68.2 46 H38.8 L44.6 56 H62.5 L56.2 67 H38.2 L14 25 Z" />
      </svg>
      <span class="font-['Rajdhani'] text-2xl font-bold uppercase tracking-wider text-white">
        V3 <span class="text-v3-lime">KLUB</span>
      </span>
    </div>

    <p class="text-xs text-zinc-500">
      Centrum Sportowe V3 • Jarosław, ul. Poniatowskiego 24
    </p>
    <p class="text-[11px] text-zinc-600 mt-2">
      © 2026 V3 Klub Jarosław • Wszelkie prawa zastrzeżone.
    </p>
  </div>
</footer>