---
import { TRAINERS, type Trainer } from '../data/trainers';

interface Props {
  zone: 'fight' | 'gym';
  title?: string;
  subtitle?: string;
}

const {
  zone,
  title = 'Poznaj Nasz Team',
  subtitle = 'Wykwalifikowani instruktorzy i trenerzy z wieloletnim doświadczeniem'
} = Astro.props;

// Funkcja pomocnicza do pobierania nazwiska (ostatniego członu imienia i nazwiska)
const getLastName = (fullName: string) => {
  const parts = fullName.trim().split(/\s+/);
  return parts[parts.length - 1] || '';
};

// Filtrowanie i automatyczne sortowanie alfabetyczne po nazwisku z polskimi znakami
const trainers: Trainer[] = TRAINERS
  .filter((t: Trainer) => t.zone === zone)
  .sort((a: Trainer, b: Trainer) =>
    getLastName(a.name).localeCompare(getLastName(b.name), 'pl')
  );

const isFight = zone === 'fight';
const accentText = isFight ? 'text-v3-red' : 'text-v3-lime';
const badgeStyle = isFight
  ? 'border-v3-red/40 bg-v3-red/10 text-v3-red'
  : 'border-v3-lime/40 bg-v3-lime/10 text-v3-lime';
const hoverBorder = isFight ? 'hover:border-v3-red/50' : 'hover:border-v3-lime/50';
const avatarStyle = isFight
  ? 'border-v3-red/40 bg-v3-red/10 text-v3-red'
  : 'border-v3-lime/40 bg-v3-lime/10 text-v3-lime';
---

<div class="mt-14 sm:mt-20 relative">
  <!-- Górny nagłówek strefy trenerskiej -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6 sm:mb-8 px-1">
    <div>
      <div class={`inline-flex items-center gap-2 text-[10px] sm:text-xs font-bold uppercase tracking-widest px-2.5 py-0.5 rounded border ${badgeStyle} mb-2`}>
        <span>&gt;&gt;&gt;</span>
        <span>{isFight ? 'Fight Zone Kadra Trenerska' : 'Instruktorzy Siłowni & Fitness'}</span>
      </div>
      <h3 class="font-['Teko'] text-3xl sm:text-5xl font-bold uppercase tracking-wide text-white leading-none">
        {title} <span class={accentText}>V3</span>
      </h3>
      <p class="text-xs sm:text-sm text-zinc-300 mt-1 max-w-xl">
        {subtitle}
      </p>
    </div>

    <!-- Przyciski nawigacyjne (widoczne od tabletów w górę; na mobile gest swipe) -->
    <div class="hidden sm:flex items-center gap-2">
      <button
        type="button"
        data-slider-prev={zone}
        aria-label="Poprzedni trener"
        class="w-10 h-10 rounded-xl border border-v3-border bg-v3-surface hover:bg-v3-card flex items-center justify-center text-zinc-300 hover:text-white transition active:scale-95 cursor-pointer shadow-md"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        type="button"
        data-slider-next={zone}
        aria-label="Następny trener"
        class="w-10 h-10 rounded-xl border border-v3-border bg-v3-surface hover:bg-v3-card flex items-center justify-center text-zinc-300 hover:text-white transition active:scale-95 cursor-pointer shadow-md"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Kontener z miękkim zanikaniem krawędzi (Peek & Gradient Blur) -->
  <div class="relative -mx-4 px-4 sm:mx-0 sm:px-0">
    <!-- Dyskretny gradient po prawej stronie na mobile sygnalizujący zawartość do przewinięcia -->
    <div class="pointer-events-none absolute right-0 top-0 bottom-6 w-10 sm:w-16 bg-linear-to-l from-v3-dark to-transparent z-10 sm:hidden"></div>

    <!-- Horyzontalna lista z równą wysokością kart (items-stretch) -->
    <div
      data-trainer-slider={zone}
      class="flex items-stretch gap-4 sm:gap-6 overflow-x-auto pb-6 pt-1 snap-x snap-mandatory scroll-smooth touch-pan-x [-ms-overflow-style:none] scrollbar-none [&::-webkit-scrollbar]:hidden"
    >
      {trainers.map((t: Trainer) => {
        const initials = t.name.split(' ').map((n: string) => n[0]).join('');
        return (
          <div
            class={`shrink-0 w-[82vw] max-w-85 sm:w-90 snap-center rounded-2xl sm:rounded-3xl border border-v3-border bg-v3-surface/85 backdrop-blur-md p-5 sm:p-6 flex flex-col justify-between transition-all duration-300 ${hoverBorder} hover:shadow-xl shadow-md group`}
          >
            <div>
              <!-- Okno zdjęcia / Awatar zastępczy -->
              <div class="relative w-full h-56 sm:h-64 rounded-xl sm:rounded-2xl overflow-hidden border border-white/5 bg-v3-card mb-4 flex items-center justify-center">
                {t.image ? (
                  <img
                    src={t.image}
                    alt={t.name}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover object-top transition duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div class="w-full h-full flex flex-col items-center justify-center bg-linear-to-b from-v3-card via-v3-surface to-v3-dark text-center p-4 relative">
                    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-size-[16px_16px]"></div>
                    <div class={`w-20 h-20 rounded-full border-2 ${avatarStyle} flex items-center justify-center font-['Teko'] text-3xl font-bold tracking-wider mb-2 shadow-inner z-10`}>
                      {initials}
                    </div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-300 z-10">
                      Zdjęcie w przygotowaniu
                    </span>
                    <span class="text-[10px] text-zinc-400 mt-0.5 z-10 font-mono">Centrum Sportowe V3</span>
                  </div>
                )}

                <div class="absolute inset-0 bg-linear-to-t from-v3-dark via-transparent to-transparent pointer-events-none"></div>

                {t.leadsClasses && (
                  <div class="absolute bottom-2.5 left-2.5 right-2.5 text-[10px] sm:text-[11px] font-bold uppercase tracking-wider px-2.5 py-1.5 rounded-lg bg-v3-dark/95 backdrop-blur-md text-white border border-white/10 leading-tight">
                    <span class="mr-1">🎯</span>{t.leadsClasses}
                  </div>
                )}
              </div>

              <!-- Dane trenera -->
              <div>
                <h4 class="font-['Teko'] text-2xl sm:text-3xl font-bold uppercase tracking-wide text-white leading-none">
                  {t.name}
                </h4>
                <p class={`text-xs sm:text-sm font-semibold ${accentText} mt-1 leading-snug`}>
                  {t.role}
                </p>
              </div>

              <!-- Pigułki specjalizacji -->
              <div class="flex flex-wrap gap-1.5 mt-3">
                {t.tags.map((tag: string) => (
                  <span class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-v3-card text-zinc-300 border border-white/5">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Pełna biografia (bez ucinania) -->
              <p class="text-xs sm:text-sm text-zinc-300 mt-3.5 leading-relaxed">
                {t.description}
              </p>
            </div>

            <!-- Dolna belka akcji -->
            <div class="mt-6 pt-3.5 border-t border-v3-border">
              {t.specialLink ? (
                <a
                  href={t.specialLink.href}
                  class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 rounded-xl border border-pink-500/40 bg-pink-500/10 text-pink-400 hover:bg-pink-500/20 text-xs font-bold uppercase tracking-wider transition active:scale-[0.98]"
                >
                  <span>{t.specialLink.label}</span>
                </a>
              ) : (
                <div class="flex items-center justify-between text-xs">
                  <span class="text-zinc-400 font-medium text-[11px]">Treningi Personalne</span>
                  <a
                    href="tel:+48788463717"
                    class={`font-bold uppercase tracking-wider ${accentText} hover:underline flex items-center gap-1 text-[11px]`}
                  >
                    Zapytaj w klubie &rarr;
                  </a>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-trainer-slider]').forEach((slider) => {
    const zone = slider.dataset.trainerSlider;
    if (!zone) return;

    const prevBtn = document.querySelector<HTMLButtonElement>(`[data-slider-prev="${zone}"]`);
    const nextBtn = document.querySelector<HTMLButtonElement>(`[data-slider-next="${zone}"]`);

    if (prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        slider.scrollBy({ left: -340, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        slider.scrollBy({ left: 340, behavior: 'smooth' });
      });
    }
  });
</script>
