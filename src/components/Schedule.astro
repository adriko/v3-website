---

<section id="grafik" class="relative border-b border-white/10 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <!-- Górny nagłówek i przełącznik stref -->
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-v3-lime">
          <span class="h-2 w-2 rounded-full bg-v3-lime animate-pulse"></span>
          Aktualny grafik obowiązuje od września 2026
        </div>
        <h2 class="mt-2 font-['Teko'] text-4xl font-bold uppercase leading-[0.95] text-white sm:text-6xl">
          Grafik <span id="schedule-title-accent" class="text-v3-red">Zajęć</span>
        </h2>
        <p class="mt-2 text-sm text-zinc-300 sm:text-base">
          Zapisuj się na zajęcia bezpośrednio w aplikacji klubowej GymManager.
        </p>
      </div>

      <!-- Przełącznik stref grafikowych -->
      <div class="inline-flex items-center rounded-2xl border border-white/15 bg-zinc-900 p-1.5 self-start md:self-auto shadow-md">
        <button
          type="button"
          id="tab-fight-zone"
          class="cursor-pointer rounded-xl bg-v3-red px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-lg transition"
        >
          Fight Zone
        </button>
        <button
          type="button"
          id="tab-fitness"
          class="cursor-pointer rounded-xl px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-zinc-300 transition hover:text-white"
        >
          Fitness &amp; Wellness
        </button>
      </div>
    </div>

    <!-- Siatka 1: FIGHT ZONE (grid na smartfonie, tablecie i PC) -->
    <div id="grid-fight-zone" class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {fightDays.map((item) => (
        <div class="flex flex-col justify-between rounded-2xl border border-white/10 bg-zinc-900/60 p-5 sm:p-6 transition hover:border-v3-red/40">
          <div>
            <div class="flex items-baseline justify-between border-b border-white/10 pb-4">
              <h3 class="font-['Teko'] text-3xl font-bold uppercase tracking-wide text-white">
                {item.day}
              </h3>
              <span class="rounded-md bg-v3-red/15 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-v3-red">
                {item.count}
              </span>
            </div>

            <div class="mt-4 divide-y divide-white/5">
              {item.classes.map((c) => (
                <div class="py-3 first:pt-0 last:pb-0">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-mono text-xs font-bold tracking-tight text-v3-red sm:text-sm">
                      {c.time}
                    </span>
                    <span class={`rounded-md border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ${c.badgeColor}`}>
                      {c.badge}
                    </span>
                  </div>
                  <p class="mt-1 text-sm font-semibold text-white sm:text-base">
                    {c.name}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Siatka 2: FITNESS & WELLNESS (Z zachowaną klasą grid przy ukryciu/pokazaniu) -->
    <div id="grid-fitness" class="mt-12 hidden grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {fitnessDays.map((item) => (
        <div class="flex flex-col justify-between rounded-2xl border border-white/10 bg-zinc-900/60 p-5 sm:p-6 transition hover:border-v3-lime/40">
          <div>
            <div class="flex items-baseline justify-between border-b border-white/10 pb-4">
              <h3 class="font-['Teko'] text-3xl font-bold uppercase tracking-wide text-white">
                {item.day}
              </h3>
              <span class="rounded-md bg-v3-lime/15 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-v3-lime">
                {item.count}
              </span>
            </div>

            <div class="mt-4 divide-y divide-white/5">
              {item.classes.map((c) => (
                <div class="py-3 first:pt-0 last:pb-0">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-mono text-xs font-bold tracking-tight text-v3-lime sm:text-sm">
                      {c.time}
                    </span>
                    <span class={`rounded-md border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ${c.badgeColor}`}>
                      {c.badge}
                    </span>
                  </div>
                  <p class="mt-1 text-sm font-semibold text-white sm:text-base">
                    {c.name}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Dolna belka informacyjna -->
    <div class="mt-10 flex flex-col items-center justify-between gap-3 rounded-2xl border border-white/10 bg-zinc-900/40 px-6 py-4 text-xs font-medium text-zinc-300 sm:flex-row">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-v3-lime"></span>
        <span>Rezerwacja miejsc na zajęcia w aplikacji: <strong class="text-white">v3klub.gymmanager.io</strong></span>
      </div>
      <a href="tel:+48788463717" class="font-bold text-v3-lime transition hover:underline">
        PYTANIA? ZADZWOŃ: 788 463 717 →
      </a>
    </div>
  </div>
</section>

<script>
  const tabFight = document.getElementById('tab-fight-zone');
  const tabFitness = document.getElementById('tab-fitness');
  const gridFight = document.getElementById('grid-fight-zone');
  const gridFitness = document.getElementById('grid-fitness');
  const titleAccent = document.getElementById('schedule-title-accent');

  function setScheduleTab(tab: 'fight' | 'fitness') {
    if (!tabFight || !tabFitness || !gridFight || !gridFitness || !titleAccent) return;

    if (tab === 'fight') {
      tabFight.className =
        'cursor-pointer rounded-xl bg-v3-red px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-lg transition';
      tabFitness.className =
        'cursor-pointer rounded-xl px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-zinc-300 transition hover:text-white';
      gridFight.classList.remove('hidden');
      gridFitness.classList.add('hidden');
      titleAccent.className = 'text-v3-red';
    } else {
      tabFitness.className =
        'cursor-pointer rounded-xl bg-v3-lime px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-black shadow-lg transition';
      tabFight.className =
        'cursor-pointer rounded-xl px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-zinc-300 transition hover:text-white';
      gridFitness.classList.remove('hidden');
      gridFight.classList.add('hidden');
      titleAccent.className = 'text-v3-lime';
    }
  }

  tabFight?.addEventListener('click', () => setScheduleTab('fight'));
  tabFitness?.addEventListener('click', () => setScheduleTab('fitness'));
</script>