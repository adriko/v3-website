<script>
  const btnFight = document.getElementById('btn-fight');
  const btnFitness = document.getElementById('btn-fitness');
  const tabFight = document.getElementById('tab-fight');
  const tabFitness = document.getElementById('tab-fitness');

  if (btnFight && btnFitness && tabFight && tabFitness) {
    btnFight.addEventListener('click', () => {
      tabFight.classList.remove('hidden');
      tabFight.classList.add('grid');
      tabFitness.classList.add('hidden');
      tabFitness.classList.remove('grid');

      btnFight.className = 'px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all bg-v3-red text-white';
      btnFitness.className = 'px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all text-zinc-400 hover:text-white';
    });

    btnFitness.addEventListener('click', () => {
      tabFitness.classList.remove('hidden');
      tabFitness.classList.add('grid');
      tabFight.classList.add('hidden');
      tabFight.classList.remove('grid');

      btnFitness.className = 'px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all bg-v3-lime text-black';
      btnFight.className = 'px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all text-zinc-400 hover:text-white';
    });
  }
</script>