---

<section id="grafik" class="py-16 sm:py-24 bg-v3-surface border-b border-v3-border relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Nagłówek i przełącznik zakładek -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 sm:mb-12">
      <div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-v3-lime/10 border border-v3-lime/40 text-v3-lime text-[11px] sm:text-xs font-black uppercase tracking-wider mb-3 shadow-[0_0_15px_rgba(200,255,0,0.15)]">
          <span class="w-2 h-2 rounded-full bg-v3-lime animate-pulse"></span>
          Aktualny grafik obowiązuje od września 2026
        </div>
        <h2 class="font-['Teko'] text-4xl sm:text-6xl font-bold uppercase tracking-wide text-white leading-none">
          Grafik <span class="text-v3-lime">Zajęć</span>
        </h2>
        <p class="text-zinc-400 text-xs sm:text-sm mt-2 max-w-lg">
          Zapisuj się na zajęcia bezpośrednio w aplikacji klubowej GymManager.
        </p>
      </div>

      <!-- Przełącznik Fight Zone / Fitness -->
      <div class="inline-flex p-1.5 bg-v3-dark rounded-2xl border border-v3-border self-start md:self-auto">
        <button 
          id="btn-fight" 
          type="button"
          class="px-5 sm:px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all bg-v3-red text-white shadow-[0_0_15px_rgba(255,42,42,0.3)]"
        >
          Fight Zone
        </button>
        <button 
          id="btn-fitness" 
          type="button"
          class="px-5 sm:px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all text-zinc-400 hover:text-white"
        >
          Fitness & Wellness
        </button>
      </div>
    </div>

    <!-- 1. Tabela Fight Zone -->
    <div id="tab-fight" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4 lg:gap-5">
      {fightDays.map((d) => (
        <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-b from-[#180a0c] via-v3-dark to-v3-dark border-t-2 border-t-v3-red border-x border-b border-v3-border flex flex-col justify-between shadow-md">
          <div>
            <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-v3-border/70">
              <span class="font-['Teko'] text-2xl sm:text-3xl font-bold uppercase text-white tracking-wider">
                {d.day}
              </span>
              <span class="text-[10px] font-mono font-bold text-v3-red uppercase px-2 py-0.5 rounded bg-v3-red/10 border border-v3-red/25">
                {d.classes.length} {d.classes.length === 1 ? 'trening' : 'treningi'}
              </span>
            </div>

            <div class="space-y-2">
              {d.classes.map((c) => (
                <div class="p-2.5 rounded-xl bg-v3-surface/60 hover:bg-v3-surface border border-white/5 transition-colors">
                  <div class="flex items-center justify-between gap-2 mb-1">
                    <span class="font-mono text-[11px] font-bold text-v3-red tabular-nums">
                      {c.time}
                    </span>
                    <span class={`text-[9px] font-mono font-bold uppercase px-1.5 py-0.5 rounded border shrink-0 ${c.badgeColor}`}>
                      {c.badge}
                    </span>
                  </div>
                  <span class="block text-xs sm:text-[13px] font-bold text-white leading-snug">
                    {c.name}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- 2. Tabela Fitness (domyślnie ukryta) -->
    <div id="tab-fitness" class="hidden grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4 lg:gap-5">
      {fitnessDays.map((d) => (
        <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-b from-[#14141d] via-v3-dark to-v3-dark border-t-2 border-t-v3-lime border-x border-b border-v3-border flex flex-col justify-between shadow-md">
          <div>
            <div class="flex items-center justify-between pb-2.5 mb-3 border-b border-v3-border/70">
              <span class="font-['Teko'] text-2xl sm:text-3xl font-bold uppercase text-white tracking-wider">
                {d.day}
              </span>
              <span class="text-[10px] font-mono font-bold text-v3-lime uppercase px-2 py-0.5 rounded bg-v3-lime/10 border border-v3-lime/25">
                {d.classes.length} {d.classes.length === 1 ? 'zajęcia' : 'zajęć'}
              </span>
            </div>

            <div class="space-y-2">
              {d.classes.map((c) => (
                <div class="p-2.5 rounded-xl bg-v3-surface/60 hover:bg-v3-surface border border-white/5 transition-colors">
                  <div class="flex items-center justify-between gap-2 mb-1">
                    <span class="font-mono text-[11px] font-bold text-v3-lime tabular-nums">
                      Godz. {c.time}
                    </span>
                    <span class={`text-[9px] font-mono font-bold uppercase px-1.5 py-0.5 rounded border shrink-0 ${c.badgeColor}`}>
                      {c.badge}
                    </span>
                  </div>
                  <span class="block text-xs sm:text-[13px] font-bold text-white leading-snug">
                    {c.name}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Pasek informacyjny pod grafikiem -->
    <div class="mt-8 p-3.5 sm:p-4 rounded-2xl bg-v3-dark border border-v3-border flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-zinc-400">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-v3-lime animate-pulse"></span>
        <span>Rezerwacja miejsc na zajęcia w aplikacji: <strong class="text-white">v3klub.gymmanager.io</strong></span>
      </div>
      <a 
        href="tel:788463717"
        class="text-v3-lime font-bold uppercase tracking-wider hover:underline"
      >
        Pytania? Zadzwoń: 788 463 717 &rarr;
      </a>
    </div>

  </div>
</section>

<script>
  const btnFight = document.getElementById('btn-fight');
  const btnFitness = document.getElementById('btn-fitness');
  const tabFight = document.getElementById('tab-fight');
  const tabFitness = document.getElementById('tab-fitness');

  if (btnFight && btnFitness && tabFight && tabFitness) {
    btnFight.addEventListener('click', () => {
      tabFight.classList.remove('hidden');
      tabFight.classList.add('grid');
      tabFitness.classList.add('hidden');
      tabFitness.classList.remove('grid');

      btnFight.className = 'px-5 sm:px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all bg-v3-red text-white shadow-[0_0_15px_rgba(255,42,42,0.3)]';
      btnFitness.className = 'px-5 sm:px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all text-zinc-400 hover:text-white';
    });

    btnFitness.addEventListener('click', () => {
      tabFitness.classList.remove('hidden');
      tabFitness.classList.add('grid');
      tabFight.classList.add('hidden');
      tabFight.classList.remove('grid');

      btnFitness.className = 'px-5 sm:px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all bg-v3-lime text-black shadow-[0_0_15px_rgba(200,255,0,0.3)]';
      btnFight.className = 'px-5 sm:px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all text-zinc-400 hover:text-white';
    });
  }
</script>