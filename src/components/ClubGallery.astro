---
const photos = [
  {
    src: "/images/v3-gym-brick.jpeg",
    alt: "Strefa siłowa i bieżnie na tle ceglanej ściany z logo V3 Klub",
    label: "Strefa Siłowa & Cardio",
    desc: "Dwa piętra sprzętu Bodytone, wolne ciężary i industrialny klimat",
    span: "md:col-span-8",
  },
  {
    src: "/images/women-zone.jpg",
    alt: "Dedykowana różowa Strefa Kobiet w V3 Klub Jarosław",
    label: "Pink Zone • Strefa Kobiet",
    desc: "Zamknięta sala wyłącznie dla pań z suwnicą Smitha i lustrem selfie",
    span: "md:col-span-4",
  },
  {
    src: "/images/ring-light.jpg",
    alt: "Pełnowymiarowy ring bokserski i mata w sekcji KSW Sokół & V3",
    label: "Fight Zone & Ring Bokserski",
    desc: "Dom sekcji KSW Sokół Jarosław – boks, kickboxing, MMA i grappling",
    span: "md:col-span-6",
  },
  {
    src: "/images/gym-overview.jpg",
    alt: "Przestronna strefa maszyn i treningu funkcjonalnego w V3 Klub",
    label: "Przestrzeń Treningowa",
    desc: "Ergonomiczne maszyny izotoniczne, klatki rack i strefa cross",
    span: "md:col-span-6",
  },
];
---

<section
  id="galeria"
  class="py-16 lg:py-24 bg-zinc-950 border-b border-zinc-900 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4"
    >
      <div>
        <div
          class="inline-flex items-center gap-2 text-red-500 font-mono text-xs uppercase tracking-wider mb-2.5 font-semibold"
        >
          <span>&gt;&gt;&gt;</span> WNĘTRZE KLUBU
        </div>
        <h2
          class="font-heading text-3xl sm:text-5xl font-black uppercase tracking-tight text-white"
        >
          Zobacz <span class="text-red-600">V3 Klub</span> od środka
        </h2>
      </div>
      <p class="text-zinc-300 text-sm sm:text-base max-w-md">
        Industrialny styl, profesjonalne oświetlenie i ponadprzeciętna czystość
        na dwóch kondygnacjach przy ul. Poniatowskiego 24.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6">
      {
        photos.map((photo) => (
          <div
            class:list={[
              "group relative rounded-2xl overflow-hidden border border-zinc-800/90 bg-zinc-900 h-65 sm:h-85",
              photo.span,
            ]}
          >
            <img
              src={photo.src}
              alt={photo.alt}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-linear-to-t from-zinc-950 via-zinc-950/25 to-transparent" />
            <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-zinc-950/85 backdrop-blur-md border border-zinc-800/80">
              <span class="text-[11px] font-mono uppercase tracking-wide text-red-400 block font-bold mb-0.5">
                {photo.label}
              </span>
              <p class="text-zinc-200 text-xs sm:text-sm font-medium">
                {photo.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
