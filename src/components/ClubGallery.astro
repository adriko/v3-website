---
const googleMapsUrl = "https://maps.app.goo.gl/BUiRAiKCzPZr2aYN9";

const galleryImages = [
  {
    src: "/images/v3-gym-brick.jpeg",
    title: "Strefa Cardio & Ceglana Ściana z Logo V3",
    tag: "Park Maszyn",
    cropWhiteBorders: false,
  },
  {
    src: "/images/boks2.jpg",
    title: "Profesjonalny Ring Bokserski & Sprzęt Sparingowy",
    tag: "Fight Zone",
    cropWhiteBorders: false,
  },
  {
    src: "/images/women-zone.jpg",
    title: "Prywatna Różowa Strefa wyłącznie dla Kobiet",
    tag: "Women Zone",
    cropWhiteBorders: false,
  },
  {
    src: "/images/silownia2.jpg",
    title: "Strefa Maszyn Izolowanych Bodytone & Mural",
    tag: "Siłownia",
    cropWhiteBorders: false,
  },
  {
    src: "/images/silownia3.jpg",
    title: "Strefa Wolnych Ciężarów, Hantle i Sztangi",
    tag: "Ciężary",
    cropWhiteBorders: false,
  },
  {
    src: "/images/fight1.png",
    title: "Główna Mata Sportów Walki & Strefa Worków",
    tag: "Sala Walk",
    cropWhiteBorders: true,
  },
  {
    src: "/images/recepcja1.png",
    title: "Recepcja Klubu, Strefa Chillout & Odżywki",
    tag: "Recepcja V3",
    cropWhiteBorders: true,
  },
];
---

<section
  id="galeria"
  class="py-16 sm:py-20 bg-v3-dark border-b border-white/10 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 sm:mb-10">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-v3-lime/10 border border-v3-lime/30 text-v3-lime text-xs font-bold uppercase tracking-wider mb-3">
          <span>Zdjęcia z Klubu • Google Maps</span>
        </div>

        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold uppercase tracking-tight text-white leading-none">
          Zobacz V3 <span class="text-v3-lime">od środka</span>
        </h2>
      </div>

      <a
        href={googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-zinc-300 hover:text-white px-4 py-2.5 rounded-xl bg-v3-surface hover:bg-zinc-800 border border-white/10 hover:border-v3-lime/50 transition-all self-start md:self-auto"
      >
        <span>Więcej zdjęć na Google Maps</span>
        <svg
          class="h-3.5 w-3.5 text-v3-lime transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M7 17L17 7M7 7h10v10"
          />
        </svg>
      </a>
    </div>

    <div
      id="gallery-slider-container"
      class="relative w-full h-75 sm:h-115 md:h-135 rounded-2xl sm:rounded-3xl overflow-hidden border border-white/10 bg-v3-card shadow-2xl group select-none"
    >
      {galleryImages.map((img, index) => (
        <div
          class={`gallery-slide absolute inset-0 overflow-hidden transition-opacity duration-700 ease-in-out ${index === 0 ? "opacity-100 z-10" : "opacity-0 z-0"}`}
          data-index={index}
        >
          <img
            src={img.src}
            alt={img.title}
            class={`w-full h-full object-cover object-center ${img.cropWhiteBorders ? "scale-[1.85]" : ""}`}
            loading={index === 0 ? "eager" : "lazy"}
          />
          <div class="absolute inset-0 bg-linear-to-t from-v3-dark via-v3-dark/25 to-v3-dark/30"></div>

          <div class="absolute bottom-4 sm:bottom-6 left-4 sm:left-6 right-4 sm:right-6 flex items-end justify-between gap-4 z-20">
            <div>
              <span class="px-2.5 py-0.5 rounded bg-v3-lime text-black font-black text-xs tracking-wider uppercase mb-1.5 inline-block">
                {img.tag}
              </span>
              <h3 class="font-display text-xl sm:text-3xl lg:text-4xl font-extrabold uppercase tracking-tight text-white leading-none">
                {img.title}
              </h3>
            </div>
            <span class="text-xs font-mono text-zinc-300 bg-v3-dark/80 px-2.5 py-1 rounded border border-white/10 shrink-0">
              {index + 1} / {galleryImages.length}
            </span>
          </div>
        </div>
      ))}

      <button
        id="slider-prev"
        type="button"
        aria-label="Poprzednie zdjęcie"
        class="cursor-pointer absolute left-3 top-1/2 -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-v3-dark/70 hover:bg-v3-lime hover:text-black border border-white/20 text-white flex items-center justify-center transition-all opacity-0 group-hover:opacity-100"
      >
        &#10094;
      </button>

      <button
        id="slider-next"
        type="button"
        aria-label="Następne zdjęcie"
        class="cursor-pointer absolute right-3 top-1/2 -translate-y-1/2 z-30 w-10 h-10 rounded-full bg-v3-dark/70 hover:bg-v3-lime hover:text-black border border-white/20 text-white flex items-center justify-center transition-all opacity-0 group-hover:opacity-100"
      >
        &#10095;
      </button>

      <div class="absolute top-3 left-4 right-4 sm:left-6 sm:right-6 z-30 flex gap-1.5 sm:gap-2">
        {galleryImages.map((_, i) => (
          <div class="flex-1 h-1 rounded-full bg-white/20 overflow-hidden">
            <div
              class={`slider-indicator h-full bg-v3-lime transition-all duration-300 ${i === 0 ? "w-full" : "w-0"}`}
              data-indicator={i}
            ></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const slides = document.querySelectorAll<HTMLElement>(".gallery-slide");
  const indicators =
    document.querySelectorAll<HTMLElement>(".slider-indicator");
  const prevBtn = document.getElementById("slider-prev");
  const nextBtn = document.getElementById("slider-next");
  const container = document.getElementById("gallery-slider-container");

  let currentIndex = 0;
  const total = slides.length;
  let timer: ReturnType<typeof setInterval> | null = null;

  function goToSlide(index: number) {
    if (total === 0) return;
    slides[currentIndex].classList.remove("opacity-100", "z-10");
    slides[currentIndex].classList.add("opacity-0", "z-0");
    indicators[currentIndex].classList.remove("w-full");
    indicators[currentIndex].classList.add("w-0");

    currentIndex = (index + total) % total;

    slides[currentIndex].classList.remove("opacity-0", "z-0");
    slides[currentIndex].classList.add("opacity-100", "z-10");
    indicators[currentIndex].classList.remove("w-0");
    indicators[currentIndex].classList.add("w-full");
  }

  function startAutoplay() {
    stopAutoplay();
    timer = setInterval(() => {
      goToSlide(currentIndex + 1);
    }, 3500);
  }

  function stopAutoplay() {
    if (timer) clearInterval(timer);
  }

  nextBtn?.addEventListener("click", () => {
    goToSlide(currentIndex + 1);
    startAutoplay();
  });

  prevBtn?.addEventListener("click", () => {
    goToSlide(currentIndex - 1);
    startAutoplay();
  });

  container?.addEventListener("mouseenter", stopAutoplay);
  container?.addEventListener("mouseleave", startAutoplay);
  container?.addEventListener("touchstart", stopAutoplay, { passive: true });
  container?.addEventListener("touchend", startAutoplay, { passive: true });

  startAutoplay();
</script>
