</section>

<script>
  const btnMonthly = document.getElementById('btn-pricing-monthly');
  const btnLong = document.getElementById('btn-pricing-long');
  const badgeDiscount = document.getElementById('badge-discount');
  const priceValues = document.querySelectorAll<HTMLElement>('.price-value');
  const priceUnits = document.querySelectorAll<HTMLElement>('.price-unit');
  const priceNotes = document.querySelectorAll<HTMLElement>('.price-subnote');

  function setPricingMode(mode: 'monthly' | 'long') {
    if (!btnMonthly || !btnLong || !badgeDiscount) return;

    if (mode === 'monthly') {
      btnMonthly.className =
        'rounded-xl bg-v3-lime px-4 py-2 text-xs font-bold uppercase tracking-wider text-black transition sm:px-5 sm:text-sm';
      btnLong.className =
        'flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-300 transition hover:text-white sm:px-5 sm:text-sm';
      badgeDiscount.className =
        'rounded-md border border-v3-lime/30 bg-v3-lime/15 px-2 py-0.5 text-[10px] font-extrabold text-v3-lime transition-all';
    } else {
      btnLong.className =
        'flex items-center gap-2 rounded-xl bg-v3-lime px-4 py-2 text-xs font-bold uppercase tracking-wider text-black transition sm:px-5 sm:text-sm';
      btnMonthly.className =
        'rounded-xl px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-300 transition hover:text-white sm:px-5 sm:text-sm';
      // Stylowy czarny badge z neonowym napisem na zielonym tle:
      badgeDiscount.className =
        'rounded-md bg-black border border-black/20 px-2 py-0.5 text-[10px] font-extrabold text-v3-lime shadow-sm transition-all';
    }

    priceValues.forEach((el) => {
      const val = mode === 'monthly' ? el.dataset.monthly : el.dataset.long;
      if (val) el.textContent = val;
    });

    priceUnits.forEach((el) => {
      const unit = mode === 'monthly' ? el.dataset.monthlyUnit : el.dataset.longUnit;
      if (unit) el.textContent = unit;
    });

    priceNotes.forEach((el) => {
      const note = mode === 'monthly' ? el.dataset.monthlyNote : el.dataset.longNote;
      if (note) el.textContent = note;
    });
  }

  btnMonthly?.addEventListener('click', () => setPricingMode('monthly'));
  btnLong?.addEventListener('click', () => setPricingMode('long'));
</script>