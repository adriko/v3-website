---
const mainPasses = [
  {
    name: "LIMIT",
    subtitle: "8 wejść w miesiącu",
    price: "145",
    period: "30 dni",
    badge: "Na start",
    highlight: false,
    features: [
      "8 wejść w skali miesiąca",
      "Siłownia + Strefa Cardio (5:00 – 24:00)",
      "Dostęp do Strefy Kobiet (dla Pań)",
      "Zajęcia grupowe Fitness wg grafiku",
      "Czwartkowy trening CROSS w cenie",
    ],
  },
  {
    name: "ACTIVE",
    subtitle: "Dostęp bez limitu (Open)",
    price: "160",
    period: "30 dni",
    badge: "Najczęściej wybierany",
    highlight: true,
    features: [
      "Nielimitowane wejścia 7 dni w tygodniu",
      "Pełny dostęp 5:00 – 24:00 na kod QR",
      "Siłownia, Strefa Kobiet oraz zajęcia Fitness",
      "Czwartkowy trening CROSS z Rafałem w cenie",
      "Brak długoterminowej umowy",
    ],
  },
  {
    name: "PRO",
    subtitle: "Karnet 3-miesięczny Open",
    price: "390",
    period: "90 dni (130 zł / mies.)",
    badge: "Oszczędzasz 90 zł",
    highlight: false,
    features: [
      "3 pełne miesiące nielimitowanych treningów",
      "Tylko 130 zł miesięcznie",
      "Siłownia + Strefa Kobiet + Fitness + Cross",
      "Całodobowy dostęp z aplikacją 5:00 – 24:00",
      "Jednorazowa płatność z góry",
    ],
  },
  {
    name: "VIP",
    subtitle: "Karnet 6-miesięczny Open",
    price: "660",
    period: "180 dni (110 zł / mies.)",
    badge: "Najniższa cena / mies.",
    highlight: false,
    features: [
      "Pół roku dostępu Open bez ograniczeń",
      "Rekordowo niska stawka: 110 zł / miesiąc",
      "Oszczędzasz aż 300 zł względem karnetu 30-dniowego",
      "Pełny dostęp do wszystkich stref i zajęć Fitness",
      "Idealny dla osób trenujących regularnie",
    ],
  },
];

const shortPasses = [
  { name: "Wejście jednorazowe (Siłownia / Fitness)", price: "30 zł" },
  { name: "Karnet 7-dniowy Open", price: "60 zł" },
  { name: "Karnet 14-dniowy Open", price: "100 zł" },
  {
    name: "Zajęcia Cross (czwartek 19:00) z karnetem V3",
    price: "0 zł (W cenie)",
  },
];
---

<section
  id="cennik"
  class="py-16 lg:py-24 bg-zinc-950 border-b border-zinc-900 relative"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div
        class="inline-flex items-center gap-2 text-red-500 font-mono text-xs uppercase tracking-wider mb-2.5 font-semibold"
      >
        Przejrzyste zasady • Zero ukrytych opłat
      </div>
      <h2
        class="font-heading text-3xl sm:text-5xl font-black uppercase tracking-tight text-white mb-4"
      >
        Cennik <span class="text-red-600">Karnetów</span>
      </h2>
      <p class="text-zinc-300 text-sm sm:text-base">
        Kup karnet na miejscu w recepcji lub online przez panel klienta i wchodź
        na trening w godzinach <strong class="text-white">5:00 – 24:00</strong>.
      </p>
    </div>

    <!-- 4 Główne Karnety (LIMIT, ACTIVE, PRO, VIP) -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-10 items-stretch"
    >
      {
        mainPasses.map((pass) => (
          <div
            class:list={[
              "rounded-2xl p-6 flex flex-col justify-between relative transition-all",
              pass.highlight
                ? "bg-linear-to-b from-zinc-900 via-zinc-900 to-red-950/25 border-2 border-red-600 shadow-[0_0_35px_rgba(220,38,38,0.18)]"
                : "bg-zinc-900/45 border border-zinc-800/90 hover:border-zinc-700",
            ]}
          >
            {pass.badge && (
              <div
                class:list={[
                  "inline-block self-start px-2.5 py-1 rounded text-[11px] font-mono uppercase tracking-wide font-bold mb-4",
                  pass.highlight
                    ? "bg-red-600 text-white"
                    : "bg-zinc-800 text-zinc-300",
                ]}
              >
                {pass.badge}
              </div>
            )}

            <div>
              <h3 class="font-heading text-2xl font-black uppercase text-white tracking-tight">
                {pass.name}
              </h3>
              <p class="text-xs text-zinc-400 mt-0.5 mb-5">{pass.subtitle}</p>

              <div class="flex items-baseline gap-1.5 pb-5 mb-5 border-b border-zinc-800/80">
                <span class="text-4xl sm:text-5xl font-black text-white font-mono tracking-tight">
                  {pass.price}
                </span>
                <span class="text-base font-bold text-red-500 font-mono">
                  PLN
                </span>
                <span class="text-xs text-zinc-400 font-mono ml-1">
                  / {pass.period}
                </span>
              </div>

              <ul class="space-y-2.5 mb-7 text-xs sm:text-sm text-zinc-200">
                {pass.features.map((feat) => (
                  <li class="flex items-start gap-2.5">
                    <svg
                      class="w-4 h-4 text-red-500 shrink-0 mt-0.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href="https://v3klub.gymmanager.io"
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                "w-full py-3.5 rounded-xl font-bold text-xs uppercase tracking-wide text-center transition-all block cursor-pointer",
                pass.highlight
                  ? "bg-red-600 hover:bg-red-500 text-white shadow-lg"
                  : "bg-zinc-800 hover:bg-zinc-700 text-zinc-100 border border-zinc-700",
              ]}
            >
              Wybierz {pass.name} &rarr;
            </a>
          </div>
        ))
      }
    </div>

    <!-- Sekcja Dolna: Krótkie karnety + Karty Partnerskie & Sporty Walki -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Wejścia jednorazowe i krótkoterminowe (z linią prowadzącą wzrok) -->
      <div
        class="lg:col-span-6 bg-zinc-900/35 border border-zinc-800/90 rounded-2xl p-6"
      >
        <h3
          class="text-lg font-bold uppercase text-white tracking-tight mb-4 flex items-center gap-2"
        >
          <span class="w-2 h-2 rounded-full bg-red-600"></span>
          Wejścia Jednorazowe & Krótkoterminowe
        </h3>
        <div class="space-y-3.5">
          {
            shortPasses.map((sp) => (
              <div class="flex items-baseline justify-between gap-2 text-xs sm:text-sm">
                <span class="text-zinc-200 font-medium shrink-0">
                  {sp.name}
                </span>
                <span class="flex-1 border-b border-dotted border-zinc-800 mx-1" />
                <span class="font-mono font-bold text-white shrink-0">
                  {sp.price}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Honorowane karty sportowe i informacja o sekcji KSW Sokół -->
      <div
        class="lg:col-span-6 bg-zinc-900/35 border border-zinc-800/90 rounded-2xl p-6 flex flex-col justify-between gap-4"
      >
        <div>
          <span
            class="text-[11px] font-mono uppercase tracking-wider text-red-400 font-bold block mb-1"
            >Systemy Benefitowe</span
          >
          <h3
            class="text-lg font-bold uppercase text-white tracking-tight mb-2"
          >
            Honorujemy Karty Partnerskie
          </h3>
          <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed mb-4">
            Trenuj bez dopłat z aktywną kartą sportową. Przy pierwszej wizycie z
            kartą skontaktuj się z recepcją, aby skonfigurować dostęp mobilny.
          </p>
          <div class="flex flex-wrap gap-2">
            <span
              class="px-3 py-1.5 rounded-lg bg-zinc-950 border border-zinc-800 text-zinc-200 font-mono text-xs font-bold"
              >MultiSport</span
            >
            <span
              class="px-3 py-1.5 rounded-lg bg-zinc-950 border border-zinc-800 text-zinc-200 font-mono text-xs font-bold"
              >Medicover Sport</span
            >
            <span
              class="px-3 py-1.5 rounded-lg bg-zinc-950 border border-zinc-800 text-zinc-200 font-mono text-xs font-bold"
              >FitProfit / FitSport</span
            >
            <span
              class="px-3 py-1.5 rounded-lg bg-zinc-950 border border-zinc-800 text-zinc-200 font-mono text-xs font-bold"
              >PZU Sport</span
            >
          </div>
        </div>

        <div
          class="pt-4 border-t border-zinc-800/80 flex items-center justify-between gap-3 text-xs"
        >
          <span class="text-zinc-400"
            >Składki członkowskie sekcji <strong class="text-zinc-200"
              >KSW Sokół (Fight Zone)</strong
            > opłacane są bezpośrednio u trenerów sekcji.</span
          >
          <a
            href="#kontakt"
            class="text-red-400 hover:text-red-300 font-mono font-bold shrink-0"
            >Zapytaj &rarr;</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
