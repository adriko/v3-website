---

---

<section
  id="cennik"
  class="relative overflow-hidden border-b border-v3-border bg-v3-dark py-14 sm:py-16 lg:py-20 ambient-glow-lime"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative">
    <div class="text-center">
      <span class="text-xs font-bold uppercase tracking-wider text-v3-lime"
        >Karnety V3</span
      >
      <h2
        class="mt-2 font-display text-4xl sm:text-5xl lg:text-6xl font-bold uppercase leading-none text-white"
      >
        Cennik Członkostwa
      </h2>
      <p
        class="mx-auto mt-2.5 max-w-xl text-sm sm:text-base text-zinc-300 leading-normal"
      >
        Wybierz elastyczny karnet miesięczny lub oszczędzaj w pakiecie
        półrocznym. Aktywacja konta online w 30 sekund.
      </p>

      <!-- Przełącznik Cennika -->
      <div
        class="mt-7 inline-flex items-center rounded-2xl border border-v3-border bg-v3-surface p-1.5 shadow-lg"
      >
        <button
          type="button"
          id="btn-pricing-monthly"
          class="cursor-pointer rounded-xl bg-v3-lime px-4 py-2 text-xs font-bold uppercase tracking-wider text-black transition sm:px-5 sm:text-sm shadow-md"
        >
          Karnet Miesięczny
        </button>
        <button
          type="button"
          id="btn-pricing-long"
          class="cursor-pointer flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-300 transition hover:text-white sm:px-5 sm:text-sm"
        >
          <span>Pakiet Półroczny</span>
          <span
            id="badge-discount"
            class="rounded-md border border-v3-lime/30 bg-v3-lime/15 px-2 py-0.5 text-[10px] font-extrabold text-v3-lime transition-all"
          >
            -25% TANIEJ
          </span>
        </button>
      </div>
    </div>

    <!-- Karty Cennika -->
    <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
      <!-- 1. V3 LIMIT -->
      <div
        class="flex flex-col justify-between rounded-2xl border border-v3-border bg-v3-surface/70 p-5 sm:p-6 transition duration-300 hover:border-v3-lime/40"
      >
        <div>
          <span
            class="font-display text-2xl sm:text-3xl font-bold uppercase tracking-wide text-white"
            >V3 LIMIT</span
          >
          <p
            id="limit-plan-desc"
            class="mt-1 text-xs font-semibold uppercase tracking-wider text-zinc-400"
          >
            Bez umowy • Wejścia do 12:00
          </p>
          <div class="mt-4 flex items-baseline gap-1">
            <span
              class="font-display text-5xl font-bold leading-none text-white sm:text-6xl"
              >109</span
            >
            <span class="text-sm font-medium text-zinc-300">zł / miesiąc</span>
          </div>
          <p id="limit-subnote" class="mt-1 text-xs font-medium text-v3-lime">
            Stała niska cena bez zobowiązań
          </p>

          <ul
            class="mt-5 space-y-2.5 border-t border-v3-border pt-5 text-xs sm:text-sm text-zinc-200"
          >
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-lime">✓</span><span
                >Wejście do klubu codziennie do godz. 12:00</span
              >
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-lime">✓</span><span
                >Strefa maszyn i wolnych ciężarów</span
              >
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-lime">✓</span><span
                >Bez konieczności wiązania się umową</span
              >
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-lime">✓</span><span
                >Samoobsługowe wejście na kod QR</span
              >
            </li>
          </ul>
        </div>
        <div class="mt-6">
          <a
            href="https://v3klub.gymmanager.io"
            target="_blank"
            rel="noopener noreferrer"
            class="flex w-full items-center justify-center rounded-xl border border-v3-lime/40 bg-v3-card py-3.5 text-xs sm:text-sm font-bold uppercase tracking-wider text-zinc-100 transition-all duration-200 hover:bg-v3-lime hover:text-black hover:border-v3-lime active:scale-[0.98]"
          >
            Kup karnet online →
          </a>
        </div>
      </div>

      <!-- 2. V3 ACTIVE (Bestseller) -->
      <div
        class="relative flex flex-col justify-between rounded-2xl border-2 border-v3-lime bg-v3-surface p-5 sm:p-6"
      >
        <div
          class="absolute -top-3 left-6 rounded-full bg-v3-lime px-3 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-black"
        >
          Najczęściej wybierany
        </div>
        <div>
          <span
            class="font-display text-2xl sm:text-3xl font-bold uppercase tracking-wide text-v3-lime"
            >V3 ACTIVE</span
          >
          <p
            class="plan-period-badge mt-1 text-xs font-semibold uppercase tracking-wider text-zinc-300"
            data-monthly-period="Miesięczny • Bez umowy"
            data-long-period="Pakiet Półroczny • Umowa 6 msc"
          >
            Miesięczny • Bez umowy
          </p>

          <div class="mt-4 flex items-baseline gap-1">
            <span
              class="price-value font-display text-5xl font-bold leading-none text-white sm:text-6xl"
              data-monthly="159"
              data-long="119">159</span
            >
            <span
              class="price-unit text-sm font-medium text-zinc-300"
              data-monthly-unit="zł / miesiąc"
              data-long-unit="zł / msc w pakiecie">zł / miesiąc</span
            >
          </div>

          <p
            class="price-subnote mt-1 text-xs font-medium text-v3-lime"
            data-monthly-note="W pakiecie półrocznym tylko 119 zł / msc"
            data-long-note="Oszczędzasz 240 zł w skali półrocza"
          >
            W pakiecie półrocznym tylko 119 zł / msc
          </p>

          <ul
            class="mt-5 space-y-2.5 border-t border-v3-border pt-5 text-xs sm:text-sm text-zinc-200"
          >
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-lime">✓</span><span
                >Wejście bez ograniczeń godzinowych 5:00–24:00</span
              >
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-lime">✓</span><span
                >2 wejścia na zajęcia fitness w tygodniu</span
              >
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-lime">✓</span><span
                >Zajęcia Cross w czwartki w cenie karnetu</span
              >
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-lime">✓</span><span
                >Dostęp do aplikacji klubowej GymManager</span
              >
            </li>
          </ul>
        </div>
        <div class="mt-6">
          <a
            href="https://v3klub.gymmanager.io"
            target="_blank"
            rel="noopener noreferrer"
            class="flex w-full items-center justify-center rounded-xl border border-v3-lime bg-v3-lime py-3.5 text-xs sm:text-sm font-extrabold uppercase tracking-wider text-black transition-all duration-200 hover:bg-white hover:text-black hover:border-white active:scale-[0.98]"
          >
            Kup karnet online →
          </a>
        </div>
      </div>

      <!-- 3. V3 PRO -->
      <div
        class="flex flex-col justify-between rounded-2xl border border-v3-border bg-v3-surface/70 p-5 sm:p-6 transition duration-300 hover:border-v3-lime/40"
      >
        <div>
          <span
            class="font-display text-2xl sm:text-3xl font-bold uppercase tracking-wide text-white"
            >V3 PRO</span
          >
          <p
            class="plan-period-badge mt-1 text-xs font-semibold uppercase tracking-wider text-zinc-300"
            data-monthly-period="Miesięczny • Bez umowy"
            data-long-period="Pakiet Półroczny • Umowa 6 msc"
          >
            Miesięczny • Bez umowy
          </p>

          <div class="mt-4 flex items-baseline gap-1">
            <span
              class="price-value font-display text-5xl font-bold leading-none text-white sm:text-6xl"
              data-monthly="169"
              data-long="129">169</span
            >
            <span
              class="price-unit text-sm font-medium text-zinc-300"
              data-monthly-unit="zł / miesiąc"
              data-long-unit="zł / msc w pakiecie">zł / miesiąc</span
            >
          </div>

          <p
            class="price-subnote mt-1 text-xs font-medium text-v3-lime"
            data-monthly-note="W pakiecie półrocznym tylko 129 zł / msc"
            data-long-note="Oszczędzasz 240 zł w skali półrocza"
          >
            W pakiecie półrocznym tylko 129 zł / msc
          </p>

          <ul
            class="mt-5 space-y-2.5 border-t border-v3-border pt-5 text-xs sm:text-sm text-zinc-200"
          >
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-lime">✓</span><span
                >Pełen nielimitowany dostęp do siłowni</span
              >
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-lime">✓</span><span
                >3 wejścia na zajęcia fitness w tygodniu</span
              >
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-lime">✓</span><span
                >Zajęcia Cross w czwartki w cenie karnetu</span
              >
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-lime">✓</span><span
                >Dostęp do aplikacji klubowej GymManager</span
              >
            </li>
          </ul>
        </div>
        <div class="mt-6">
          <a
            href="https://v3klub.gymmanager.io"
            target="_blank"
            rel="noopener noreferrer"
            class="flex w-full items-center justify-center rounded-xl border border-v3-lime/40 bg-v3-card py-3.5 text-xs sm:text-sm font-bold uppercase tracking-wider text-zinc-100 transition-all duration-200 hover:bg-v3-lime hover:text-black hover:border-v3-lime active:scale-[0.98]"
          >
            Kup karnet online →
          </a>
        </div>
      </div>

      <!-- 4. V3 VIP -->
      <div
        class="relative flex flex-col justify-between rounded-2xl border border-v3-red/40 bg-gradient-to-b from-v3-surface to-red-950/20 p-5 sm:p-6"
      >
        <div
          class="absolute -top-3 left-6 rounded-full bg-v3-red px-3 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white"
        >
          ALL INCLUSIVE
        </div>
        <div>
          <span
            class="font-display text-2xl sm:text-3xl font-bold uppercase tracking-wide text-v3-red"
            >V3 VIP</span
          >
          <p
            id="vip-period-badge"
            class="mt-1 text-xs font-semibold uppercase tracking-wider text-zinc-300"
          >
            Pakiet Pełny • Bez ograniczeń
          </p>

          <div class="mt-4 flex items-baseline gap-1">
            <span
              class="font-display text-5xl font-bold leading-none text-white sm:text-6xl"
              >309</span
            >
            <span class="text-sm font-medium text-zinc-300">zł / miesiąc</span>
          </div>

          <p class="mt-1 text-xs font-medium text-v3-red">
            Maksymalny priorytet i opieka trenerska
          </p>

          <ul
            class="mt-5 space-y-2.5 border-t border-v3-border pt-5 text-xs sm:text-sm text-zinc-200"
          >
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-red">✓</span><span
                >Siłownia, fitness i sporty walki BEZ LIMITU</span
              >
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-red">✓</span><span
                >Pierwszeństwo zapisów na wszystkie zajęcia</span
              >
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-red">✓</span><span
                >1 trening personalny w miesiącu w cenie</span
              >
            </li>
            <li class="flex items-center gap-2">
              <span class="font-bold text-v3-red">✓</span><span
                >Indywidualne wsparcie szkoleniowe</span
              >
            </li>
          </ul>
        </div>
        <div class="mt-6">
          <a
            href="https://v3klub.gymmanager.io"
            target="_blank"
            rel="noopener noreferrer"
            class="flex w-full items-center justify-center rounded-xl border border-v3-red/40 bg-v3-card py-3.5 text-xs sm:text-sm font-bold uppercase tracking-wider text-zinc-100 transition-all duration-200 hover:bg-v3-red hover:text-white hover:border-v3-red active:scale-[0.98]"
          >
            Kup karnet online →
          </a>
        </div>
      </div>
    </div>

    <!-- Pakiety partnerskie -->
    <div
      class="mt-8 sm:mt-10 flex flex-col items-center justify-between gap-4 rounded-2xl border border-v3-border bg-v3-surface/60 p-5 sm:p-6 sm:flex-row backdrop-blur-sm"
    >
      <div>
        <h4
          class="font-display text-xl sm:text-2xl font-bold uppercase leading-none text-white"
        >
          Honorujemy pakiety firmowe &amp; opcje kwartalne
        </h4>
        <p class="mt-1 text-xs sm:text-sm text-zinc-300">
          W panelu GymManager dostępne są również karnety kwartalne (Active 139
          zł, Pro 149 zł). Trenujesz u nas także z kartami partnerskimi.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
        <span
          class="rounded-xl border border-v3-lime/30 bg-v3-lime/10 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-v3-lime"
          >✓ MultiSport</span
        >
        <span
          class="rounded-xl border border-v3-lime/30 bg-v3-lime/10 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-v3-lime"
          >✓ Medicover Sport</span
        >
        <span
          class="rounded-xl border border-v3-lime/30 bg-v3-lime/10 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-v3-lime"
          >✓ Fit Profit</span
        >
      </div>
    </div>
  </div>
</section>

<script>
  const btnMonthly = document.getElementById("btn-pricing-monthly");
  const btnLong = document.getElementById("btn-pricing-long");
  const badgeDiscount = document.getElementById("badge-discount");
  const priceValues = document.querySelectorAll<HTMLElement>(".price-value");
  const priceUnits = document.querySelectorAll<HTMLElement>(".price-unit");
  const priceNotes = document.querySelectorAll<HTMLElement>(".price-subnote");
  const periodBadges =
    document.querySelectorAll<HTMLElement>(".plan-period-badge");
  const limitDesc = document.getElementById("limit-plan-desc");
  const limitNote = document.getElementById("limit-subnote");

  function setPricingMode(mode: "monthly" | "long") {
    if (!btnMonthly || !btnLong || !badgeDiscount) return;

    if (mode === "monthly") {
      btnMonthly.className =
        "cursor-pointer rounded-xl bg-v3-lime px-4 py-2 text-xs font-bold uppercase tracking-wider text-black transition sm:px-5 sm:text-sm shadow-md";
      btnLong.className =
        "cursor-pointer flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-300 transition hover:text-white sm:px-5 sm:text-sm";
      badgeDiscount.className =
        "rounded-md border border-v3-lime/30 bg-v3-lime/15 px-2 py-0.5 text-[10px] font-extrabold text-v3-lime transition-all";

      if (limitDesc) limitDesc.textContent = "Bez umowy • Wejścia do 12:00";
      if (limitNote) limitNote.textContent = "Stała niska cena bez zobowiązań";
    } else {
      btnLong.className =
        "cursor-pointer flex items-center gap-2 rounded-xl bg-v3-lime px-4 py-2 text-xs font-bold uppercase tracking-wider text-black transition sm:px-5 sm:text-sm shadow-md";
      btnMonthly.className =
        "cursor-pointer rounded-xl px-4 py-2 text-xs font-bold uppercase tracking-wider text-zinc-300 transition hover:text-white sm:px-5 sm:text-sm";
      badgeDiscount.className =
        "rounded-md bg-v3-dark border border-v3-border px-2 py-0.5 text-[10px] font-extrabold text-v3-lime shadow-sm transition-all";

      if (limitDesc)
        limitDesc.textContent = "Stała cena • Tylko opcja miesięczna";
      if (limitNote)
        limitNote.textContent = "Brak zobowiązania długoterminowego";
    }

    priceValues.forEach((el) => {
      const val = mode === "monthly" ? el.dataset.monthly : el.dataset.long;
      if (val) el.textContent = val;
    });

    priceUnits.forEach((el) => {
      const unit =
        mode === "monthly" ? el.dataset.monthlyUnit : el.dataset.longUnit;
      if (unit) el.textContent = unit;
    });

    priceNotes.forEach((el) => {
      const note =
        mode === "monthly" ? el.dataset.monthlyNote : el.dataset.longNote;
      if (note) el.textContent = note;
    });

    periodBadges.forEach((el) => {
      const period =
        mode === "monthly" ? el.dataset.monthlyPeriod : el.dataset.longPeriod;
      if (period) el.textContent = period;
    });
  }

  btnMonthly?.addEventListener("click", () => setPricingMode("monthly"));
  btnLong?.addEventListener("click", () => setPricingMode("long"));
</script>
