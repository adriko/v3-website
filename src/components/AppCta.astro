---
const gymManagerUrl = "https://v3klub.gymmanager.io";
---

<section id="aplikacja" class="py-24 bg-v3-dark border-b border-v3-border relative overflow-hidden">
  <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[550px] h-[450px] bg-v3-lime/10 blur-[180px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Lewa kolumna -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-v3-lime/10 border border-v3-lime/30 text-v3-lime text-xs font-bold uppercase tracking-widest rounded-lg mb-4">
          <span>⚡</span> Inteligentny Wstęp 5:00 – 24:00
        </div>

        <h2 class="font-['Teko'] text-5xl sm:text-6xl lg:text-7xl font-black uppercase text-white leading-none">
          Smartfon Twoim <br />
          <span class="text-v3-lime">Kluczem Do Klubu</span>
        </h2>
        
        <p class="mt-6 text-zinc-300 text-sm sm:text-base leading-relaxed max-w-xl">
          Koniec ze staniem w kolejkach do recepcji i zgubionymi kartami plastikowymi. W V3 Klubie całe członkostwo masz w telefonie – od zakupu karnetu, przez rezerwację miejsc na macie i fitnessie, aż po <strong class="text-white font-semibold">automatyczne otwieranie wejścia od 5:00 rano do północy</strong>.
        </p>

        <ul class="mt-6 space-y-3.5 text-xs sm:text-sm text-zinc-300">
          <li class="flex items-center gap-3">
            <span class="text-v3-lime font-bold text-base leading-none">✓</span> 
            <span><strong class="text-white">Autonomiczny dostęp:</strong> Skanujesz kod QR z ekranu telefonu przy czytniku wejściowym i wchodzisz na trening (5:00 – 24:00)</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-v3-lime font-bold text-base leading-none">✓</span> 
            <span><strong class="text-white">Zakup w 30 sekund:</strong> Karnety LIMIT, ACTIVE, PRO, VIP aktywowane natychmiast bez formalności papierowych</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-v3-lime font-bold text-base leading-none">✓</span> 
            <span><strong class="text-white">Gwarancja miejsca:</strong> Rezerwacja maty w Fight Zone i sali fitness jednym dotknięciem</span>
          </li>
        </ul>

        <div class="mt-10 flex flex-wrap gap-4 items-center">
          <a 
            href={gymManagerUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="bg-v3-lime text-black font-extrabold px-8 py-3.5 rounded-xl text-xs uppercase tracking-wider hover:bg-v3-lime-hover transition-all transform hover:-translate-y-0.5 shadow-[0_0_25px_rgba(200,255,0,0.35)] inline-flex items-center gap-2"
          >
            Panel Klienta Online (Kup Karnet) &rarr;
          </a>

          <a 
            href="https://play.google.com/store/apps/details?id=io.gymmanager.app" 
            target="_blank" 
            rel="noopener noreferrer"
            class="bg-v3-surface hover:bg-zinc-800 border border-v3-border text-white px-5 py-3 rounded-xl text-xs font-bold uppercase tracking-wider transition-all"
          >
            Google Play
          </a>
          <a 
            href="https://apps.apple.com/app/gymmanager/id1450284489" 
            target="_blank" 
            rel="noopener noreferrer"
            class="bg-v3-surface hover:bg-zinc-800 border border-v3-border text-white px-5 py-3 rounded-xl text-xs font-bold uppercase tracking-wider transition-all"
          >
            App Store
          </a>
        </div>
      </div>

      <!-- Prawa kolumna z kodem QR -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="bg-gradient-to-b from-v3-surface to-v3-card border-2 border-v3-lime/60 rounded-3xl p-8 text-center max-w-sm w-full shadow-[0_0_40px_rgba(200,255,0,0.2)] relative">
          
          <div class="text-[11px] font-bold text-zinc-400 uppercase tracking-widest mb-4">
            Zeskanuj aparatem w smartfonie
          </div>

          <div class="bg-white p-3 rounded-2xl mx-auto w-56 h-56 flex items-center justify-center shadow-inner">
            <img 
              src="/qr-gymmanager.png" 
              alt="Kod QR GymManager V3 Klub Jarosław" 
              class="w-full h-full object-contain"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div style="display:none;" class="w-full h-full flex-col items-center justify-center text-black font-mono text-xs font-bold text-center p-2">
              <span>Wklej plik:</span>
              <span class="text-zinc-600 mt-1">public/qr-gymmanager.png</span>
            </div>
          </div>

          <div class="mt-4 font-mono text-xs font-bold text-v3-lime uppercase tracking-wider">
            v3klub.gymmanager.io
          </div>
          <p class="text-[11px] text-zinc-400 mt-2">
            Aparat otworzy aplikację GymManager lub stronę logowania V3.
          </p>

        </div>
      </div>

    </div>
  </div>
</section>