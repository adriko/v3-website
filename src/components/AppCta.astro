---
---

<section class="relative border-b border-white/10 bg-v3-surface/50 py-16 sm:py-20 overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12">
      <!-- Lewa kolumna -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 rounded-full border border-v3-lime/30 bg-v3-lime/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-v3-lime">
          <span>Samoobsługa 5:00 – 24:00</span>
        </div>

        <h2 class="mt-3 font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold uppercase leading-none tracking-tight text-white">
          Wstęp na Smartfon <br />
          <span class="text-v3-lime">Klub Bez Ograniczeń</span>
        </h2>

        <p class="mt-4 text-sm sm:text-base leading-relaxed text-zinc-300 max-w-xl">
          Centrum Sportowe V3 działa w standardzie samoobsługowym. Pobierz
          bezpłatną aplikację klubową{" "}
          <strong class="text-white">GymManager</strong>, aktywuj karnet w 30
          sekund i otwieraj bramkę wejściową cyfrowym kodem QR na ekranie
          telefonu.
        </p>

        <ul class="mt-6 space-y-3 text-sm text-zinc-200">
          <li class="flex items-center gap-3">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-v3-lime/20 text-xs font-bold text-v3-lime">
              ✓
            </span>
            <span>
              Błyskawiczne otwieranie wejścia kodem QR o dowolnej porze
            </span>
          </li>
          <li class="flex items-center gap-3">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-v3-lime/20 text-xs font-bold text-v3-lime">
              ✓
            </span>
            <span>
              Zapisy na zajęcia grupowe, cross oraz fitness w 1 kliknięcie
            </span>
          </li>
          <li class="flex items-center gap-3">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-v3-lime/20 text-xs font-bold text-v3-lime">
              ✓
            </span>
            <span>
              Wygodne przedłużanie karnetu online bez stania w kolejce
            </span>
          </li>
        </ul>

        <!-- Przycisk Panelu + Przyciski Sklepów z autentycznymi ikonami -->
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="https://v3klub.gymmanager.io"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 rounded-2xl bg-v3-lime pl-6 pr-3.5 py-3 text-xs sm:text-sm font-extrabold uppercase tracking-wider text-black transition hover:bg-white"
          >
            <span>Panel Klienta Online</span>
            <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-black/15 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
              <svg
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M7 17L17 7M7 7h10v10"
                />
              </svg>
            </span>
          </a>

          <!-- App Store z ikoną Apple -->
          <a
            href="https://apps.apple.com/pl/app/gymmanager/id1453912648"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 rounded-2xl border border-white/15 bg-v3-card px-4 py-2.5 text-left text-zinc-200 hover:border-v3-lime/50 hover:text-white transition"
          >
            <svg
              class="h-6 w-6 fill-current text-white shrink-0"
              viewBox="0 0 24 24"
            >
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.96 6.32c.67-.81 1.12-1.94 1-3.07-.96.04-2.13.64-2.82 1.45-.61.7-.115 1.85-1.01 2.96 1.07.08 2.16-.53 2.83-1.34z" />
            </svg>
            <div class="leading-tight">
              <span class="block text-[10px] font-medium text-zinc-400">
                Pobierz w
              </span>
              <span class="block text-xs sm:text-sm font-bold text-white">
                App Store
              </span>
            </div>
          </a>

          <!-- Google Play z ikoną Google Play -->
          <a
            href="https://play.google.com/store/apps/details?id=io.gymmanager.mobile"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 rounded-2xl border border-white/15 bg-v3-card px-4 py-2.5 text-left text-zinc-200 hover:border-v3-lime/50 hover:text-white transition"
          >
            <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24">
              <path
                fill="#4285F4"
                d="M3.61 1.814L13.793 12 3.61 22.186a1.99 1.99 0 01-.465-1.285V3.1c0-.5.18-.955.465-1.286z"
              />
              <path
                fill="#34A853"
                d="M17.207 8.586L13.793 12l3.414 3.414 3.846-2.198c.875-.5.875-1.932 0-2.432l-3.846-2.198z"
              />
              <path
                fill="#FBBC05"
                d="M3.61 22.186L13.793 12l3.414 3.414-11.833 6.762c-.64.365-1.35.344-1.764.01z"
              />
              <path
                fill="#EA4335"
                d="M17.207 8.586L5.374 1.824c-.414-.334-1.124-.355-1.764.01L13.793 12l3.414-3.414z"
              />
            </svg>
            <div class="leading-tight">
              <span class="block text-[10px] font-medium text-zinc-400">
                Pobierz z
              </span>
              <span class="block text-xs sm:text-sm font-bold text-white">
                Google Play
              </span>
            </div>
          </a>
        </div>
      </div>

      <!-- Prawa kolumna: V3 Digital Pass -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="w-full max-w-sm rounded-3xl border border-white/15 bg-v3-dark p-3 shadow-2xl">
          <div class="rounded-2xl border border-white/10 bg-v3-surface p-6 text-center">
            <div class="flex items-center justify-between border-b border-white/10 pb-3.5 mb-5">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-v3-lime animate-pulse"></span>
                <span class="text-xs font-extrabold uppercase tracking-wider text-white">
                  V3 DIGITAL PASS
                </span>
              </div>
              <span class="rounded-md bg-v3-lime/15 px-2 py-0.5 text-xs font-bold text-v3-lime">
                05:00 – 24:00
              </span>
            </div>

            <div class="mx-auto w-44 h-44 rounded-2xl bg-white p-3 shadow-inner flex items-center justify-center">
              <img
                src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://v3klub.gymmanager.io"
                alt="Kod QR do rejestracji w V3 Klub"
                width="170"
                height="170"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-contain"
              />
            </div>

            <p class="mt-5 font-display text-2xl font-extrabold uppercase text-white leading-none">
              Zeskanuj aparatem
            </p>
            <span class="mt-1.5 block text-xs text-zinc-400">
              Przejdź bezpośrednio do rejestracji konta klubowicza
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
