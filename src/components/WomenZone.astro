---
const zuzaFeatures = [
  { title: 'Drenaż limfatyczny', desc: 'Redukcja opuchlizny, uczucie lekkich nóg i wsparcie regeneracji.' },
  { title: 'Analiza składu ciała', desc: 'Precyzyjny pomiar tkanki tłuszczowej, mięśniowej i wody w organizmie.' },
  { title: 'Wytyczne dietetyczne', desc: 'Indywidualny plan żywieniowy dopasowany do Twojego trybu życia.' },
  { title: 'Stała kontrola postępów', desc: 'Bieżące monitorowanie efektów, motywacja i opieka trenerska.' },
];
---

<section id="strefa-kobiet" class="py-16 sm:py-24 bg-gradient-to-b from-v3-dark via-[#140a14] to-v3-dark border-b border-v3-border relative overflow-hidden">
  <!-- Różowo-fioletowa poświata tła -->
  <div class="absolute -left-20 top-1/3 w-[600px] h-[600px] bg-pink-600/10 blur-[180px] pointer-events-none"></div>
  <div class="absolute right-0 bottom-10 w-[500px] h-[500px] bg-purple-600/10 blur-[180px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- 1. Główny baner: Dedykowana Strefa dla Kobiet -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center mb-14 sm:mb-20">
      
      <div class="lg:col-span-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-pink-500/10 border border-pink-500/30 text-pink-400 text-[11px] font-bold uppercase tracking-widest mb-4">
          <svg class="w-3.5 h-3.5 fill-current text-pink-400" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <span>100% Prywatności i Komfortu</span>
        </div>

        <h2 class="font-['Teko'] text-4xl sm:text-6xl lg:text-7xl font-black uppercase text-white leading-none">
          Dedykowana <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-400 via-fuchsia-400 to-purple-400">
            Strefa Kobiet
          </span>
        </h2>

        <p class="mt-4 sm:mt-6 text-zinc-300 text-xs sm:text-base leading-relaxed">
          W klubie V3 stworzyliśmy wyjątkową, odrębną przestrzeń zaprojektowaną specjalnie dla kobiet. Różowa sala wyposażona w suwnicę Smitha, profesjonalne stojaki rack, wolne ciężary, hantle, sztangi tiguar oraz podświetlane lustro selfie – wszystko w atmosferze pełnego skupienia i swobody.
        </p>

        <ul class="mt-5 sm:mt-6 space-y-2.5 sm:space-y-3 text-xs sm:text-sm text-zinc-300">
          <li class="flex items-center gap-3">
            <span class="text-pink-400 font-bold text-base leading-none">✓</span>
            <span>Własna, zamknięta sala wyłącznie dla pań</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-pink-400 font-bold text-base leading-none">✓</span>
            <span>Pełne wyposażenie do modelowania pośladków, nóg i sylwetki</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-pink-400 font-bold text-base leading-none">✓</span>
            <span>Idealny klimat: neonowe oświetlenie, styl i komfort treningu</span>
          </li>
        </ul>
      </div>

      <!-- Karta ze zdjęciem sali -->
      <div class="lg:col-span-6">
        <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden border-2 border-pink-500/40 shadow-[0_0_40px_rgba(236,72,153,0.2)] group">
          <img 
            src="/images/women-zone.jpg" 
            alt="Strefa Kobiet w V3 Klub Jarosław"
            class="w-full h-[300px] sm:h-[440px] object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
          
          <div class="absolute bottom-5 left-5 right-5 sm:bottom-6 sm:left-6 sm:right-6">
            <span class="px-3 py-1 bg-pink-500 text-white font-black text-[10px] tracking-widest uppercase rounded-md shadow-md inline-block mb-1.5">
              Pink Zone • Tylko dla Kobiet
            </span>
            <p class="text-white font-['Teko'] text-2xl sm:text-3xl font-bold uppercase tracking-wide leading-none">
              Twoje miejsce na bezpieczny i pewny trening
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- 2. Sekcja Trenerki Zuzy -->
    <div class="bg-gradient-to-br from-v3-card via-v3-surface to-black border border-pink-500/30 rounded-2xl sm:rounded-3xl p-6 sm:p-8 lg:p-12 relative overflow-hidden shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Zdjęcie Zuzy -->
        <div class="lg:col-span-4 flex justify-center">
          <div class="relative w-60 h-72 sm:w-72 sm:h-96 rounded-2xl overflow-hidden border-2 border-pink-500/50 shadow-xl group">
            <img 
              src="/images/zuza.jpg" 
              alt="Trenerka Zuza - V3 Klub Jarosław"
              class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 text-center">
              <span class="font-['Teko'] text-3xl font-bold uppercase text-white block leading-none">Zuza</span>
              <span class="text-xs text-pink-400 font-semibold uppercase tracking-wider">Trenerka & Opieka Wellness</span>
            </div>
          </div>
        </div>

        <!-- Opis pakietu i korzyści -->
        <div class="lg:col-span-8">
          <div class="inline-block px-3 py-1 bg-pink-500/10 border border-pink-500/30 text-pink-400 text-[11px] font-bold uppercase tracking-wider rounded-lg mb-3">
            Opieka Trenerska & Odnowa
          </div>

          <h3 class="font-['Teko'] text-3xl sm:text-5xl font-black uppercase text-white leading-none">
            Zadbaj o sylwetkę i zdrowie z Zuzą
          </h3>

          <p class="text-zinc-300 text-xs sm:text-sm mt-3 leading-relaxed">
            Skorzystaj z kompleksowych pakietów metamorfozy dostępnych w klubie V3. Połączenie drenażu limfatycznego, precyzyjnej analizy składu ciała i indywidualnych wytycznych żywieniowo-treningowych to najszybszy krok do lekkich nóg, wymarzonej sylwetki i doskonałego samopoczucia.
          </p>

          <!-- 4 kafelki oferty Zuzy -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 mt-6">
            {zuzaFeatures.map((f) => (
              <div class="p-3.5 sm:p-4 rounded-xl bg-v3-dark/80 border border-v3-border hover:border-pink-500/50 transition-colors">
                <span class="font-bold text-xs uppercase tracking-wide block text-pink-300">
                  {f.title}
                </span>
                <p class="text-[11px] sm:text-xs text-zinc-400 mt-1 leading-relaxed">{f.desc}</p>
              </div>
            ))}
          </div>

          <!-- Przycisk bezpośredniego kontaktu do Zuzy z wektorem SVG -->
          <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-4">
            <a 
              href="tel:733484404" 
              class="w-full sm:w-auto justify-center bg-gradient-to-r from-pink-500 to-fuchsia-600 hover:from-pink-600 hover:to-fuchsia-700 text-white font-extrabold px-7 py-3.5 rounded-xl text-xs uppercase tracking-wider transition-all transform hover:-translate-y-0.5 shadow-[0_0_25px_rgba(236,72,153,0.35)] inline-flex items-center gap-2.5"
            >
              <svg class="w-4 h-4 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>Zadzwoń i umów się z Zuzą: 733 484 404</span>
            </a>
            <span class="text-[11px] sm:text-xs text-zinc-400">Pierwsza konsultacja i pomiar na miejscu w klubie</span>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>