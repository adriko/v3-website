---
---

<section
  id="o-nas"
  class="relative overflow-hidden border-b border-white/10 bg-v3-dark"
>
  <!-- Pełnoekranowe zdjęcie tła po prawej stronie (Desktop) -->
  <div class="hidden lg:block absolute inset-y-0 right-0 w-3/5 pointer-events-none select-none pr-6">
    <img
      src="/images/v3-gym-brick.jpeg"
      alt="Wnętrze V3 Klub Jarosław - strefa cardio i logo na cegle"
      width="1200"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-right opacity-90"
    />
    <div class="absolute inset-0 bg-linear-to-r from-v3-dark via-v3-dark/65 to-transparent"></div>
    <div class="absolute inset-0 bg-linear-to-t from-v3-dark via-transparent to-v3-dark/40"></div>
  </div>

  <!-- Subtelna siatka architektoniczna -->
  <div class="absolute inset-0 bg-v3-grid pointer-events-none"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative pt-7 pb-10 sm:pt-14 sm:pb-14 lg:pt-20 lg:pb-16">
    <div class="max-w-xl lg:max-w-2xl">
      <!-- Kicker -->
      <div class="inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-v3-lime"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-zinc-200">
          ul. Poniatowskiego 24 • Jarosław
        </span>
      </div>

      <!-- Nagłówek H1 -->
      <h1 class="mt-4 sm:mt-5 font-display text-6xl sm:text-7xl lg:text-8xl font-black uppercase leading-[0.88] tracking-tight">
        <span class="block text-white">Siłownia</span>
        <span class="block text-v3-lime">Fitness</span>
        <span class="block text-v3-red">Fight Zone</span>
      </h1>

      <!-- Nowoczesny kadr na smartfonie: pełna szerokość bez pudełka, płynne wtopienie góra-dół -->
      <div class="lg:hidden -mx-4 sm:mx-0 mt-4 relative overflow-hidden sm:rounded-2xl">
        <img
          src="/images/v3-gym-brick.jpeg"
          alt="Wnętrze V3 Klub Jarosław - logo na cegle"
          width="800"
          height="500"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-56 sm:h-72 w-full object-cover object-center"
        />
        <!-- Górne i dolne przejście w czerń tła (środek z logo w 100% wyraźny) -->
        <div class="pointer-events-none absolute inset-x-0 top-0 h-10 bg-linear-to-b from-v3-dark to-transparent"></div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-linear-to-t from-v3-dark to-transparent"></div>
      </div>

      <!-- Zwięzły opis -->
      <p class="mt-3 sm:mt-6 text-sm sm:text-lg leading-relaxed text-zinc-300 max-w-xl">
        Dwupoziomowe centrum sportowe łączące park maszyn{" "}
        <strong class="font-semibold text-white">Bodytone</strong>, zajęcia
        grupowe, zamkniętą Strefę Kobiet oraz sekcję sportów walki z
        pełnowymiarowym ringiem. Wejście samoobsługowe{" "}
        <strong class="font-semibold text-white">5:00 – 24:00</strong> na kod QR
        w telefonie.
      </p>

      <!-- Przyciski CTA (wszystkie w jednej linii na mobile i PC) -->
      <div class="mt-6 sm:mt-7 flex flex-col sm:flex-row sm:items-center gap-3">
        <a
          href="/#cennik"
          class="group inline-flex w-full sm:w-auto items-center justify-between sm:justify-center gap-3 rounded-2xl bg-v3-lime pl-6 pr-3.5 py-3.5 text-sm font-extrabold uppercase tracking-wider text-black transition-all duration-200 hover:bg-white active:scale-[0.98]"
        >
          <span>Sprawdź karnety</span>
          <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-black/15 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M7 17L17 7M7 7h10v10"
              />
            </svg>
          </span>
        </a>

        <div class="grid grid-cols-2 gap-2.5 sm:gap-3 sm:flex sm:items-center">
          <a
            href="/grafik"
            class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/15 bg-white/5 px-3.5 sm:px-5 py-4 text-xs sm:text-sm font-bold uppercase tracking-wider text-white whitespace-nowrap backdrop-blur-md transition hover:border-v3-lime/60 hover:bg-white/10 hover:text-v3-lime"
          >
            <svg
              class="h-4 w-4 text-v3-lime shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
            <span>Grafik zajęć</span>
          </a>

          <a
            href="tel:+48788463717"
            class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/15 bg-white/5 px-3.5 sm:px-5 py-4 text-xs sm:text-sm font-bold uppercase tracking-wider text-white whitespace-nowrap backdrop-blur-md transition hover:border-white/35 hover:bg-white/10"
          >
            <svg
              class="h-4 w-4 text-v3-lime shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              />
            </svg>
            <span>Zadzwoń</span>
          </a>
        </div>
      </div>

      <!-- 4 kluczowe przewagi klubu V3 -->
      <div class="mt-9 grid grid-cols-2 sm:grid-cols-4 gap-4 border-t border-white/10 pt-6">
        <div>
          <span class="block font-display text-2xl sm:text-3xl font-extrabold uppercase leading-none text-v3-lime">
            5:00 – 24:00
          </span>
          <span class="mt-1.5 block text-xs text-zinc-400">Samoobsługa QR</span>
        </div>
        <div>
          <span class="block font-display text-2xl sm:text-3xl font-extrabold uppercase leading-none text-white">
            2 PIĘTRA
          </span>
          <span class="mt-1.5 block text-xs text-zinc-400">
            Siłownia &amp; Fight Zone
          </span>
        </div>
        <div>
          <span class="block font-display text-2xl sm:text-3xl font-extrabold uppercase leading-none text-pink-400">
            PINK ZONE
          </span>
          <span class="mt-1.5 block text-xs text-zinc-400">
            Odrębna Strefa Kobiet
          </span>
        </div>
        <div>
          <span class="block font-display text-2xl sm:text-3xl font-extrabold uppercase leading-none text-white">
            KARTY VIP
          </span>
          <span class="mt-1.5 block text-xs text-zinc-400">
            MultiSport • Medicover
          </span>
        </div>
      </div>
    </div>

    <!-- Pasek udogodnień -->
    <div class="mt-10 sm:mt-14 grid grid-cols-1 md:grid-cols-3 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10">
      <div class="flex items-center gap-4 bg-v3-surface/95 p-5 backdrop-blur-md">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-v3-lime/10 text-v3-lime">
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="3" width="18" height="18" rx="4"></rect>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 17V7h4.5a3 3 0 010 6H9"
            ></path>
          </svg>
        </div>
        <div>
          <h2 class="font-display text-xl font-bold uppercase tracking-wide text-white leading-none">
            Własny Parking
          </h2>
          <p class="mt-1 text-xs sm:text-sm text-zinc-400">
            Bezpośrednio pod klubem dla klubowiczów
          </p>
        </div>
      </div>

      <div class="flex items-center gap-4 bg-v3-surface/95 p-5 backdrop-blur-md">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-v3-lime/10 text-v3-lime">
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 4h6a5 5 0 015 5v2.5M10.5 11.5h9l-1.2 3h-6.6l-1.2-3zM12 18v2M15 18v2M18 18v2"
            ></path>
          </svg>
        </div>
        <div>
          <h2 class="font-display text-xl font-bold uppercase tracking-wide text-white leading-none">
            Szatnie &amp; Prysznice
          </h2>
          <p class="mt-1 text-xs sm:text-sm text-zinc-400">
            Przestronne szatnie z pełnym węzłem sanitarnym
          </p>
        </div>
      </div>

      <div class="flex items-center gap-4 bg-v3-surface/95 p-5 backdrop-blur-md">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-v3-lime/10 text-v3-lime">
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M7 8h10l-1.2 11.5a2 2 0 01-2 1.5H10.2a2 2 0 01-2-1.5L7 8zM6 5h12v3H6V5zM10 2h4v3h-4V2z"
            ></path>
          </svg>
        </div>
        <div>
          <h2 class="font-display text-xl font-bold uppercase tracking-wide text-white leading-none">
            FitBar z Odżywkami
          </h2>
          <p class="mt-1 text-xs sm:text-sm text-zinc-400">
            Izotoniki, shake'i białkowe i batony na miejscu
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
