---
---

<section id="o-nas" class="relative overflow-hidden border-b border-white/10 py-12 sm:py-16 lg:py-24">
  <!-- Poświaty tła -->
  <div class="pointer-events-none absolute -top-32 -left-32 h-96 w-96 rounded-full bg-v3-lime/10 blur-3xl"></div>
  <div class="pointer-events-none absolute top-1/3 right-0 h-96 w-96 rounded-full bg-v3-red/10 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- Lewa kolumna: Tekst i CTA -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 rounded-full border border-v3-lime/30 bg-v3-lime/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-v3-lime">
          <span class="h-2 w-2 rounded-full bg-v3-lime"></span>
          Jarosław • Poniatowskiego 24
        </div>

        <div class="mt-4 flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-zinc-300">
          <span>V3 <span class="text-v3-lime">KLUB</span> • Centrum Sportowe</span>
        </div>

        <h1 class="mt-2 flex flex-col font-['Teko'] text-5xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl">
          <span class="text-white">Siłownia</span>
          <span class="text-v3-lime">Fitness</span>
          <span class="text-v3-red">Fight Zone</span>
        </h1>

        <p class="mt-6 max-w-2xl text-base leading-relaxed text-zinc-300 sm:text-lg">
          Nowoczesne centrum sportowe w Jarosławiu. Strefa maszyn Bodytone, wolne ciężary, zajęcia fitness, dedykowana strefa kobiet oraz sekcja sportów walki. Trenuj bez ograniczeń dzięki <strong class="font-semibold text-white">samoobsługowemu wejściu w godzinach 5:00 – 24:00</strong> przez smartfon.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3.5">
          <a
            href="#cennik"
            class="inline-flex items-center justify-center rounded-xl bg-v3-lime px-6 py-3.5 text-sm font-bold uppercase tracking-wider text-black transition hover:bg-v3-lime-hover shadow-[0_0_25px_rgba(200,255,0,0.3)]"
          >
            Sprawdź karnety
          </a>
          <a
            href="#fight-zone"
            class="inline-flex items-center justify-center rounded-xl border border-v3-red/40 bg-v3-red/10 px-5 py-3.5 text-sm font-bold uppercase tracking-wider text-v3-red transition hover:bg-v3-red/20"
          >
            Fight Zone
          </a>
          <a
            href="tel:+48788463717"
            aria-label="Zadzwoń do klubu V3: 788 463 717"
            class="inline-flex items-center justify-center rounded-xl border border-white/15 bg-zinc-900/90 px-5 py-3.5 text-sm font-bold uppercase tracking-wider text-zinc-200 transition hover:border-white/30 hover:text-white"
          >
            📞 Zadzwoń
          </a>
        </div>

        <!-- Kluczowe atuty -->
        <div class="mt-10 grid grid-cols-3 gap-3 border-t border-white/10 pt-6 sm:gap-6">
          <div>
            <span class="block font-['Teko'] text-2xl font-bold uppercase leading-none text-v3-lime sm:text-3xl">5:00 – 24:00</span>
            <span class="mt-1 block text-xs font-medium text-zinc-300 sm:text-sm">Kod w telefonie</span>
          </div>
          <div>
            <span class="block font-['Teko'] text-2xl font-bold uppercase leading-none text-v3-red sm:text-3xl">FIGHT ZONE</span>
            <span class="mt-1 block text-xs font-medium text-zinc-300 sm:text-sm">Mata &amp; ring</span>
          </div>
          <div>
            <span class="block font-['Teko'] text-2xl font-bold uppercase leading-none text-white sm:text-3xl">CROSS W CENIE</span>
            <span class="mt-1 block text-xs font-medium text-zinc-300 sm:text-sm">W karnecie</span>
          </div>
        </div>
      </div>

      <!-- Prawa kolumna: Pojedynczy zoptymalizowany obraz LCP -->
      <div class="lg:col-span-5">
        <div class="relative overflow-hidden rounded-2xl border border-white/15 bg-zinc-900 shadow-2xl">
          <img
            src="/images/v3-gym-brick.jpeg"
            alt="Wnętrze V3 Klub Jarosław - strefa cardio i logo na cegle"
            width="800"
            height="600"
            fetchpriority="high"
            decoding="async"
            class="h-72 w-full object-cover sm:h-96 lg:h-[480px]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between rounded-xl border border-white/10 bg-zinc-950/85 p-4 backdrop-blur-md">
            <div>
              <span class="block text-xs font-bold uppercase tracking-wider text-v3-lime">Strefa Cardio &amp; Maszyn</span>
              <p class="mt-0.5 font-['Teko'] text-2xl font-bold uppercase leading-none text-white">Centrum Sportowe V3</p>
            </div>
            <span class="rounded-lg bg-white/10 px-2.5 py-1 text-xs font-semibold text-zinc-200">Jarosław</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>