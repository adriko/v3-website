---

---

<section
  id="o-nas"
  class="relative overflow-hidden border-b border-v3-border ambient-glow-lime py-8 sm:py-12 lg:py-16"
>
  <!-- Subtelne poświaty tła -->
  <div
    class="pointer-events-none absolute -top-32 -left-32 h-96 w-96 rounded-full bg-v3-lime/10 blur-[130px]"
  >
  </div>
  <div
    class="pointer-events-none absolute top-1/4 right-0 h-96 w-96 rounded-full bg-v3-red/10 blur-[120px]"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 items-center gap-6 sm:gap-8 lg:grid-cols-12 lg:gap-x-12"
    >
      <!-- Lewa kolumna: Identyfikacja + H1 -->
      <div class="order-1 lg:col-span-7">
        <div class="flex items-center gap-2.5">
          <span
            class="h-4 w-1 rounded-full bg-v3-lime shadow-[0_0_10px_rgba(200,255,0,0.6)]"
          ></span>
          <div
            class="flex items-baseline font-display text-xl sm:text-2xl font-extrabold uppercase tracking-wider leading-none"
          >
            <span class="text-v3-lime">V3</span>
            <span class="ml-0.5 font-semibold text-white">KLUB</span>
          </div>
          <span class="text-zinc-600">•</span>
          <span
            class="text-xs sm:text-sm font-bold uppercase tracking-wider text-zinc-300"
          >
            Centrum Sportowe
          </span>
        </div>

        <h1
          class="mt-3 flex flex-col font-display text-5xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-6xl lg:text-7xl"
        >
          <span class="text-white">Siłownia</span>
          <span class="text-v3-lime">Fitness</span>
          <span class="text-v3-red">Fight Zone</span>
        </h1>

        <p
          class="mt-4 max-w-2xl text-sm sm:text-base leading-normal text-zinc-300"
        >
          Nowoczesne, dwupoziomowe centrum sportowe w Jarosławiu. Na dwóch
          piętrach znajdziesz strefę maszyn Bodytone i wolnych ciężarów, salę
          fitness, kameralną Strefę Kobiet oraz sekcję sportów walki z
          pełnowymiarowym ringiem. Trenuj bez ograniczeń dzięki <strong
            class="font-semibold text-white"
            >samoobsługowemu wejściu 5:00 – 24:00</strong
          > przez smartfon lub przy wsparciu naszej recepcji.
        </p>

        <!-- Przyciski CTA -->
        <div
          class="mt-6 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-3"
        >
          <a
            href="#cennik"
            class="inline-flex w-full sm:w-auto items-center justify-center rounded-xl bg-v3-lime px-6 py-3.5 text-sm font-bold uppercase tracking-wider text-black transition hover:bg-v3-lime-hover shadow-[0_0_20px_rgba(200,255,0,0.25)]"
          >
            Sprawdź karnety
          </a>

          <div
            class="grid grid-cols-2 gap-2.5 sm:flex sm:items-center sm:gap-3"
          >
            <a
              href="#grafik"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-700 bg-v3-surface px-4 py-3.5 sm:px-5 text-sm font-bold uppercase tracking-wider text-zinc-100 transition hover:border-v3-lime/50 hover:text-v3-lime"
            >
              <svg
                class="h-4 w-4 text-v3-lime shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
              <span>Grafik zajęć</span>
            </a>

            <a
              href="tel:+48788463717"
              aria-label="Zadzwoń do klubu V3: 788 463 717"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-700 bg-v3-surface px-4 py-3.5 sm:px-5 text-sm font-bold uppercase tracking-wider text-zinc-100 transition hover:border-v3-lime/50 hover:text-white"
            >
              <svg
                class="h-4 w-4 text-v3-lime shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
              <span>Zadzwoń</span>
            </a>
          </div>
        </div>

        <!-- Dolny pasek statystyk -->
        <div
          class="mt-6 sm:mt-8 grid grid-cols-3 gap-2 border-t border-v3-border pt-4 sm:pt-5 sm:gap-6"
        >
          <div>
            <span
              class="block font-display text-2xl font-bold uppercase leading-none text-v3-lime whitespace-nowrap sm:text-3xl"
            >
              5:00 – 24:00
            </span>
            <span class="mt-1 block text-xs font-medium text-zinc-300"
              >Wejście na kod QR</span
            >
          </div>
          <div>
            <span
              class="block font-display text-2xl font-bold uppercase leading-none text-v3-red whitespace-nowrap sm:text-3xl"
            >
              FIGHT ZONE
            </span>
            <span class="mt-1 block text-xs font-medium text-zinc-300"
              >Mata &amp; ring</span
            >
          </div>
          <div>
            <span
              class="block font-display text-2xl font-bold uppercase leading-none text-white whitespace-nowrap sm:text-3xl"
            >
              CROSS W CENIE
            </span>
            <span class="mt-1 block text-xs font-medium text-zinc-300"
              >W każdym karnecie</span
            >
          </div>
        </div>
      </div>

      <!-- Prawa kolumna: Zdjęcie lokalu -->
      <div class="order-2 lg:col-span-5">
        <div
          class="relative overflow-hidden rounded-2xl border border-v3-border bg-v3-surface shadow-2xl"
        >
          <img
            src="/images/v3-gym-brick.jpeg"
            alt="Wnętrze V3 Klub Jarosław - strefa cardio i logo na cegle"
            width="800"
            height="600"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-56 w-full object-cover sm:h-72 lg:h-[420px]"
          />
          <div
            class="absolute inset-0 bg-linear-to-t from-v3-dark via-v3-dark/20 to-transparent"
          >
          </div>
          <div
            class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 flex items-center justify-between gap-2 rounded-xl border border-white/10 bg-v3-dark/90 px-3 py-2.5 sm:p-4 backdrop-blur-md"
          >
            <div>
              <span
                class="block text-[11px] font-bold uppercase tracking-wider text-v3-lime"
              >
                Dwa Piętra Treningu • Bodytone
              </span>
              <p
                class="mt-0.5 font-display text-lg sm:text-xl font-bold uppercase leading-none text-white whitespace-nowrap"
              >
                Centrum Sportowe V3
              </p>
            </div>
            <span
              class="shrink-0 rounded-lg bg-white/10 px-2.5 py-1 text-xs font-semibold text-zinc-200"
            >
              Jarosław
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Pasek udogodnień klubu -->
    <div
      class="mt-10 sm:mt-12 pt-8 border-t border-v3-border grid grid-cols-1 sm:grid-cols-3 gap-3.5 sm:gap-5 lg:gap-6"
    >
      <div
        class="group flex items-center gap-4 rounded-2xl border border-v3-border bg-v3-surface/60 p-4 sm:p-5 backdrop-blur-sm transition-all duration-300 hover:border-v3-lime/40 hover:bg-v3-surface/90"
      >
        <div
          class="w-12 h-12 rounded-xl bg-v3-card border border-v3-border flex items-center justify-center shrink-0 text-v3-lime group-hover:border-v3-lime/50 group-hover:bg-v3-lime/10 transition-all"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect
              x="3"
              y="3"
              width="18"
              height="18"
              rx="5"
              stroke="currentColor"></rect>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 17V7h4.5a3 3 0 010 6H9"></path>
          </svg>
        </div>
        <div>
          <span
            class="block font-display text-base sm:text-lg font-bold uppercase tracking-wider text-white group-hover:text-v3-lime transition-colors leading-tight"
          >
            Parking dla Klubowiczów
          </span>
          <span class="text-xs text-zinc-400 mt-1 block leading-snug">
            Własne miejsca parkingowe bezpośrednio pod klubem
          </span>
        </div>
      </div>

      <div
        class="group flex items-center gap-4 rounded-2xl border border-v3-border bg-v3-surface/60 p-4 sm:p-5 backdrop-blur-sm transition-all duration-300 hover:border-v3-lime/40 hover:bg-v3-surface/90"
      >
        <div
          class="w-12 h-12 rounded-xl bg-v3-card border border-v3-border flex items-center justify-center shrink-0 text-v3-lime group-hover:border-v3-lime/50 group-hover:bg-v3-lime/10 transition-all"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 4h6a5 5 0 015 5v2.5"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 11.5h9l-1.2 3h-6.6l-1.2-3z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 18v2M15 18v2M18 18v2M13.5 15.5v1M16.5 15.5v1"></path>
          </svg>
        </div>
        <div>
          <span
            class="block font-display text-base sm:text-lg font-bold uppercase tracking-wider text-white group-hover:text-v3-lime transition-colors leading-tight"
          >
            Szatnie &amp; Prysznice
          </span>
          <span class="text-xs text-zinc-400 mt-1 block leading-snug">
            Przestronne, czyste szatnie z pełnym węzłem sanitarnym
          </span>
        </div>
      </div>

      <div
        class="group flex items-center gap-4 rounded-2xl border border-v3-border bg-v3-surface/60 p-4 sm:p-5 backdrop-blur-sm transition-all duration-300 hover:border-v3-lime/40 hover:bg-v3-surface/90"
      >
        <div
          class="w-12 h-12 rounded-xl bg-v3-card border border-v3-border flex items-center justify-center shrink-0 text-v3-lime group-hover:border-v3-lime/50 group-hover:bg-v3-lime/10 transition-all"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M7 8h10l-1.2 11.5a2 2 0 01-2 1.5H10.2a2 2 0 01-2-1.5L7 8z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 5h12v3H6V5z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 2h4v3h-4V2z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 12v5M10 14.5h4"></path>
          </svg>
        </div>
        <div>
          <span
            class="block font-display text-base sm:text-lg font-bold uppercase tracking-wider text-white group-hover:text-v3-lime transition-colors leading-tight"
          >
            FitBar z Odżywkami
          </span>
          <span class="text-xs text-zinc-400 mt-1 block leading-snug">
            Napoje izotoniczne, shake'i białkowe i batony
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
