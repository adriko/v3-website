---

---

<section
  id="o-nas"
  class="relative overflow-hidden border-b border-v3-border ambient-glow-lime py-6 sm:py-14 lg:py-20"
>
  <!-- Poświaty tła -->
  <div
    class="pointer-events-none absolute -top-32 -left-32 h-112.5 w-112.5 rounded-full bg-v3-lime/10 blur-[130px]"
  >
  </div>
  <div
    class="pointer-events-none absolute top-1/3 right-0 h-96 w-96 rounded-full bg-v3-red/10 blur-[120px]"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <div
      class="grid grid-cols-1 items-center gap-5 sm:gap-8 lg:grid-cols-12 lg:gap-x-12 lg:gap-y-6"
    >
      <!-- CZĘŚĆ 1 (order-1): Typografia Logo + Nagłówek H1 -->
      <div class="order-1 lg:col-span-7 lg:self-end">
        <div class="flex items-center gap-2.5">
          <span
            class="h-5 w-1 rounded-full bg-v3-lime shadow-[0_0_10px_rgba(200,255,0,0.6)]"
          ></span>
          <div
            class="flex items-baseline font-['Rajdhani'] text-xl sm:text-2xl font-extrabold uppercase tracking-wider leading-none"
          >
            <span class="text-v3-lime">V3</span>
            <span class="ml-0.5 font-semibold text-white">KLUB</span>
          </div>
          <span class="text-zinc-600">•</span>
          <span
            class="text-xs sm:text-sm font-bold uppercase tracking-widest text-zinc-300"
          >
            Centrum Sportowe
          </span>
        </div>

        <h1
          class="mt-2.5 sm:mt-3 flex flex-col font-['Teko'] text-5xl font-extrabold uppercase leading-[0.92] tracking-tight sm:text-7xl lg:text-8xl"
        >
          <span class="text-white">Siłownia</span>
          <span class="text-v3-lime">Fitness</span>
          <span class="text-v3-red">Fight Zone</span>
        </h1>
      </div>

      <!-- CZĘŚĆ 2 (order-2): Zdjęcie z cegłą -->
      <div class="order-2 lg:col-span-5 lg:row-span-2 lg:self-center">
        <div
          class="relative overflow-hidden rounded-2xl border border-v3-border bg-v3-surface shadow-2xl"
        >
          <img
            src="/images/v3-gym-brick.jpeg"
            alt="Wnętrze V3 Klub Jarosław - strefa cardio i logo na cegle"
            width="800"
            height="600"
            fetchpriority="high"
            decoding="async"
            class="h-52 w-full object-cover sm:h-72 lg:h-120"
          />
          <div
            class="absolute inset-0 bg-linear-to-t from-v3-dark via-v3-dark/20 to-transparent"
          >
          </div>
          <div
            class="absolute bottom-2.5 left-2.5 right-2.5 sm:bottom-4 sm:left-4 sm:right-4 flex items-center justify-between gap-2 rounded-xl border border-white/10 bg-v3-dark/85 px-3 py-2.5 sm:p-4 backdrop-blur-md"
          >
            <div>
              <span
                class="block text-[10px] sm:text-xs font-bold uppercase tracking-wider text-v3-lime"
              >
                Dwa Piętra Treningu • Bodytone
              </span>
              <p
                class="mt-0.5 font-['Teko'] text-lg sm:text-2xl font-bold uppercase leading-none text-white whitespace-nowrap"
              >
                Centrum Sportowe V3
              </p>
            </div>
            <span
              class="shrink-0 rounded-lg bg-white/10 px-2.5 py-1 text-xs font-semibold text-zinc-200"
            >
              Jarosław
            </span>
          </div>
        </div>
      </div>

      <!-- CZĘŚĆ 3 (order-3): Krótki opis + Przyciski CTA + Statystyki -->
      <div class="order-3 lg:col-span-7 lg:self-start">
        <p class="max-w-2xl text-sm sm:text-lg leading-relaxed text-zinc-300">
          Nowoczesne, dwupoziomowe centrum sportowe w Jarosławiu. Na dwóch
          piętrach znajdziesz strefę maszyn Bodytone i wolnych ciężarów, salę
          fitness, kameralną Strefę Kobiet oraz sekcję sportów walki z
          pełnowymiarowym ringiem. Trenuj bez ograniczeń dzięki <strong
            class="font-semibold text-white"
            >samoobsługowemu wejściu 5:00 – 24:00</strong
          > przez smartfon lub przy wsparciu naszej recepcji.
        </p>

        <!-- Przyciski CTA: Sprawdź karnety | Grafik zajęć | Zadzwoń -->
        <div
          class="mt-5 flex flex-col gap-2.5 sm:mt-8 sm:flex-row sm:flex-wrap sm:items-center sm:gap-3"
        >
          <a
            href="#cennik"
            class="inline-flex w-full sm:w-auto items-center justify-center rounded-xl bg-v3-lime px-6 py-3.5 text-sm font-bold uppercase tracking-wider text-black transition hover:bg-v3-lime-hover shadow-[0_0_25px_rgba(200,255,0,0.3)]"
          >
            Sprawdź karnety
          </a>

          <div
            class="grid grid-cols-2 gap-2.5 sm:flex sm:items-center sm:gap-3"
          >
            <a
              href="#grafik"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-v3-surface px-4 py-3.5 sm:px-5 text-sm font-bold uppercase tracking-wider text-zinc-100 transition hover:border-v3-lime/50 hover:text-v3-lime"
            >
              <svg
                class="h-4 w-4 text-v3-lime shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
              <span>Grafik zajęć</span>
            </a>

            <a
              href="tel:+48788463717"
              aria-label="Zadzwoń do klubu V3: 788 463 717"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-v3-surface px-4 py-3.5 sm:px-5 text-sm font-bold uppercase tracking-wider text-zinc-100 transition hover:border-v3-lime/50 hover:text-white"
            >
              <svg
                class="h-4 w-4 text-v3-lime shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
              <span>Zadzwoń</span>
            </a>
          </div>
        </div>

        <!-- Dolny pasek statystyk -->
        <div
          class="mt-6 sm:mt-8 grid grid-cols-3 gap-2 border-t border-v3-border pt-4 sm:pt-5 sm:gap-6"
        >
          <div>
            <span
              class="block font-['Teko'] text-xl font-bold uppercase leading-none text-v3-lime whitespace-nowrap sm:text-3xl"
            >
              5:00 – 24:00
            </span>
            <span
              class="mt-1 block text-[11px] font-medium text-zinc-300 sm:text-sm"
              >Wejście na kod QR</span
            >
          </div>
          <div>
            <span
              class="block font-['Teko'] text-xl font-bold uppercase leading-none text-v3-red whitespace-nowrap sm:text-3xl"
            >
              FIGHT ZONE
            </span>
            <span
              class="mt-1 block text-[11px] font-medium text-zinc-300 sm:text-sm"
              >Mata &amp; ring</span
            >
          </div>
          <div>
            <span
              class="block font-['Teko'] text-xl font-bold uppercase leading-none text-white whitespace-nowrap sm:text-3xl"
            >
              CROSS W CENIE
            </span>
            <span
              class="mt-1 block text-[11px] font-medium text-zinc-300 sm:text-sm"
              >W każdym karnecie</span
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Pasek udogodnień klubu (Parking, Szatnie, FitBar) ze spójnymi wektorami SVG -->
    <div
      class="mt-10 sm:mt-14 pt-8 sm:pt-10 border-t border-v3-border/80 grid grid-cols-1 sm:grid-cols-3 gap-3.5 sm:gap-5 lg:gap-6"
    >
      <!-- 1. Parking -->
      <div
        class="group flex items-center gap-4 rounded-2xl border border-v3-border bg-v3-surface/60 p-4 sm:p-5 backdrop-blur-sm transition-all duration-300 hover:border-v3-lime/40 hover:bg-v3-surface/90"
      >
        <div
          class="w-12 h-12 rounded-xl bg-v3-card border border-v3-border flex items-center justify-center shrink-0 text-v3-lime group-hover:border-v3-lime/50 group-hover:bg-v3-lime/10 group-hover:shadow-[0_0_15px_rgba(200,255,0,0.2)] transition-all"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect
              x="3"
              y="3"
              width="18"
              height="18"
              rx="5"
              stroke="currentColor"></rect>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 17V7h4.5a3 3 0 010 6H9"></path>
          </svg>
        </div>
        <div>
          <span
            class="block font-['Rajdhani'] text-base sm:text-lg font-bold uppercase tracking-wider text-white group-hover:text-v3-lime transition-colors leading-tight"
          >
            Parking dla Klubowiczów
          </span>
          <span class="text-xs text-zinc-400 mt-0.5 block leading-snug">
            Własne miejsca parkingowe bezpośrednio pod klubem
          </span>
        </div>
      </div>

      <!-- 2. Szatnie i prysznice -->
      <div
        class="group flex items-center gap-4 rounded-2xl border border-v3-border bg-v3-surface/60 p-4 sm:p-5 backdrop-blur-sm transition-all duration-300 hover:border-v3-lime/40 hover:bg-v3-surface/90"
      >
        <div
          class="w-12 h-12 rounded-xl bg-v3-card border border-v3-border flex items-center justify-center shrink-0 text-v3-lime group-hover:border-v3-lime/50 group-hover:bg-v3-lime/10 group-hover:shadow-[0_0_15px_rgba(200,255,0,0.2)] transition-all"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 4h6a5 5 0 015 5v2.5"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 11.5h9l-1.2 3h-6.6l-1.2-3z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 18v2M15 18v2M18 18v2M13.5 15.5v1M16.5 15.5v1"></path>
          </svg>
        </div>
        <div>
          <span
            class="block font-['Rajdhani'] text-base sm:text-lg font-bold uppercase tracking-wider text-white group-hover:text-v3-lime transition-colors leading-tight"
          >
            Szatnie &amp; Prysznice
          </span>
          <span class="text-xs text-zinc-400 mt-0.5 block leading-snug">
            Przestronne, czyste szatnie z pełnym węzłem sanitarnym
          </span>
        </div>
      </div>

      <!-- 3. FitBar -->
      <div
        class="group flex items-center gap-4 rounded-2xl border border-v3-border bg-v3-surface/60 p-4 sm:p-5 backdrop-blur-sm transition-all duration-300 hover:border-v3-lime/40 hover:bg-v3-surface/90"
      >
        <div
          class="w-12 h-12 rounded-xl bg-v3-card border border-v3-border flex items-center justify-center shrink-0 text-v3-lime group-hover:border-v3-lime/50 group-hover:bg-v3-lime/10 group-hover:shadow-[0_0_15px_rgba(200,255,0,0.2)] transition-all"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M7 8h10l-1.2 11.5a2 2 0 01-2 1.5H10.2a2 2 0 01-2-1.5L7 8z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 5h12v3H6V5z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 2h4v3h-4V2z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 12v5M10 14.5h4"></path>
          </svg>
        </div>
        <div>
          <span
            class="block font-['Rajdhani'] text-base sm:text-lg font-bold uppercase tracking-wider text-white group-hover:text-v3-lime transition-colors leading-tight"
          >
            FitBar z Odżywkami
          </span>
          <span class="text-xs text-zinc-400 mt-0.5 block leading-snug">
            Napoje izotoniczne, shake'i białkowe i batony
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
