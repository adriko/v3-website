---
---

<section id="o-nas" class="relative overflow-hidden border-b border-white/10 py-8 sm:py-14 lg:py-24">
  <!-- Poświaty tła -->
  <div class="pointer-events-none absolute -top-32 -left-32 h-96 w-96 rounded-full bg-v3-lime/10 blur-3xl"></div>
  <div class="pointer-events-none absolute top-1/3 right-0 h-96 w-96 rounded-full bg-v3-red/10 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-x-12 lg:gap-y-8">
      
      <!-- CZĘŚĆ 1 (order-1): Belka lokalizacji + Typografia Logo + Nagłówek H1 -->
      <div class="order-1 lg:col-span-7 lg:self-end">
        <!-- Pigułka lokalizacji -->
        <div class="inline-flex items-center gap-2 rounded-full border border-v3-lime/30 bg-v3-lime/10 px-3.5 py-1 text-[11px] sm:text-xs font-bold uppercase tracking-wider text-v3-lime">
          <span class="h-2 w-2 rounded-full bg-v3-lime"></span>
          Jarosław • Poniatowskiego 24 • Od wiosny 2025
        </div>

        <!-- Napis w stylu logo -->
        <div class="mt-4 flex items-center gap-2.5">
          <span class="h-5 w-1 rounded-full bg-v3-lime shadow-[0_0_10px_rgba(200,255,0,0.6)]"></span>
          <div class="flex items-baseline font-['Rajdhani'] text-xl sm:text-2xl font-extrabold uppercase tracking-wider leading-none">
            <span class="text-v3-lime">V3</span>
            <span class="ml-0.5 font-semibold text-white">KLUB</span>
          </div>
          <span class="text-zinc-600">•</span>
          <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-zinc-300">
            Centrum Sportowe
          </span>
        </div>

        <!-- Główny nagłówek H1 -->
        <h1 class="mt-2 flex flex-col font-['Teko'] text-5xl font-extrabold uppercase leading-[0.92] tracking-tight sm:text-7xl lg:text-8xl">
          <span class="text-white">Siłownia</span>
          <span class="text-v3-lime">Fitness</span>
          <span class="text-v3-red">Fight Zone</span>
        </h1>
      </div>

      <!-- CZĘŚĆ 2 (order-2): Zdjęcie z cegłą (na smartfonie wskakuje zaraz pod H1) -->
      <div class="order-2 lg:col-span-5 lg:row-span-2 lg:self-center">
        <div class="relative overflow-hidden rounded-2xl border border-white/15 bg-zinc-900 shadow-2xl">
          <img
            src="/images/v3-gym-brick.jpeg"
            alt="Wnętrze V3 Klub Jarosław - strefa cardio i logo na cegle"
            width="800"
            height="600"
            fetchpriority="high"
            decoding="async"
            class="h-64 w-full object-cover sm:h-80 lg:h-[520px]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>
          <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 flex items-center justify-between gap-2 rounded-xl border border-white/10 bg-zinc-950/85 px-3.5 py-3 sm:p-4 backdrop-blur-md">
            <div>
              <span class="block text-[10px] sm:text-xs font-bold uppercase tracking-wider text-v3-lime">
                Dwa Piętra Sportu • Maszyny Bodytone
              </span>
              <p class="mt-0.5 font-['Teko'] text-xl sm:text-2xl font-bold uppercase leading-none text-white whitespace-nowrap">
                Centrum Sportowe V3
              </p>
            </div>
            <span class="shrink-0 rounded-lg bg-white/10 px-2.5 py-1 text-xs font-semibold text-zinc-200">
              Jarosław
            </span>
          </div>
        </div>
      </div>

      <!-- CZĘŚĆ 3 (order-3): Pełny, dopracowany opis w nowoczesnej karcie + Kafelki atutów + CTA -->
      <div class="order-3 lg:col-span-7 lg:self-start">
        
        <!-- Nowoczesna Karta Opisu Klubu (Z pionowym neonowym akcentem po lewej) -->
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-zinc-900/50 p-5 sm:p-6 backdrop-blur-sm shadow-xl">
          <!-- Pionowy gradientowy pasek (limonka -> biel -> czerwień) -->
          <div class="absolute left-0 top-3 bottom-3 w-1.5 rounded-r-full bg-gradient-to-b from-v3-lime via-white/40 to-v3-red shadow-[0_0_12px_rgba(200,255,0,0.4)]"></div>

          <div class="pl-2.5 sm:pl-3 space-y-3.5 text-sm sm:text-base leading-relaxed text-zinc-300">
            <p>
              <strong class="font-bold text-white">V3 Klub</strong> to nowoczesne, <strong class="font-semibold text-white">dwupoziomowe centrum sportowe</strong> w Jarosławiu, które stworzyliśmy wiosną 2025 roku z autentycznej pasji do treningu siłowego, formy i sportów walki. Na dwóch piętrach połączyliśmy w pełni wyposażoną siłownię maszyn i wolnych ciężarów, sale fitness, kameralną Strefę Kobiet oraz profesjonalną strefę walk z pełnowymiarowym ringiem. Sekcję sportów walki rozwijamy ramię w ramię z <strong class="font-semibold text-v3-red">Klubem Sportów Walki Sokół Jarosław</strong>, prowadząc bezpieczne treningi dla każdego pokolenia — od przedszkolaków stawiających pierwsze kroki, po dorosłych i kadrę zawodniczą.
            </p>
            <p>
              Trenuj dokładnie tak, jak lubisz. Dzięki aplikacji w smartfonie wchodzisz autonomicznie od <strong class="font-bold text-v3-lime">5:00 rano do północy</strong>, a w ciągu dnia w recepcji zawsze spotkasz uśmiechniętą ekipę, która chętnie odpowie na każde pytanie i wprowadzi Cię w świat klubu. Na miejscu czekają na Ciebie nowoczesne szatnie z prysznicami oraz <strong class="font-semibold text-white">duży, prywatny parking wyłącznie dla klubowiczów</strong> — z <span class="inline-flex items-center gap-1 rounded bg-amber-400/10 border border-amber-400/25 px-1.5 py-0.5 text-xs text-amber-300 font-semibold align-baseline">📦 Paczkomatem</span> pod ręką, aby połączyć dobry trening z codziennymi sprawami.
            </p>
          </div>
        </div>

        <!-- 4 Wyróżniki z mikro-ikonami SVG -->
        <div class="mt-5 grid grid-cols-2 gap-2.5 sm:grid-cols-4 sm:gap-3">
          <div class="flex items-center gap-2.5 rounded-xl border border-white/10 bg-zinc-900/60 p-2.5 transition hover:border-v3-lime/30">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-v3-lime/10 text-v3-lime font-bold text-xs">
              2P
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-bold uppercase tracking-wider text-white truncate">2 Piętra</span>
              <span class="block text-[11px] text-zinc-400 truncate">Siłownia &amp; ring</span>
            </div>
          </div>

          <div class="flex items-center gap-2.5 rounded-xl border border-white/10 bg-zinc-900/60 p-2.5 transition hover:border-v3-red/30">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-v3-red/10 text-v3-red font-bold text-xs">
              🥊
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-bold uppercase tracking-wider text-white truncate">KSW Sokół</span>
              <span class="block text-[11px] text-zinc-400 truncate">Sekcja walki</span>
            </div>
          </div>

          <div class="flex items-center gap-2.5 rounded-xl border border-white/10 bg-zinc-900/60 p-2.5 transition hover:border-white/20">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/10 text-zinc-200 font-bold text-xs">
              👋
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-bold uppercase tracking-wider text-white truncate">Recepcja</span>
              <span class="block text-[11px] text-zinc-400 truncate">Zawsze pomoże</span>
            </div>
          </div>

          <div class="flex items-center gap-2.5 rounded-xl border border-white/10 bg-zinc-900/60 p-2.5 transition hover:border-amber-400/30">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-amber-400/10 text-amber-300 font-bold text-xs">
              🚗
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-bold uppercase tracking-wider text-white truncate">Parking</span>
              <span class="block text-[11px] text-zinc-400 truncate">+ Paczkomat</span>
            </div>
          </div>
        </div>

        <!-- Przyciski CTA -->
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a
            href="#cennik"
            class="inline-flex w-full sm:w-auto items-center justify-center rounded-xl bg-v3-lime px-6 py-3.5 text-sm font-bold uppercase tracking-wider text-black transition hover:bg-v3-lime-hover shadow-[0_0_25px_rgba(200,255,0,0.3)]"
          >
            Sprawdź karnety
          </a>
          <div class="grid grid-cols-2 gap-3 sm:flex sm:items-center">
            <a
              href="#fight-zone"
              class="inline-flex items-center justify-center rounded-xl border border-v3-red/40 bg-v3-red/10 px-4 py-3.5 sm:px-5 text-sm font-bold uppercase tracking-wider text-v3-red transition hover:bg-v3-red/20"
            >
              Fight Zone
            </a>
            <a
              href="tel:+48788463717"
              aria-label="Zadzwoń do klubu V3: 788 463 717"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-zinc-900/90 px-4 py-3.5 sm:px-5 text-sm font-bold uppercase tracking-wider text-zinc-100 transition hover:border-v3-lime/40 hover:text-white"
            >
              <svg class="h-4 w-4 text-v3-lime shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>Zadzwoń</span>
            </a>
          </div>
        </div>

        <!-- Dolny pasek statystyk -->
        <div class="mt-8 grid grid-cols-3 gap-2 border-t border-white/10 pt-5 sm:gap-6">
          <div>
            <span class="block font-['Teko'] text-xl font-bold uppercase leading-none text-v3-lime whitespace-nowrap sm:text-3xl">
              5:00 – 24:00
            </span>
            <span class="mt-1 block text-[11px] font-medium text-zinc-300 sm:text-sm">Wejście na kod QR</span>
          </div>
          <div>
            <span class="block font-['Teko'] text-xl font-bold uppercase leading-none text-v3-red whitespace-nowrap sm:text-3xl">
              FIGHT ZONE
            </span>
            <span class="mt-1 block text-[11px] font-medium text-zinc-300 sm:text-sm">Mata &amp; ring KSW</span>
          </div>
          <div>
            <span class="block font-['Teko'] text-xl font-bold uppercase leading-none text-white whitespace-nowrap sm:text-3xl">
              CROSS W CENIE
            </span>
            <span class="mt-1 block text-[11px] font-medium text-zinc-300 sm:text-sm">W każdym karnecie</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>