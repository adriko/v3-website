---
import Logo from "./Logo.astro";
---

<section
  class="relative pt-6 pb-12 lg:pt-12 lg:pb-16 overflow-hidden border-b border-zinc-800/80"
>
  <!-- Subtle Background Glow & Grid -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,var(--tw-gradient-stops))] from-red-950/25 via-zinc-950 to-zinc-950 pointer-events-none"
  >
  </div>
  <div
    class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNDAiIGhlaWdodD0iNDAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMSIgY3k9IjEiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wMykiLz48L3N2Zz4=')] pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- 1. Nagłówek i odznaka V3 (Na mobile pierwsze, na desktopie lewa górna kolumna) -->
      <div class="lg:col-span-7 order-1">
        <div
          class="inline-flex items-center gap-3 px-3.5 py-2 rounded-xl bg-zinc-900/90 border border-zinc-800 mb-5 shadow-inner"
        >
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          <Logo size="sm" />
          <span class="text-zinc-600">•</span>
          <span
            class="text-xs font-mono uppercase tracking-wide text-zinc-300 font-semibold"
            >Centrum Sportowe</span
          >
        </div>

        <h1
          class="font-heading text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight uppercase leading-[1.06] text-white"
        >
          <span class="block">Siłownia</span>
          <span class="block text-zinc-200">Fitness</span>
          <span
            class="block text-transparent bg-clip-text bg-linear-to-r from-red-500 via-red-600 to-orange-500"
          >
            Fight Zone
          </span>
        </h1>
      </div>

      <!-- 2. Zdjęcie Klubu (Na mobile drugie - zaraz pod tytułem, na desktopie prawa kolumna przez 2 wiersze) -->
      <div class="lg:col-span-5 lg:row-span-2 order-2">
        <div
          class="relative rounded-2xl overflow-hidden border border-zinc-800 bg-zinc-900 shadow-2xl group"
        >
          <img
            src="/images/v3-gym-brick.jpeg"
            alt="Wnętrze V3 Klub Jarosław - strefa cardio i logo na cegle"
            class="w-full h-65 sm:h-90 lg:h-120 object-cover object-center group-hover:scale-103 transition-transform duration-500"
            width="800"
            height="600"
            fetchpriority="high"
            decoding="async"
          />
          <div
            class="absolute inset-0 bg-linear-to-t from-zinc-950 via-zinc-950/20 to-transparent"
          >
          </div>

          <!-- Podpis na zdjęciu -->
          <div
            class="absolute bottom-3 left-3 right-3 p-3.5 rounded-xl bg-zinc-950/90 backdrop-blur-md border border-zinc-800/80 flex items-center justify-between gap-3"
          >
            <div>
              <span
                class="text-[11px] font-mono uppercase tracking-wide text-red-400 block font-bold"
                >Dwa Piętra Treningu • Bodytone</span
              >
              <p class="text-white font-bold text-xs sm:text-sm">
                Centrum Sportowe V3
              </p>
            </div>
            <span
              class="px-2.5 py-1 rounded bg-red-600/20 border border-red-500/30 text-red-300 font-mono text-xs font-bold shrink-0"
            >
              Jarosław
            </span>
          </div>
        </div>
      </div>

      <!-- 3. Opis, CTA i kluczowe atuty (Na mobile trzecie - pod zdjęciem, na desktopie lewa dolna kolumna) -->
      <div class="lg:col-span-7 order-3">
        <p
          class="text-base sm:text-lg text-zinc-300 max-w-2xl mb-6 leading-relaxed font-normal"
        >
          Nowoczesne, dwupoziomowe centrum sportowe w Jarosławiu. Na dwóch
          piętrach znajdziesz strefę maszyn Bodytone i wolnych ciężarów, salę
          fitness, kameralną Strefę Kobiet oraz sekcję sportów walki z
          pełnowymiarowym ringiem. Trenuj bez ograniczeń dzięki <strong
            class="text-white font-semibold"
            >samoobsługowemu wejściu 5:00 – 24:00</strong
          > przez smartfon lub przy wsparciu naszej recepcji.
        </p>

        <!-- Przyciski CTA -->
        <div
          class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-7"
        >
          <a
            href="#cennik"
            class="px-7 py-4 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-sm uppercase tracking-wide transition-all text-center shadow-[0_0_25px_rgba(220,38,38,0.35)] hover:shadow-[0_0_35px_rgba(220,38,38,0.55)] cursor-pointer"
          >
            Sprawdź karnety
          </a>
          <div class="grid grid-cols-2 sm:flex items-center gap-3">
            <a
              href="#grafik"
              class="px-5 py-4 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-100 font-semibold text-sm uppercase tracking-wide border border-zinc-800 hover:border-zinc-700 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <svg
                class="w-4 h-4 text-red-500 shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path></svg
              >
              <span>Grafik zajęć</span>
            </a>
            <a
              href="tel:+48788463717"
              aria-label="Zadzwoń do klubu V3: 788 463 717"
              class="px-5 py-4 rounded-xl bg-zinc-900/70 hover:bg-zinc-800 text-zinc-200 hover:text-white font-mono text-sm border border-zinc-800/80 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <svg
                class="w-4 h-4 text-red-500 shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path></svg
              >
              <span>Zadzwoń</span>
            </a>
          </div>
        </div>

        <!-- 3 Główne Fakty (Kompaktowy pasek) -->
        <div
          class="grid grid-cols-3 gap-2.5 sm:gap-4 pt-5 border-t border-zinc-800/80"
        >
          <div class="bg-zinc-900/40 border border-zinc-800/60 rounded-xl p-3">
            <span
              class="block text-base sm:text-xl font-black text-white font-mono leading-tight"
              >5:00 – 24:00</span
            >
            <span class="text-xs text-zinc-400 mt-1 block"
              >Wejście na kod QR</span
            >
          </div>
          <div class="bg-zinc-900/40 border border-zinc-800/60 rounded-xl p-3">
            <span
              class="block text-base sm:text-xl font-black text-red-500 font-mono leading-tight"
              >FIGHT ZONE</span
            >
            <span class="text-xs text-zinc-400 mt-1 block">Mata & ring</span>
          </div>
          <div class="bg-zinc-900/40 border border-zinc-800/60 rounded-xl p-3">
            <span
              class="block text-base sm:text-xl font-black text-white font-mono leading-tight"
              >CROSS W CENIE</span
            >
            <span class="text-xs text-zinc-400 mt-1 block"
              >W każdym karnecie</span
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Pasek Udogodnień Klubu (Parking, Szatnie, FitBar) -->
    <div
      class="mt-8 pt-6 border-t border-zinc-900 grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4"
    >
      <div
        class="flex items-center gap-3.5 px-4 py-3 rounded-xl bg-zinc-900/30 border border-zinc-800/60"
      >
        <div
          class="w-10 h-10 rounded-lg bg-red-600/10 border border-red-500/20 flex items-center justify-center text-red-500 shrink-0"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 10l2-5h10l2 5M3 10h18v7a1 1 0 01-1 1h-1a1 1 0 01-1-1v-2H6v2a1 1 0 01-1 1H4a1 1 0 01-1-1v-7z"
            ></path>
            <circle cx="7.5" cy="13.5" r="1.5" fill="currentColor"></circle>
            <circle cx="16.5" cy="13.5" r="1.5" fill="currentColor"></circle>
          </svg>
        </div>
        <div>
          <span class="text-white font-bold text-xs sm:text-sm block"
            >Parking dla Klubowiczów</span
          >
          <span class="text-zinc-400 text-xs"
            >Własne miejsca parkingowe bezpośrednio pod klubem</span
          >
        </div>
      </div>

      <div
        class="flex items-center gap-3.5 px-4 py-3 rounded-xl bg-zinc-900/30 border border-zinc-800/60"
      >
        <div
          class="w-10 h-10 rounded-lg bg-red-600/10 border border-red-500/20 flex items-center justify-center text-red-500 shrink-0"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            ></path>
          </svg>
        </div>
        <div>
          <span class="text-white font-bold text-xs sm:text-sm block"
            >Szatnie & Prysznice</span
          >
          <span class="text-zinc-400 text-xs"
            >Przestronne, czyste szatnie z pełnym węzłem sanitarnym</span
          >
        </div>
      </div>

      <div
        class="flex items-center gap-3.5 px-4 py-3 rounded-xl bg-zinc-900/30 border border-zinc-800/60"
      >
        <div
          class="w-10 h-10 rounded-lg bg-red-600/10 border border-red-500/20 flex items-center justify-center text-red-500 shrink-0"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <div>
          <span class="text-white font-bold text-xs sm:text-sm block"
            >FitBar z Odżywkami</span
          >
          <span class="text-zinc-400 text-xs"
            >Napoje izotoniczne, shake'i białkowe i batony</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
