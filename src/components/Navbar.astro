---
import Logo from "./Logo.astro";
---

<header
  class="sticky top-0 z-50 w-full backdrop-blur-md bg-zinc-950/90 border-b border-zinc-800/80"
>
  <!-- Top Info Bar (Godziny, Adres, Karty partnerskie, Social Media) -->
  <div
    class="bg-zinc-900/95 border-b border-zinc-800/60 py-1.5 px-4 text-xs font-mono text-zinc-300 hidden md:block"
  >
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-5">
        <span class="flex items-center gap-2 text-red-400 font-bold">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          SAMOOBSŁUGA 5:00 – 24:00
        </span>
        <span class="text-zinc-600">|</span>
        <span class="text-zinc-300">Wstęp z aplikacją na kod QR</span>
      </div>
      <div class="flex items-center gap-5">
        <span class="text-zinc-200 font-semibold"
          >Poniatowskiego 24, Jarosław</span
        >
        <span class="text-zinc-600">•</span>
        <span class="text-zinc-300">MultiSport • Medicover • FitProfit</span>
        <span class="text-zinc-600">|</span>
        <div class="flex items-center gap-3">
          <a
            href="https://www.facebook.com/V3CentrumSportowe/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="V3 Klub Facebook"
            class="text-zinc-300 hover:text-red-500 transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"
              ><path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path></svg
            >
          </a>
          <a
            href="https://www.instagram.com/v3_klub_jaroslaw/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="V3 Klub Instagram"
            class="text-zinc-300 hover:text-red-500 transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"
              ><path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
              ></path></svg
            >
          </a>
          <a
            href="https://www.tiktok.com/@v3_klub_jaroslaw"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="V3 Klub TikTok"
            class="text-zinc-300 hover:text-red-500 transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"
              ><path
                d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"
              ></path></svg
            >
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 sm:h-20 flex items-center justify-between"
  >
    <a href="#" class="focus:outline-none" aria-label="V3 Klub - Strona główna">
      <Logo size="md" showTagline={false} />
    </a>

    <!-- Desktop Links -->
    <nav
      class="hidden lg:flex items-center gap-6 text-sm font-medium text-zinc-200"
      aria-label="Główna nawigacja"
    >
      <a
        href="#fight-zone"
        class="hover:text-red-500 transition-colors flex items-center gap-1.5 font-semibold text-white"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
        Fight Zone
      </a>
      <a href="#silownia" class="hover:text-white transition-colors"
        >Siłownia & Fitness</a
      >
      <a
        href="#strefa-kobiet"
        class="hover:text-rose-400 transition-colors text-rose-300 font-medium"
        >Strefa Kobiet</a
      >
      <a href="#kadra" class="hover:text-white transition-colors">Trenerzy</a>
      <a href="#cennik" class="hover:text-white transition-colors">Cennik</a>
      <a href="#grafik" class="hover:text-white transition-colors">Grafik</a>
      <a href="#kontakt" class="hover:text-white transition-colors">Kontakt</a>
    </nav>

    <!-- Desktop CTA Buttons -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="tel:+48788463717"
        aria-label="Zadzwoń do recepcji V3 Klub: 788 463 717"
        class="hidden xl:flex items-center gap-2 px-3.5 py-2 rounded-lg border border-zinc-800 hover:border-zinc-700 text-xs font-mono text-zinc-200 transition-all"
      >
        <svg
          class="w-3.5 h-3.5 text-red-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          ></path></svg
        >
        <span>788 463 717</span>
      </a>
      <a
        href="#cennik"
        class="px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-500 text-white font-bold text-xs uppercase tracking-wide transition-all shadow-[0_0_20px_rgba(220,38,38,0.3)] hover:shadow-[0_0_25px_rgba(220,38,38,0.5)] cursor-pointer"
      >
        Kup karnet
      </a>
    </div>

    <!-- Mobile Menu Trigger -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="lg:hidden inline-flex items-center gap-2 p-2 rounded-lg text-zinc-200 hover:text-white hover:bg-zinc-900 border border-zinc-800 transition-colors cursor-pointer"
      aria-label="Otwórz menu nawigacji"
      aria-expanded="false"
    >
      <span class="text-xs font-mono uppercase tracking-wide font-bold pl-1"
        >Menu</span
      >
      <svg
        id="menu-icon-open"
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Backdrop Overlay -->
<div
  id="mobile-backdrop"
  class="fixed inset-0 z-50 bg-black/75 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
>
</div>

<!-- Right Side Slide-Over Drawer (Mobile Navigation) -->
<aside
  id="mobile-drawer"
  class="fixed top-0 right-0 z-50 h-full w-[82vw] max-w-[320px] bg-zinc-950 border-l border-zinc-800 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden flex flex-col justify-between overflow-y-auto"
  aria-label="Menu mobilne"
>
  <div class="p-5">
    <!-- Drawer Header -->
    <div
      class="flex items-center justify-between pb-4 mb-4 border-b border-zinc-800"
    >
      <Logo size="sm" />
      <button
        id="mobile-close-btn"
        type="button"
        class="p-2 rounded-lg text-zinc-400 hover:text-white bg-zinc-900 border border-zinc-800 cursor-pointer"
        aria-label="Zamknij menu"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Navigation Links -->
    <nav class="flex flex-col space-y-1.5">
      <a
        href="#fight-zone"
        class="mobile-link flex items-center gap-3 px-4 py-3 rounded-xl bg-zinc-900/70 hover:bg-zinc-900 text-white font-bold text-base border border-zinc-800/80 transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-red-600 shrink-0"></span>
        <span>Fight Zone</span>
        <span class="text-zinc-500 text-sm ml-auto">&rarr;</span>
      </a>
      <a
        href="#silownia"
        class="mobile-link flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-zinc-900/60 text-zinc-100 font-semibold text-base transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-zinc-700 shrink-0"></span>
        <span>Siłownia & Fitness</span>
        <span class="text-zinc-500 text-sm ml-auto">&rarr;</span>
      </a>
      <a
        href="#strefa-kobiet"
        class="mobile-link flex items-center gap-3 px-4 py-3 rounded-xl bg-rose-950/25 hover:bg-rose-950/40 text-rose-300 font-bold text-base border border-rose-500/20 transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-rose-400 shrink-0"></span>
        <span>Strefa Kobiet</span>
        <span class="text-rose-400 text-sm ml-auto">&rarr;</span>
      </a>
      <a
        href="#kadra"
        class="mobile-link flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-zinc-900/60 text-zinc-100 font-semibold text-base transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-zinc-700 shrink-0"></span>
        <span>Trenerzy</span>
        <span class="text-zinc-500 text-sm ml-auto">&rarr;</span>
      </a>
      <a
        href="#cennik"
        class="mobile-link flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-zinc-900/60 text-zinc-100 font-semibold text-base transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-zinc-700 shrink-0"></span>
        <span>Cennik</span>
        <span class="text-zinc-500 text-sm ml-auto">&rarr;</span>
      </a>
      <a
        href="#grafik"
        class="mobile-link flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-zinc-900/60 text-zinc-100 font-semibold text-base transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-zinc-700 shrink-0"></span>
        <span>Grafik</span>
        <span class="text-zinc-500 text-sm ml-auto">&rarr;</span>
      </a>
      <a
        href="#kontakt"
        class="mobile-link flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-zinc-900/60 text-zinc-100 font-semibold text-base transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-zinc-700 shrink-0"></span>
        <span>Kontakt</span>
        <span class="text-zinc-500 text-sm ml-auto">&rarr;</span>
      </a>
    </nav>
  </div>

  <!-- Drawer Footer -->
  <div class="p-5 border-t border-zinc-900 bg-zinc-900/30 space-y-3">
    <div class="flex items-center justify-center gap-4 pb-2">
      <a
        href="https://www.facebook.com/V3CentrumSportowe/"
