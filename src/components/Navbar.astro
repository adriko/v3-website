---
import Logo from './Logo.astro';

const navLinks = [
  { name: 'O klubie', href: '#o-nas', dot: 'bg-v3-lime', hover: 'hover:text-v3-lime' },
  { name: 'Fight Zone', href: '#fight-zone', dot: 'bg-v3-red', hover: 'hover:text-v3-red' },
  { name: 'Siłownia & Fitness', href: '#silownia', dot: 'bg-v3-lime', hover: 'hover:text-v3-lime' },
  { name: 'Strefa Kobiet', href: '#strefa-kobiet', dot: 'bg-pink-400', hover: 'hover:text-pink-400' },
  { name: 'Cennik', href: '#cennik', dot: 'bg-v3-lime', hover: 'hover:text-v3-lime' },
  { name: 'Grafik', href: '#grafik', dot: 'bg-v3-lime', hover: 'hover:text-v3-lime' },
  { name: 'Kontakt', href: '#kontakt', dot: 'bg-v3-lime', hover: 'hover:text-v3-lime' },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-v3-dark/90 backdrop-blur-xl">
  <!-- Górny pasek informacyjny + Social Media -->
  <div class="border-b border-white/5 bg-black/70 px-4 py-1.5 text-[11px] sm:text-xs text-zinc-300">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-3">
      <!-- Lewa strona: Godziny i kod QR -->
      <div class="flex items-center gap-2 font-medium">
        <span class="inline-flex items-center gap-1.5 font-semibold text-v3-lime">
          <span class="h-2 w-2 rounded-full bg-v3-lime animate-pulse"></span>
          SAMOOBSŁUGA 5:00 – 24:00
        </span>
        <span class="hidden sm:inline text-zinc-600">|</span>
        <span class="hidden sm:inline text-zinc-300">Wstęp z aplikacją na kod QR</span>
      </div>

      <!-- Prawa strona: Adres + Pakiety + Ikony Social Media -->
      <div class="flex items-center gap-3 text-zinc-300">
        <span class="truncate">Poniatowskiego 24, Jarosław</span>
        <span class="hidden lg:inline text-zinc-600">•</span>
        <span class="hidden lg:inline font-medium text-v3-lime/90">MultiSport • Medicover • FitProfit</span>

        <span class="hidden sm:inline text-zinc-600">|</span>

        <!-- Ikony Social Media -->
        <div class="flex items-center gap-2.5">
          <!-- Facebook -->
          <a
            href="https://www.facebook.com/V3CentrumSportowe/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="V3 Klub Facebook"
            class="text-zinc-400 transition hover:text-v3-lime"
          >
            <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href="https://www.instagram.com/v3_klub_jaroslaw/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="V3 Klub Instagram"
            class="text-zinc-400 transition hover:text-v3-lime"
          >
            <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <!-- TikTok -->
          <a
            href="https://www.tiktok.com/@v3_klub_jaroslaw"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="V3 Klub TikTok"
            class="text-zinc-400 transition hover:text-v3-lime"
          >
            <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Główny pasek nawigacji -->
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 lg:px-8">
    <a href="#" aria-label="V3 Klub - Strona główna" class="group flex items-center">
      <Logo />
    </a>

    <!-- Nawigacja Desktop -->
    <nav aria-label="Główna nawigacja" class="hidden lg:flex items-center gap-6 text-sm font-semibold text-zinc-200">
      {navLinks.map((link) => (
        <a href={link.href} class={`transition-colors ${link.hover}`}>
          {link.name}
        </a>
      ))}
    </nav>

    <!-- Przyciski akcji Desktop -->
    <div class="hidden lg:flex items-center gap-3">
      <a
        href="tel:+48788463717"
        aria-label="Zadzwoń do recepcji V3 Klub: 788 463 717"
        class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-zinc-900/80 px-3.5 py-2 text-sm font-semibold text-zinc-200 transition hover:border-v3-lime/50 hover:text-white"
      >
        <svg class="h-4 w-4 text-v3-lime shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>788 463 717</span>
      </a>
      <a
        href="#cennik"
        class="inline-flex items-center justify-center rounded-xl bg-v3-lime px-4 py-2 text-sm font-bold uppercase tracking-wider text-black transition hover:bg-v3-lime-hover shadow-[0_0_20px_rgba(200,255,0,0.25)]"
      >
        Kup karnet
      </a>
    </div>

    <!-- Przycisk Hamburger Mobile -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Otwórz menu nawigacji"
      aria-expanded="false"
      class="inline-flex lg:hidden items-center justify-center rounded-xl border border-white/15 bg-zinc-900 p-2.5 text-zinc-200 transition hover:border-v3-lime/50 hover:text-v3-lime"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<!-- Tło przysłaniające dla menu mobilnego -->
<div
  id="mobile-backdrop"
  class="fixed inset-0 z-40 hidden bg-black/75 backdrop-blur-sm lg:hidden"
></div>

<!-- Wysuwany panel boczny Mobile -->
<aside
  id="mobile-drawer"
  aria-label="Menu mobilne"
  class="fixed top-0 right-0 z-50 flex h-full w-80 max-w-[85vw] translate-x-full flex-col justify-between border-l border-white/10 bg-v3-dark p-6 transition-transform duration-300 lg:hidden"
>
  <div>
    <div class="flex items-center justify-between border-b border-white/10 pb-4">
      <Logo />
      <button
        id="mobile-close-btn"
        type="button"
        aria-label="Zamknij menu nawigacji"
        class="rounded-xl border border-white/10 p-2 text-zinc-400 hover:text-white"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="mt-6 flex flex-col gap-1.5">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`mobile-link flex items-center gap-3 rounded-xl px-3 py-2.5 text-base font-semibold text-zinc-200 transition hover:bg-white/5 ${link.hover}`}
        >
          <span class={`h-2 w-2 rounded-full ${link.dot}`}></span>
          <span>{link.name}</span>
        </a>
      ))}
    </nav>
  </div>

  <div class="space-y-3 border-t border-white/10 pt-4">
    <!-- Sociale w menu mobilnym -->
    <div class="flex items-center justify-around py-2 border-b border-white/5">
      <a href="https://www.facebook.com/V3CentrumSportowe/" target="_blank" rel="noopener noreferrer" class="p-2 text-zinc-300 hover:text-v3-lime">
        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      <a href="https://www.instagram.com/v3_klub_jaroslaw/" target="_blank" rel="noopener noreferrer" class="p-2 text-zinc-300 hover:text-v3-lime">
        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      </a>
      <a href="https://www.tiktok.com/@v3_klub_jaroslaw" target="_blank" rel="noopener noreferrer" class="p-2 text-zinc-300 hover:text-v3-lime">
        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
      </a>
    </div>

    <a
      href="tel:+48788463717"
      class="flex w-full items-center justify-center gap-2 rounded-xl border border-white/15 bg-zinc-900 py-3 text-sm font-bold text-white transition hover:border-v3-lime"
    >
      <svg class="h-4 w-4 text-v3-lime shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span>Zadzwoń: 788 463 717</span>
    </a>
    <a
      href="https://v3klub.gymmanager.io"
      target="_blank"
      rel="noopener noreferrer"
      class="flex w-full items-center justify-center rounded-xl bg-v3-lime py-3 text-sm font-bold uppercase tracking-wider text-black transition hover:bg-v3-lime-hover"
    >
      Panel Klienta Online →
    </a>
    <p class="text-center text-xs text-zinc-400">
      Samoobsługa 5:00 – 24:00 • ul. Poniatowskiego 24
    </p>
  </div>
</aside>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-close-btn');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('mobile-backdrop');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  function toggleMenu(open: boolean) {
    if (!drawer || !backdrop) return;
    drawer.classList.toggle('translate-x-full', !open);
    backdrop.classList.toggle('hidden', !open);
    menuBtn?.setAttribute('aria-expanded', String(open));
  }

  menuBtn?.addEventListener('click', () => toggleMenu(true));
  closeBtn?.addEventListener('click', () => toggleMenu(false));
  backdrop?.addEventListener('click', () => toggleMenu(false));
  mobileLinks.forEach((link) => link.addEventListener('click', () => toggleMenu(false)));
</script>