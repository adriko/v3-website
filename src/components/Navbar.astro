        rel="noopener noreferrer"
        aria-label="Facebook"
        class="p-2.5 rounded-lg bg-zinc-900 text-zinc-300 hover:text-white border border-zinc-800"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"
          ><path
            d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
          ></path></svg
        >
      </a>
      <a
        href="https://www.instagram.com/v3_klub_jaroslaw/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="p-2.5 rounded-lg bg-zinc-900 text-zinc-300 hover:text-white border border-zinc-800"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"
          ><path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
          ></path></svg
        >
      </a>
      <a
        href="https://www.tiktok.com/@v3_klub_jaroslaw"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="TikTok"
        class="p-2.5 rounded-lg bg-zinc-900 text-zinc-300 hover:text-white border border-zinc-800"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"
          ><path
            d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"
          ></path></svg
        >
      </a>
    </div>

    <a
      href="tel:+48788463717"
      class="w-full py-3 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-200 font-mono text-xs flex items-center justify-center gap-2 border border-zinc-800"
    >
      <span>Zadzwoń: <strong>788 463 717</strong></span>
    </a>
    <a
      href="https://v3klub.gymmanager.io"
      target="_blank"
      rel="noopener noreferrer"
      class="w-full py-3 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-xs uppercase tracking-wide text-center block shadow-lg"
    >
      Panel Klienta Online &rarr;
    </a>
    <p class="text-[11px] font-mono text-zinc-400 text-center pt-1">
      Samoobsługa 5:00 – 24:00 • ul. Poniatowskiego 24
    </p>
  </div>
</aside>

<!-- Kompaktowy Dolny Pasek Mobilny (Quick Actions Bar) -->
<div
  class="fixed bottom-0 left-0 right-0 z-40 lg:hidden bg-zinc-950/95 backdrop-blur-md border-t border-zinc-800/90 px-3 py-1.5 pb-[calc(0.375rem+env(safe-area-inset-bottom))]"
  aria-label="Szybka nawigacja mobilna"
>
  <div class="grid grid-cols-3 gap-2 max-w-md mx-auto">
    <a
      href="#cennik"
      class="py-2 px-2.5 rounded-lg bg-red-600 hover:bg-red-500 text-white font-bold text-[11px] uppercase tracking-wide text-center flex items-center justify-center gap-1.5 shadow-sm"
    >
      Karnety
    </a>
    <a
      href="#grafik"
      class="py-2 px-2.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-zinc-100 font-semibold text-[11px] uppercase tracking-wide text-center border border-zinc-800 flex items-center justify-center gap-1.5"
    >
      <svg
        class="w-3.5 h-3.5 text-red-500 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
        ></path></svg
      >
      <span>Grafik</span>
    </a>
    <a
      href="tel:+48788463717"
      aria-label="Zadzwoń do recepcji V3 Klub"
      class="py-2 px-2.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-zinc-100 font-semibold text-[11px] uppercase tracking-wide text-center border border-zinc-800 flex items-center justify-center gap-1.5"
    >
      <svg
        class="w-3.5 h-3.5 text-red-500 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
        ></path></svg
      >
      <span>Zadzwoń</span>
    </a>
  </div>
</div>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const closeBtn = document.getElementById("mobile-close-btn");
  const drawer = document.getElementById("mobile-drawer");
  const backdrop = document.getElementById("mobile-backdrop");
  const links = document.querySelectorAll(".mobile-link");

  function openMenu() {
    drawer?.classList.remove("translate-x-full");
    backdrop?.classList.remove("opacity-0", "pointer-events-none");
    btn?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    drawer?.classList.add("translate-x-full");
    backdrop?.classList.add("opacity-0", "pointer-events-none");
    btn?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  btn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  backdrop?.addEventListener("click", closeMenu);

  links.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>
