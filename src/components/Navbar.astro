---
import Logo from './Logo.astro';

const navLinks = [
  { name: 'O klubie', href: '#o-nas', icon: 'map-pin', color: 'text-v3-lime' },
  { name: 'Fight Zone', href: '#fight-zone', icon: 'boxing', color: 'text-v3-red' },
  { name: 'Siłownia & Cross', href: '#silownia', icon: 'dumbbell', color: 'text-v3-lime' },
  { name: 'Strefa Kobiet', href: '#strefa-kobiet', icon: 'heart', color: 'text-pink-400' },
  { name: 'Fitness & Zumba', href: '#fitness', icon: 'flame', color: 'text-[#D946EF]' },
  { name: 'Grafik', href: '#grafik', icon: 'calendar', color: 'text-cyan-400' },
  { name: 'Cennik', href: '#cennik', icon: 'ticket', color: 'text-amber-400' },
  { name: 'Kontakt', href: '#kontakt', icon: 'phone', color: 'text-zinc-300' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-v3-dark/95 backdrop-blur-xl border-b border-v3-border">
  
  <!-- Dyskretny pasek statusu na samej górze -->
  <div class="bg-black/90 border-b border-white/5 py-1 px-4 text-[10px] sm:text-[11px] font-semibold text-zinc-400">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2 shrink-0">
        <span class="inline-flex items-center gap-1.5 text-v3-lime font-bold tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-v3-lime animate-pulse"></span>
          SAMOOBSŁUGA 5:00 – 24:00
        </span>
        <span class="hidden md:inline text-zinc-600">|</span>
        <span class="hidden md:inline text-zinc-400">Wstęp z aplikacją na kod QR</span>
      </div>

      <div class="flex items-center gap-3 shrink-0 text-zinc-400">
        <span class="hidden sm:inline">Jarosław, ul. Poniatowskiego 24</span>
        <span class="hidden lg:inline text-zinc-600">•</span>
        <span class="hidden lg:inline text-zinc-300 font-bold">MultiSport • Medicover • FitProfit</span>
      </div>
    </div>
  </div>

  <!-- Główna belka -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
    
    <!-- Logo V3KLUB -->
    <a href="#" class="shrink-0 hover:opacity-90 transition-opacity">
      <Logo className="h-8 sm:h-10" />
    </a>

    <!-- Menu Desktop -->
    <nav class="hidden xl:flex items-center gap-5 text-xs font-bold uppercase tracking-wider">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class={`whitespace-nowrap py-1 transition-colors ${
            link.name === 'Strefa Kobiet' 
              ? 'text-pink-400 hover:text-pink-300' 
              : 'text-zinc-300 hover:text-v3-lime'
          }`}
        >
          {link.name}
        </a>
      ))}
    </nav>

    <!-- Prawe akcje -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a 
        href="tel:788463717" 
        class="hidden sm:inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-v3-surface hover:bg-zinc-800 border border-v3-border text-xs font-bold text-zinc-200 hover:text-white transition-colors whitespace-nowrap"
      >
        <span class="text-v3-lime text-sm">📞</span> 788 463 717
      </a>

      <a 
        href="#cennik" 
        class="bg-v3-lime text-black font-black px-3.5 sm:px-5 py-2 sm:py-2.5 rounded-xl text-xs uppercase tracking-wider hover:bg-v3-lime-hover transition-all shadow-[0_0_15px_rgba(200,255,0,0.3)] whitespace-nowrap"
      >
        Kup karnet
      </a>

      <!-- Przycisk Hamburger na telefonie -->
      <button 
        id="menu-open-btn"
        type="button"
        aria-label="Otwórz menu"
        class="xl:hidden p-2 rounded-xl bg-v3-surface border border-v3-border text-zinc-200 hover:text-white hover:border-v3-lime transition-colors"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

  </div>

  <div class="h-[1px] w-full bg-gradient-to-r from-v3-lime/60 via-v3-border to-transparent"></div>

</header>

<!-- Wysuwany Boczny Panel Mobilny (Off-canvas Drawer) -->
<div id="mobile-drawer-backdrop" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 xl:hidden"></div>

<aside 
  id="mobile-drawer"
  class="fixed top-0 right-0 bottom-0 z-50 w-[82%] max-w-sm bg-[#0E0E12] border-l border-v3-border p-6 flex flex-col justify-between translate-x-full transition-transform duration-300 ease-in-out shadow-2xl xl:hidden overflow-y-auto"
>
  <div>
    <!-- Górny nagłówek panelu -->
    <div class="flex items-center justify-between pb-5 border-b border-v3-border">
      <Logo className="h-8" />
      <button 
        id="menu-close-btn"
        type="button"
        aria-label="Zamknij menu"
        class="p-2 rounded-xl bg-v3-surface border border-v3-border text-zinc-400 hover:text-white hover:border-zinc-500 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Lista zakładek z nowoczesnymi wektorami SVG zamiast emotek -->
    <nav class="mt-6 flex flex-col gap-1.5">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class={`mobile-nav-link flex items-center gap-3.5 px-3.5 py-3 rounded-xl font-bold text-xs uppercase tracking-wider transition-all border border-transparent hover:border-white/10 ${
            link.name === 'Strefa Kobiet'
              ? 'text-pink-400 hover:bg-pink-500/10'
              : 'text-zinc-200 hover:text-white hover:bg-v3-surface'
          }`}
        >
          <!-- Ikony wektorowe SVG -->
          <div class={`w-7 h-7 rounded-lg bg-v3-dark border border-white/5 flex items-center justify-center shrink-0 ${link.color}`}>
            {link.icon === 'map-pin' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            )}
            {link.icon === 'boxing' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
            {link.icon === 'dumbbell' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10M20 7v10M8 5v14M16 5v14M8 12h8" />
              </svg>
            )}
            {link.icon === 'heart' && (
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
            )}
            {link.icon === 'flame' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343a7.975 7.975 0 012.344 5.657c0 2.12-.835 4.156-2.343 5.657z" />
              </svg>
            )}
            {link.icon === 'calendar' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            )}
            {link.icon === 'ticket' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
              </svg>
            )}
            {link.icon === 'phone' && (
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            )}
          </div>
          <span>{link.name}</span>
        </a>
      ))}
    </nav>
  </div>

  <!-- Dolne akcje w panelu -->
  <div class="pt-6 border-t border-v3-border space-y-3">
    <a 
      href="tel:788463717" 
      class="w-full flex items-center justify-center gap-2.5 py-3 rounded-xl bg-v3-surface hover:bg-zinc-800 border border-v3-border text-white text-xs font-bold uppercase tracking-wider transition-colors"
    >
      <svg class="w-4 h-4 text-v3-lime" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span>Zadzwoń: 788 463 717</span>
    </a>
    
    <a 
      href="https://v3klub.gymmanager.io" 
      target="_blank" 
      rel="noopener noreferrer"
      class="w-full block text-center py-3.5 rounded-xl bg-v3-lime text-black text-xs font-black uppercase tracking-wider shadow-[0_0_20px_rgba(200,255,0,0.35)] hover:bg-v3-lime-hover transition-all"
    >
      Panel Klienta Online &rarr;
    </a>

    <p class="text-[10px] text-zinc-500 text-center pt-1 font-mono">
      Samoobsługa 5:00 – 24:00 • ul. Poniatowskiego 24
    </p>
  </div>
</aside>

<script>
  const openBtn = document.getElementById('menu-open-btn');
  const closeBtn = document.getElementById('menu-close-btn');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('mobile-drawer-backdrop');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function openMenu() {
    drawer?.classList.remove('translate-x-full');
    backdrop?.classList.remove('opacity-0', 'pointer-events-none');
    backdrop?.classList.add('opacity-100');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    drawer?.classList.add('translate-x-full');
    backdrop?.classList.remove('opacity-100');
    backdrop?.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);

  navLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>