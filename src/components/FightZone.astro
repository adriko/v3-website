---
const combatSports = [
  { 
    id: '01',
    name: 'Boks', 
    tag: 'Szermierka na pięści',
    desc: 'Precyzja ciosów, praca nóg, uniki, tarcze bokserskie i kontrolowane sparingi.', 
  },
  { 
    id: '02',
    name: 'Kickboxing / K1', 
    tag: 'Stójka & Kopnięcia',
    desc: 'Połączenie technik bokserskich z destrukcyjnymi kopnięciami. Eksplozywna dynamika.', 
  },
  { 
    id: '03',
    name: 'MMA & Grappling', 
    tag: 'Wszechstylowa walka',
    desc: 'Płynne przejścia ze stójki do obaleń, kontrola pozycji i walka na chwyty w parterze.', 
  },
  { 
    id: '04',
    name: 'SSW Ju-Jitsu', 
    tag: 'Sztuka obezwładniania',
    desc: 'Tradycyjna japońska dyscyplina: dźwignie, rzuty, duszenia i skuteczna samoobrona.', 
  },
  { 
    id: '05',
    name: 'Krav Maga', 
    tag: 'Realne zagrożenie',
    desc: 'Praktyczny system eliminacji niebezpieczeństwa w realnych sytuacjach ulicznych.', 
  },
  { 
    id: '06',
    name: 'Samoobrona Kobiet', 
    tag: 'Pewność & Refleks',
    desc: 'Dedykowana sekcja budująca odporność psychiczną, asertywność i odruchy obronne.', 
  },
];

const ageGroups = [
  { group: 'KIDS', category: 'DZIECI', age: '4–6 lat', time: '45 min', focus: 'Sprawność ogólna i dyscyplina przez zabawę' },
  { group: 'START', category: 'DZIECI', age: '7–10 lat', time: '45 min', focus: 'Koordynacja ruchowa i podstawy uderzeń' },
  { group: 'KADET', category: 'MŁODZIEŻ', age: '11–13 lat', time: '60 min', focus: 'Technika, gibkość i przygotowanie motoryczne' },
  { group: 'JUNIOR', category: 'MŁODZIEŻ', age: '14–18 lat', time: '60 min', focus: 'Intensywny trening zadaniowy i taktyczny' },
  { group: 'DOROŚLI REKREACJA', category: 'OPEN', age: 'Dorośli', time: '75 min', focus: 'Kondycja, redukcja wagi i czysta forma bez presji' },
  { group: 'FIGHT TEAM', category: 'KADRA PRO', age: 'Zawodnicy', time: '75 min', focus: 'Twarde sparingi turniejowe i starty w zawodach' },
];
---

<section id="fight-zone" class="py-16 sm:py-24 bg-v3-dark border-b border-v3-border relative overflow-hidden">
  <!-- Świetlna poświata w tle -->
  <div class="absolute -right-20 top-1/4 w-[550px] h-[550px] bg-v3-red/10 blur-[170px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Nagłówek strefy -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 sm:mb-14">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-v3-red/10 border border-v3-red/30 rounded-lg text-v3-red text-[11px] font-black uppercase tracking-widest mb-3">
          <span>&gt;&gt;&gt;</span> FIGHT ZONE & SOKÓŁ JAROSŁAW
        </div>
        <h2 class="font-['Teko'] text-4xl sm:text-6xl font-black uppercase text-white leading-none">
          Strefa Sportów <span class="text-v3-red">Walki</span>
        </h2>
        <p class="text-zinc-400 mt-2 text-xs sm:text-sm max-w-lg leading-relaxed">
          Profesjonalna mata zapaśnicza, pełnowymiarowa klatka MMA, ring oraz strefa ciężkich worków bokserskich.
        </p>
      </div>

      <a 
        href="#grafik" 
        class="inline-flex items-center gap-2 text-v3-red hover:text-white px-5 py-2.5 rounded-xl bg-v3-surface border border-v3-red/50 hover:bg-v3-red text-xs font-bold uppercase tracking-wider transition-all self-start md:self-auto shadow-[0_0_20px_rgba(255,42,42,0.15)]"
      >
        Grafik treningów walk &rarr;
      </a>
    </div>

    <!-- Siatka dyscyplin: 2 kolumny mobile, 3 kolumny desktop -->
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6 mb-12 sm:mb-16">
      {combatSports.map((sport) => (
        <div class="bg-gradient-to-b from-[#1c0d10] via-v3-card to-v3-dark border-t-2 border-t-v3-red border-x border-b border-v3-border hover:border-v3-red/70 rounded-xl sm:rounded-2xl p-4 sm:p-6 transition-all duration-300 hover:-translate-y-1 group shadow-lg">
          <div class="flex items-center justify-between mb-3">
            <span class="font-mono text-xs font-bold text-v3-red/80 tracking-widest">
              {sport.id} //
            </span>
            <span class="text-[9px] sm:text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded bg-v3-red/10 border border-v3-red/30 text-v3-red">
              {sport.tag}
            </span>
          </div>
          
          <h3 class="font-['Teko'] text-2xl sm:text-3xl font-black uppercase text-white group-hover:text-v3-red transition-colors leading-tight">
            {sport.name}
          </h3>
          
          <p class="text-zinc-400 text-[11px] sm:text-xs mt-2 leading-relaxed">
            {sport.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- Sekcja grup wiekowych: nowoczesny bento-grid -->
    <div class="bg-gradient-to-br from-v3-card via-v3-surface to-v3-dark border border-v3-border rounded-2xl sm:rounded-3xl p-5 sm:p-8 lg:p-10 shadow-xl">
      <div class="mb-6 sm:mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-v3-border/70 pb-4">
        <div>
          <h3 class="font-['Teko'] text-2xl sm:text-4xl font-bold uppercase text-white leading-none">
            Szkolenie dla każdego wieku
          </h3>
          <p class="text-zinc-400 text-xs sm:text-sm mt-1">
            Programy treningowe dostosowane do etapu rozwoju motorycznego i wieku.
          </p>
        </div>
        <span class="text-[11px] font-mono text-v3-red uppercase font-bold tracking-wider">
          Bezpieczeństwo & Technika
        </span>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-4">
        {ageGroups.map((ag) => (
          <div class="p-3.5 sm:p-5 rounded-xl bg-v3-dark/90 border border-v3-border hover:border-v3-red/50 transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-1 mb-2">
                <span class="font-['Teko'] text-xl sm:text-2xl font-bold tracking-wider text-white group-hover:text-v3-red transition-colors leading-tight">
                  {ag.group}
                </span>
                <span class="text-[9px] font-mono font-bold uppercase px-1.5 py-0.5 rounded bg-v3-surface border border-v3-border text-zinc-400">
                  {ag.category}
                </span>
              </div>
              <p class="text-[10px] sm:text-xs text-zinc-400 leading-snug line-clamp-2">
                {ag.focus}
              </p>
            </div>

            <div class="mt-3 pt-2.5 border-t border-v3-border/50 flex items-center justify-between text-[11px] sm:text-xs font-mono font-bold">
              <span class="text-v3-red">{ag.age}</span>
              <span class="text-zinc-400">• {ag.time}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>