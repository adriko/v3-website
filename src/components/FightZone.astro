---
const disciplines = [
  {
    name: "Boks",
    tag: "Klasyczna Stójka",
    desc: "Precyzja ciosów, praca nóg, uniki, tarcze bokserskie i kontrolowane sparingi.",
  },
  {
    name: "Kickboxing / K1",
    tag: "Stójka & Kopnięcia",
    desc: "Połączenie technik bokserskich z mocnymi kopnięciami. Eksplozywna dynamika.",
  },
  {
    name: "MMA & Grappling",
    tag: "Walka Wszechstylowa",
    desc: "Płynne przejścia ze stójki do obaleń, kontrola pozycji i techniki parterowe na macie.",
  },
  {
    name: "SSW Ju-Jitsu",
    tag: "Sztuka Obezwładniania",
    desc: "Tradycyjna japońska dyscyplina: dźwignie, rzuty, duszenia i skuteczna samoobrona.",
  },
  {
    name: "Krav Maga",
    tag: "Samoobrona Uliczna",
    desc: "Praktyczny system eliminacji realnego zagrożenia bez reguł ringowych.",
  },
  {
    name: "Samoobrona Kobiet",
    tag: "Dedykowana Grupa",
    desc: "Pewność siebie, asertywność, bezpieczne odruchy i techniki obronne.",
  },
];

const ageGroups = [
  {
    group: "KIDS",
    sub: "Przedszkolaki",
    age: "4–6 lat",
    duration: "45 min",
    focus: "Rozwój sprawności, koordynacja i dyscyplina przez sportowe zabawy.",
  },
  {
    group: "START",
    sub: "Podstawy",
    age: "7–10 lat",
    duration: "45 min",
    focus: "Nauka pozycji walki, podstawowych uderzeń i ogólnej zwinności.",
  },
  {
    group: "KADET",
    sub: "Młodzież",
    age: "11–13 lat",
    duration: "60 min",
    focus: "Szlifowanie techniki ciosów, gibkość i przygotowanie motoryczne.",
  },
  {
    group: "JUNIOR",
    sub: "Zaawansowani",
    age: "14–18 lat",
    duration: "60 min",
    focus: "Intensywny trening zadaniowy, sparingi i taktyka ringowa.",
  },
  {
    group: "DOROŚLI",
    sub: "Forma & Pasja",
    age: "Open",
    duration: "75 min",
    focus: "Budowa kondycji, zrzucanie wagi i technika bez presji walk.",
  },
  {
    group: "FIGHT TEAM",
    sub: "Kadra PRO",
    age: "Zawodnicy",
    duration: "75 min",
    focus: "Twarde sparingi turniejowe i przygotowanie do startów w zawodach.",
  },
];
---

<section
  id="fight-zone"
  class="py-16 lg:py-24 relative bg-zinc-950 border-b border-zinc-900"
>
  <div
    class="absolute top-1/3 left-0 w-96 h-96 bg-red-600/5 rounded-full blur-3xl pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6"
    >
      <div>
        <div
          class="inline-flex items-center gap-2 text-red-500 font-mono text-xs uppercase tracking-wider mb-2.5 font-semibold"
        >
          <span>&gt;&gt;&gt;</span> FIGHT ZONE & SOKÓŁ JAROSŁAW
        </div>
        <h2
          class="font-heading text-3xl sm:text-5xl font-black uppercase tracking-tight text-white"
        >
          Strefa Sportów <span class="text-red-600">Walki</span>
        </h2>
        <p
          class="text-zinc-300 text-sm sm:text-base max-w-xl mt-2 leading-relaxed"
        >
          Profesjonalna mata zapaśnicza, pełnowymiarowy ring bokserski oraz
          strefa ciężkich worków treningowych.
        </p>
      </div>
      <a
        href="#grafik"
        class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wide text-red-400 hover:text-red-300 font-bold shrink-0 cursor-pointer"
      >
        Grafik treningów walk &rarr;
      </a>
    </div>

    <!-- Disciplines: Horizontal swipe on mobile, 3-col grid on desktop -->
    <div class="relative -mx-4 px-4 sm:mx-0 sm:px-0 mb-14">
      <div
        class="flex sm:grid sm:grid-cols-2 lg:grid-cols-3 gap-4 overflow-x-auto sm:overflow-visible pb-4 sm:pb-0 snap-x snap-mandatory scrollbar-none"
      >
        {
          disciplines.map((item) => (
            <div class="w-[82vw] max-w-77.5 sm:w-auto sm:max-w-none shrink-0 snap-start bg-zinc-900/50 border border-zinc-800/90 hover:border-red-500/40 rounded-2xl p-5 sm:p-6 transition-all flex flex-col justify-between">
              <div>
                <span class="inline-block text-[11px] font-mono uppercase tracking-wider text-red-400 font-semibold mb-1.5">
                  {item.tag}
                </span>
                <h3 class="text-lg sm:text-xl font-bold text-white uppercase tracking-tight mb-2">
                  {item.name}
                </h3>
                <p class="text-zinc-300 text-sm leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Age Hierarchy: Horizontal swipe on mobile, 6-col compact grid on desktop -->
    <div
      class="bg-zinc-900/30 border border-zinc-800/80 rounded-2xl p-5 sm:p-8 mb-10"
    >
      <div
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6"
      >
        <div>
          <h3
            class="font-heading text-lg sm:text-2xl font-black uppercase text-white tracking-tight"
          >
            Szkolenie dla każdego wieku
          </h3>
          <p class="text-zinc-400 text-xs sm:text-sm">
            Zorganizowane grupy dostosowane do stopnia zaawansowania i etapu
            rozwoju.
          </p>
        </div>
        <span
          class="text-[11px] font-mono uppercase tracking-wider text-zinc-400"
          >Bezpieczeństwo • Technika • Rozwój</span
        >
      </div>

      <div class="-mx-2 px-2 sm:mx-0 sm:px-0">
        <div
          class="flex sm:grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3.5 overflow-x-auto sm:overflow-visible pb-3 sm:pb-0 snap-x snap-mandatory"
        >
          {
            ageGroups.map((g) => (
              <div class="w-[74vw] max-w-62.5 sm:w-auto sm:max-w-none shrink-0 snap-start bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 rounded-xl p-4 flex flex-col justify-between transition-colors">
                <div>
                  <div class="flex flex-wrap items-center gap-2 mb-2.5">
                    <span class="px-2 py-0.5 rounded bg-red-950/60 border border-red-500/25 text-red-400 font-mono text-xs font-extrabold uppercase tracking-wide">
                      {g.group}
                    </span>
                    <span class="text-zinc-300 text-xs font-semibold">
                      {g.sub}
                    </span>
                  </div>
                  <p class="text-zinc-300 text-xs leading-relaxed mb-4">
                    {g.focus}
                  </p>
                </div>
                <div class="pt-2.5 border-t border-zinc-900 flex items-center gap-2 text-xs font-mono">
                  <span class="text-white font-bold">{g.age}</span>
                  <span class="text-zinc-600">•</span>
                  <span class="text-zinc-400">{g.duration}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Compact CTA Bar to Trainers -->
    <div
      class="rounded-2xl bg-linear-to-r from-red-950/40 via-zinc-900/80 to-zinc-900/60 border border-red-500/25 p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
    >
      <div class="flex items-center gap-3.5">
        <span class="text-2xl shrink-0">🥊</span>
        <div>
          <h4 class="text-white font-bold text-sm sm:text-base">
            Poznaj instruktorów KSW Sokół & V3
          </h4>
          <p class="text-zinc-300 text-xs sm:text-sm">
            Mistrzowie Polski, licencjonowani trenerzy PZKB i czynni zawodnicy
            MMA.
          </p>
        </div>
      </div>
      <a
        href="#kadra"
        class="w-full sm:w-auto text-center px-5 py-3 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-xs uppercase tracking-wide transition-all shrink-0 cursor-pointer"
      >
        Zobacz kadrę Fight Zone &rarr;
      </a>
    </div>
  </div>
</section>
