---
const combatSports = [
  { name: 'Boks', desc: 'Technika ciosów, praca nóg, tarcze i sparingi.', icon: '🥊' },
  { name: 'Kickboxing / K1', desc: 'Uderzenia i mocne kopnięcia w stójce.', icon: '🥋' },
  { name: 'MMA & Grappling', desc: 'Walka w stójce, rzuty i techniki parterowe.', icon: '🤼' },
  { name: 'SSW Ju-Jitsu', desc: 'Dźwignie, rzuty i japońska samoobrona.', icon: '⛩️' },
  { name: 'Krav Maga', desc: 'Praktyczna walka w realnym zagrożeniu.', icon: '🛡️' },
  { name: 'Samoobrona Kobiet', desc: 'Pewność siebie i odruchy obronne.', icon: '⚡' },
];

const ageGroups = [
  { group: 'KIDS', age: '4–6 lat', time: '45 min' },
  { group: 'START', age: '7–10 lat', time: '45 min' },
  { group: 'KADET', age: '11–13 lat', time: '60 min' },
  { group: 'JUNIOR', age: '14–18 lat', time: '60 min' },
  { group: 'DOROŚLI REKREACJA', age: 'Open', time: '75 min' },
  { group: 'FIGHT TEAM', age: 'Zawodnicy', time: '75 min' },
];
---

<section id="fight-zone" class="py-16 sm:py-24 bg-v3-dark border-b border-v3-border relative overflow-hidden">
  <div class="absolute -right-20 top-1/3 w-[500px] h-[500px] bg-v3-red/10 blur-[160px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Nagłówek -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 sm:mb-14">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 bg-v3-red/10 border border-v3-red/30 rounded text-v3-red text-[11px] font-black uppercase tracking-widest mb-2">
          <span>&gt;&gt;&gt;</span> FIGHT ZONE & SOKÓŁ JAROSŁAW
        </div>
        <h2 class="font-['Teko'] text-4xl sm:text-6xl font-black uppercase text-white leading-none">
          Strefa Sportów <span class="text-v3-red">Walki</span>
        </h2>
        <p class="text-zinc-400 mt-2 text-xs sm:text-sm max-w-lg">
          Mata sportowa, profesjonalna klatka MMA, ring i worki bokserskie.
        </p>
      </div>

      <a 
        href="#grafik" 
        class="inline-flex items-center gap-2 text-v3-red hover:text-white px-4 py-2.5 rounded-xl bg-v3-surface border border-v3-red/50 hover:bg-v3-red text-xs font-bold uppercase tracking-wider transition-all self-start md:self-auto"
      >
        Grafik treningów walk &rarr;
      </a>
    </div>

    <!-- Siatka dyscyplin: 2 kolumny na mobile, 3 na desktopie -->
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-6 mb-12 sm:mb-16">
      {combatSports.map((sport) => (
        <div class="bg-gradient-to-b from-v3-card to-v3-surface border border-v3-border hover:border-v3-red/60 rounded-xl sm:rounded-2xl p-3.5 sm:p-6 transition-all group">
          <div class="flex items-center justify-between mb-2 sm:mb-3">
            <span class="text-xl sm:text-2xl">{sport.icon}</span>
            <span class="w-1.5 h-1.5 rounded-full bg-v3-red"></span>
          </div>
          <h3 class="font-['Teko'] text-xl sm:text-3xl font-bold uppercase text-white group-hover:text-v3-red transition-colors leading-tight">
            {sport.name}
          </h3>
          <p class="text-zinc-400 text-[11px] sm:text-xs mt-1 sm:mt-2 leading-relaxed">
            {sport.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- Grupy wiekowe: kompaktowe 2-kolumnowe kafelki -->
    <div class="bg-v3-surface/60 border border-v3-border rounded-2xl sm:rounded-3xl p-5 sm:p-8">
      <div class="mb-5">
        <h3 class="font-['Teko'] text-2xl sm:text-4xl font-bold uppercase text-white leading-none">
          Szkolenie dla każdego wieku
        </h3>
        <p class="text-zinc-400 text-xs mt-1">Bezpieczne grupy zorganizowane pod kątem stopnia zaawansowania.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-3">
        {ageGroups.map((ag) => (
          <div class="p-3 rounded-xl bg-v3-dark border border-v3-border flex flex-col justify-between">
            <span class="font-bold text-white text-xs tracking-wide">{ag.group}</span>
            <div class="mt-2 flex items-center justify-between text-[10px] text-v3-red font-mono">
              <span>{ag.age}</span>
              <span class="text-zinc-400">• {ag.time}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>