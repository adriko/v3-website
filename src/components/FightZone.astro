---
const disciplines = [
  {
    tag: 'Klasyczna Stójka',
    title: 'Boks',
    desc: 'Precyzja ciosów, praca nóg, uniki, tarcze bokserskie i kontrolowane sparingi.',
  },
  {
    tag: 'Stójka & Kopnięcia',
    title: 'Kickboxing / K1',
    desc: 'Połączenie technik bokserskich z mocnymi kopnięciami. Eksplozywna dynamika.',
  },
  {
    tag: 'Walka Wszechstylowa',
    title: 'MMA & Grappling',
    desc: 'Płynne przejścia ze stójki do obaleń, kontrola pozycji i techniki parterowe.',
  },
  {
    tag: 'Sztuka Obezwładniania',
    title: 'SSW Ju-Jitsu',
    desc: 'Tradycyjna japońska dyscyplina: dźwignie, rzuty, duszenia i skuteczna samoobrona.',
  },
  {
    tag: 'Samoobrona Uliczna',
    title: 'Krav Maga',
    desc: 'Praktyczny system eliminacji realnego zagrożenia bez reguł ringowych.',
  },
  {
    tag: 'Dedykowana Grupa',
    title: 'Samoobrona Kobiet',
    desc: 'Pewność siebie, asertywność, bezpieczne odruchy i techniki obronne.',
  },
];

const ageGroups = [
  {
    name: 'KIDS',
    subtitle: 'Przedszkolaki',
    desc: 'Rozwój sprawności, koordynacja i dyscyplina przez sportowe zabawy.',
    age: '4–6 lat',
    duration: '45 min',
    pro: false,
  },
  {
    name: 'START',
    subtitle: 'Podstawy',
    desc: 'Nauka pozycji walki, podstawowych uderzeń i ogólnej zwinności.',
    age: '7–10 lat',
    duration: '45 min',
    pro: false,
  },
  {
    name: 'KADET',
    subtitle: 'Młodzież',
    desc: 'Szlifowanie techniki ciosów, gibkość i przygotowanie motoryczne.',
    age: '11–13 lat',
    duration: '60 min',
    pro: false,
  },
  {
    name: 'JUNIOR',
    subtitle: 'Zaawansowani',
    desc: 'Intensywny trening zadaniowy, sparingi i taktyka ringowa.',
    age: '14–18 lat',
    duration: '60 min',
    pro: false,
  },
  {
    name: 'DOROŚLI',
    subtitle: 'Forma & Pasja',
    desc: 'Budowa kondycji, zrzucanie wagi i technika bez presji walk.',
    age: 'Open',
    duration: '75 min',
    pro: false,
  },
  {
    name: 'FIGHT TEAM',
    subtitle: 'Kadra PRO',
    desc: 'Twarde sparingi turniejowe i przygotowanie do startów w zawodach.',
    age: 'Zawodnicy',
    duration: '75 min',
    pro: true,
  },
];
---

<section id="fight-zone" class="relative border-b border-white/10 bg-gradient-to-b from-v3-dark via-black to-v3-dark py-16 lg:py-24">
  <div class="pointer-events-none absolute top-1/4 left-1/2 -translate-x-1/2 h-96 w-96 rounded-full bg-v3-red/10 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <!-- Nagłówek -->
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-v3-red">
          <span>&gt;&gt;&gt;</span> FIGHT ZONE &amp; SOKÓŁ JAROSŁAW
        </div>
        <h2 class="mt-2 font-['Teko'] text-4xl font-bold uppercase leading-[0.95] text-white sm:text-6xl">
          Strefa Sportów <span class="text-v3-red">Walki</span>
        </h2>
        <p class="mt-3 max-w-2xl text-base text-zinc-300">
          Profesjonalna mata zapaśnicza, pełnowymiarowa klatka MMA, ring oraz strefa ciężkich worków bokserskich.
        </p>
      </div>
      <a
        href="#grafik"
        class="inline-flex items-center gap-2 self-start rounded-xl border border-v3-red/40 bg-v3-red/10 px-5 py-3 text-sm font-bold uppercase tracking-wider text-v3-red transition hover:bg-v3-red/20"
      >
        Grafik treningów walk →
      </a>
    </div>

    <!-- Siatka 6 dyscyplin -->
    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {disciplines.map((item) => (
        <div class="group rounded-2xl border border-white/10 bg-zinc-900/70 p-6 transition hover:border-v3-red/50">
          <span class="inline-block rounded-md bg-v3-red/10 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-v3-red">
            {item.tag}
          </span>
          <h3 class="mt-3 font-['Teko'] text-3xl font-bold uppercase leading-none text-white">
            {item.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-300">
            {item.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- 6 Grup Wiekowych (2 kolumny na smartfonie, 3 na komputerze) -->
    <div class="mt-14 rounded-3xl border border-white/10 bg-zinc-900/40 p-5 sm:p-8">
      <div class="flex flex-col justify-between gap-4 border-b border-white/10 pb-6 sm:flex-row sm:items-end">
        <div>
          <h3 class="font-['Teko'] text-3xl font-bold uppercase leading-none text-white sm:text-4xl">
            Szkolenie dla każdego wieku
          </h3>
          <p class="mt-1 text-sm text-zinc-300">
            Zorganizowane grupy dostosowane do stopnia zaawansowania i etapu rozwoju.
          </p>
        </div>
        <span class="text-xs font-bold uppercase tracking-widest text-v3-red">
          Bezpieczeństwo • Technika • Rozwój
        </span>
      </div>

      <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
        {ageGroups.map((group) => (
          <div
            class={`flex flex-col justify-between rounded-xl border p-3.5 sm:p-5 ${
              group.pro
                ? 'border-v3-red/40 bg-red-950/20'
                : 'border-white/10 bg-zinc-950/80'
            }`}
          >
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-1">
                <span class="font-['Teko'] text-2xl font-bold uppercase leading-none text-v3-red sm:text-3xl">
                  {group.name}
                </span>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-400">
                  {group.subtitle}
                </span>
              </div>
              <p class="mt-2 text-xs leading-relaxed text-zinc-300 sm:text-sm">
                {group.desc}
              </p>
            </div>
            <div class="mt-3 border-t border-white/5 pt-2.5 text-xs font-bold text-zinc-200">
              <span>{group.age}</span> <span class="text-v3-red">• {group.duration}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>