---
import { GOOGLE_REVIEWS, type ReviewItem } from "../data/reviews";

const googleMapsUrl = "https://maps.app.goo.gl/BUiRAiKCzPZr2aYN9";
const realRating = "4.4";
const totalReviews = "65 opinii";
---

<section
  id="opinie"
  class="py-14 sm:py-16 lg:py-20 bg-v3-surface/60 border-b border-v3-border relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10 sm:mb-12">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-400 text-xs font-bold uppercase tracking-wider mb-2.5">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
          </svg>
          <span>Zweryfikowana Wizytówka Google</span>
        </div>

        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold uppercase text-white leading-none">
          Co mówią o nas <span class="text-v3-lime">w Jarosławiu</span>
        </h2>
        <p class="text-zinc-300 mt-2 text-xs sm:text-sm max-w-xl leading-normal">
          Autentyczne opinie klubowiczów wystawione w profilu Google Maps
          Centrum Sportowego V3.
        </p>
      </div>

      <!-- Karta punktacji i strzałki -->
      <div class="flex items-center gap-4 self-start lg:self-auto">
        <a
          href={googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3.5 bg-v3-dark hover:bg-v3-card border border-v3-border hover:border-amber-400/50 p-3 sm:p-3.5 rounded-2xl transition-all shadow-md group"
        >
          <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center shrink-0 shadow-sm">
            <svg class="w-5 h-5" viewBox="0 0 24 24">
              <path
                fill="#4285F4"
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              ></path>
              <path
                fill="#34A853"
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              ></path>
              <path
                fill="#FBBC05"
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
              ></path>
              <path
                fill="#EA4335"
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
              ></path>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-display text-2xl font-bold text-white leading-none">
                {realRating}
              </span>
              <div class="text-amber-400 text-xs">★★★★★</div>
            </div>
            <span class="text-[11px] text-zinc-400 group-hover:text-amber-400 transition-colors block mt-0.5">
              {totalReviews} w Google &rarr;
            </span>
          </div>
        </a>

        <!-- Strzałki nawigacji -->
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="rev-prev"
            aria-label="Poprzednie opinie"
            class="w-10 h-10 rounded-xl border border-v3-border bg-v3-dark hover:bg-v3-card flex items-center justify-center text-zinc-300 hover:text-white transition active:scale-95 cursor-pointer shadow-md"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 19l-7-7 7-7"
              ></path>
            </svg>
          </button>
          <button
            type="button"
            id="rev-next"
            aria-label="Następne opinie"
            class="w-10 h-10 rounded-xl border border-v3-border bg-v3-dark hover:bg-v3-card flex items-center justify-center text-zinc-300 hover:text-white transition active:scale-95 cursor-pointer shadow-md"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Pasek postępu (15 sekund) -->
    <div class="w-full h-1 bg-zinc-800 rounded-full mb-4 overflow-hidden">
      <div
        id="review-progress"
        class="h-full bg-amber-400 w-0 transition-all duration-100 ease-linear"
      ></div>
    </div>

    <!-- Karuzela z 20 opiniami -->
    <div
      id="reviews-slider"
      class="flex items-stretch gap-4 sm:gap-6 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory scroll-smooth no-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0"
    >
      {GOOGLE_REVIEWS.map((r: ReviewItem) => (
        <div class="shrink-0 w-[84vw] max-w-[340px] sm:w-[380px] snap-center bg-v3-dark border border-v3-border hover:border-amber-400/40 rounded-2xl p-5 sm:p-6 flex flex-col justify-between transition-all duration-300 shadow-md group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="text-amber-400 text-xs sm:text-sm tracking-widest">
                {"★".repeat(r.rating)}
              </div>
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-v3-surface text-zinc-300 border border-v3-border">
                {r.badge}
              </span>
            </div>
            <p class="text-xs sm:text-sm text-zinc-200 leading-normal italic">
              "{r.text}"
            </p>
          </div>

          <div class="mt-5 pt-3.5 border-t border-v3-border flex items-center justify-between text-xs">
            <strong class="text-white font-semibold font-sans">
              {r.author}
            </strong>
            <span class="text-zinc-400 text-[11px] font-mono">{r.date}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Informacja o pauzie i CTA -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-xs text-zinc-400">
        <span class="h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span>
          Karuzela zmienia się co 15 sekund (najedź kursorem lub przytrzymaj,
          aby zatrzymać)
        </span>
      </div>

      <a
        href={googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-v3-dark hover:bg-v3-card border border-v3-border hover:border-amber-400/60 text-xs font-bold uppercase tracking-wider text-white transition-all shadow-md group shrink-0"
      >
        <svg
          class="w-4 h-4 text-amber-400 group-hover:rotate-12 transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
          ></path>
        </svg>
        <span>Wystaw opinię w Google Maps</span>
      </a>
    </div>
  </div>
</section>

<script>
  const slider = document.getElementById("reviews-slider");
  const prevBtn = document.getElementById("rev-prev");
  const nextBtn = document.getElementById("rev-next");
  const progressBar = document.getElementById("review-progress");

  const CYCLE_TIME = 15000; // 15 sekund
  const STEP = 390;

  let progressTimer: ReturnType<typeof setInterval> | null = null;
  let progressElapsed = 0;
  let isPaused = false;

  function scrollNext() {
    if (!slider) return;
    const maxScroll = slider.scrollWidth - slider.clientWidth;
    if (slider.scrollLeft >= maxScroll - 15) {
      slider.scrollTo({ left: 0, behavior: "smooth" });
    } else {
      slider.scrollBy({ left: STEP, behavior: "smooth" });
    }
    resetCycle();
  }

  function scrollPrev() {
    if (!slider) return;
    if (slider.scrollLeft <= 15) {
      slider.scrollTo({ left: slider.scrollWidth, behavior: "smooth" });
    } else {
      slider.scrollBy({ left: -STEP, behavior: "smooth" });
    }
    resetCycle();
  }

  function resetCycle() {
    progressElapsed = 0;
    if (progressBar) progressBar.style.width = "0%";
  }

  function tickProgress() {
    if (isPaused) return;
    progressElapsed += 100;
    const percent = Math.min((progressElapsed / CYCLE_TIME) * 100, 100);
    if (progressBar) progressBar.style.width = `${percent}%`;

    if (progressElapsed >= CYCLE_TIME) {
      scrollNext();
    }
  }

  function startCycle() {
    if (!progressTimer) {
      progressTimer = setInterval(tickProgress, 100);
    }
  }

  function pauseCycle() {
    isPaused = true;
  }

  function resumeCycle() {
    isPaused = false;
  }

  // Przyciski manualne
  nextBtn?.addEventListener("click", () => {
    scrollNext();
    resumeCycle();
  });

  prevBtn?.addEventListener("click", () => {
    scrollPrev();
    resumeCycle();
  });

  // Pauza po najechaniu myszką lub dotknięciu palcem
  slider?.addEventListener("mouseenter", pauseCycle);
  slider?.addEventListener("mouseleave", resumeCycle);
  slider?.addEventListener("touchstart", pauseCycle, { passive: true });
  slider?.addEventListener("touchend", resumeCycle);

  startCycle();
</script>
