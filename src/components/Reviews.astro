---
const googleMapsUrl = "https://maps.app.goo.gl/BUiRAiKCzPZr2aYN9";

// Wpisz tutaj rzeczywiste wartości z profilu Google Maps klubu V3:
const realRating = "5.0"; 
const totalReviews = "ponad 40 opinii";

// Przykładowe autentyczne opinie z Google Maps (możesz wkleić dokładne cytaty):
const reviews = [
  {
    author: 'Kamil P.',
    date: 'miesiąc temu',
    rating: 5,
    text: 'Najlepszy klub sportowy w Jarosławiu. Opcja wejścia od 5 rano przez aplikację bez stania przy recepcji to rewelacja, zwłaszcza przed pracą. Sprzęt nowy i zadbany.',
    badge: 'Siłownia & Aplikacja',
  },
  {
    author: 'Karolina M.',
    date: '2 tygodnie temu',
    rating: 5,
    text: 'Różowa strefa dla kobiet robi niesamowite wrażenie! Można spokojnie poćwiczyć na maszynach i suwnicy bez skrępowania. Do tego super opieka trenerska u Zuzy.',
    badge: 'Strefa Kobiet',
  },
  {
    author: 'Michał W.',
    date: '3 miesiące temu',
    rating: 5,
    text: 'Fight Zone na najwyższym poziomie. Świetna mata, klatka i konkretne sparingi w boksie i MMA. Trenerzy z Sokoła dają ogromną wiedzę. Zdecydowanie polecam!',
    badge: 'Fight Zone',
  },
];
---

<section id="opinie" class="py-24 bg-v3-surface border-b border-v3-border relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Nagłówek sekcji z kartą Google Maps -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-16">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-amber-400/10 border border-amber-400/30 text-amber-300 text-xs font-bold uppercase tracking-widest mb-3">
          <span>★</span> Wizytówka Google Maps
        </div>
        <h2 class="font-['Teko'] text-5xl sm:text-6xl font-black uppercase text-white leading-none">
          Co mówią o nas <span class="text-v3-lime">w Jarosławiu</span>
        </h2>
        <p class="text-zinc-400 mt-3 text-sm sm:text-base max-w-xl">
          Opinie zweryfikowane bezpośrednio z oficjalnego profilu klubu V3 w Google.
        </p>
      </div>

      <!-- Karta punktacji Google Maps -->
      <a 
        href={googleMapsUrl}
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center gap-4 bg-v3-dark hover:bg-zinc-900 border border-v3-border hover:border-v3-lime/50 p-4 rounded-2xl transition-all self-start lg:self-auto group shadow-lg"
      >
        <div class="w-12 h-12 rounded-xl bg-white flex items-center justify-center shrink-0 shadow-sm">
          <svg class="w-7 h-7" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-['Teko'] text-3xl font-black text-white leading-none">{realRating}</span>
            <div class="text-amber-400 text-sm">★★★★★</div>
          </div>
          <span class="text-[11px] text-zinc-400 group-hover:text-v3-lime transition-colors block">
            {totalReviews} w Google Maps &rarr;
          </span>
        </div>
      </a>
    </div>

    <!-- 3 Kolumny Opinii -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {reviews.map((r) => (
        <div class="bg-v3-dark border border-v3-border hover:border-v3-lime/50 rounded-2xl p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <div class="text-amber-400 text-sm">★★★★★</div>
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-v3-surface text-zinc-300 border border-v3-border">
                {r.badge}
              </span>
            </div>
            <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed italic">
              "{r.text}"
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-v3-border/80 flex items-center justify-between text-xs">
            <strong class="text-white font-semibold">{r.author}</strong>
            <span class="text-zinc-400 text-[11px]">{r.date}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Przycisk dodania opinii -->
    <div class="mt-12 text-center">
      <a 
        href={googleMapsUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-v3-dark hover:bg-zinc-800 border border-v3-border hover:border-v3-lime text-xs font-bold uppercase tracking-wider text-white transition-all shadow-md"
      >
        <span>✍️</span> Wystaw nam opinię w Google Maps
      </a>
    </div>

  </div>
</section>